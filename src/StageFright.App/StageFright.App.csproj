<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">net10.0-windows10.0.19041.0</TargetFrameworks>
        <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx'))">net10.0-maccatalyst</TargetFrameworks>
        <TargetFrameworks Condition="'$(TargetFrameworks)' == ''">net10.0-windows10.0.19041.0</TargetFrameworks>

        <OutputType>Exe</OutputType>
        <RootNamespace>StageFright.App</RootNamespace>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <ImplicitUsings>enable</ImplicitUsings>
        <EnableDefaultCssItems>false</EnableDefaultCssItems>
        <Nullable>enable</Nullable>
        <MauiXamlInflator>SourceGen</MauiXamlInflator>

        <ApplicationTitle>StageFright Community</ApplicationTitle>
        <ApplicationId>com.stagefright.community</ApplicationId>
        <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
        <ApplicationVersion>1</ApplicationVersion>

        <WindowsPackageType>None</WindowsPackageType>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>

        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.19041.0</SupportedOSPlatformVersion>
        <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.19041.0</TargetPlatformMinVersion>
    </PropertyGroup>

    <!-- Works around WindowsAppSDK issue #3337 (https://github.com/microsoft/WindowsAppSDK/issues/3337) when
         publishing a packaged (MSIX) Windows build from the CLI. Inert for every normal build — it only takes
         effect when a caller explicitly passes -p:RuntimeIdentifierOverride=win-x64 (or win-x86), which is what
         the CI debug pre-release workflow (.github/workflows/debug-pre-release.yml) does. See
         https://learn.microsoft.com/dotnet/maui/windows/deployment/publish-cli for the documented pattern. -->
    <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows' and '$(RuntimeIdentifierOverride)' != ''">
        <RuntimeIdentifier>$(RuntimeIdentifierOverride)</RuntimeIdentifier>
    </PropertyGroup>

    <ItemGroup>
        <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />
        <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />
        <MauiImage Include="Resources\Images\*" />
        <MauiFont Include="Resources\Fonts\*" />
        <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>

    <!-- Blazor.Bootstrap ships static JS assets named "blazor.bootstrap.sortable-list.js" and
         "blazor.bootstrap.theme-switcher.js". WinAppSDK's PRI resource indexer (task WinAppSdkGenerateProjectPriFile,
         invoked from target "_GenerateProjectPriFileCore" as part of the SDK's "GenerateProjectPriFile" target
         chain — see Microsoft.Windows.SDK.BuildTools.MSIX.Pri.targets) scans every packaged content file for the
         "name.qualifier-value.ext" convention used by qualified assets (e.g. "logo.scale-200.png"), so it misreads
         "sortable-list"/"theme-switcher" as unrecognized resource qualifiers and emits benign PRI249 warnings.
         "_AppxLayoutAssetPackageFiles" is the SDK's own exclusion list, applied when target
         "_GenerateProjectPriConfigurationFiles" builds its file layout from "@(PriOutputs)" (or, on older WinAppSDK
         builds-tools versions, "@(PackagingOutputs)"). Populating it here — hooked to run immediately before that
         target, once "GetPriOutputs" has already populated the source item earlier in the same dependency chain —
         removes the two files from qualifier scanning only; it doesn't affect the actual output, since Blazor's own
         static-web-asset copy to wwwroot (a separate RazorSDK mechanism) is untouched and BlazorWebView keeps
         serving both files normally. -->
    <Target Name="_ExcludeBlazorBootstrapAssetsFromPriLayout"
            BeforeTargets="_GenerateProjectPriConfigurationFiles"
            Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
        <ItemGroup>
            <_AppxLayoutAssetPackageFiles Include="@(PriOutputs);@(PackagingOutputs)"
                Condition="'%(Filename)%(Extension)' == 'blazor.bootstrap.sortable-list.js' or '%(Filename)%(Extension)' == 'blazor.bootstrap.theme-switcher.js'" />
        </ItemGroup>
    </Target>

    <ItemGroup>
        <PackageReference Include="Blazor.Bootstrap" />
        <PackageReference Include="Microsoft.Maui.Controls" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" />
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
        <PackageReference Include="Serilog" />
        <PackageReference Include="Serilog.Sinks.File" />
        <PackageReference Include="Serilog.Sinks.Console" />
        <PackageReference Include="Serilog.Extensions.Logging" />
        <PackageReference Include="OpenTelemetry" />
        <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
        <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
        <PackageReference Include="OpenTelemetry.Exporter.Console" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\StageFright.Core\StageFright.Core.csproj" />
        <ProjectReference Include="..\StageFright.Data\StageFright.Data.csproj" />
        <ProjectReference Include="..\StageFright.UI\StageFright.UI.csproj" />
        <ProjectReference Include="..\StageFright.Plugins.Contracts\StageFright.Plugins.Contracts.csproj" />
        <ProjectReference Include="..\StageFright.Reports\StageFright.Reports.csproj" />
    </ItemGroup>

</Project>
