@* Report error handler component displaying user-friendly error messages with recovery options *@

@if (ShowError)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <h4 class="alert-heading">Report Generation Error</h4>
        <p>@ErrorMessage</p>
        @if (!string.IsNullOrEmpty(RecoveryMessage))
        {
            <hr/>
            <p class="mb-0"><strong>Recovery:</strong> @RecoveryMessage</p>
        }
        <button type="button" class="btn-close" @onclick="DismissError" aria-label="Close"></button>
    </div>

    @if (ShowRetryButton)
    {
        <button class="btn btn-primary mt-2" @onclick="OnRetry">Retry Report Generation</button>
    }
}

@code {
    [Parameter]
    public bool ShowError { get; set; } = false;

    [Parameter]
    public string ErrorMessage { get; set; } = string.Empty;

    [Parameter]
    public string? RecoveryMessage { get; set; }

    [Parameter]
    public bool ShowRetryButton { get; set; } = true;

    [Parameter]
    public EventCallback OnDismiss { get; set; }

    [Parameter]
    public EventCallback OnRetry { get; set; }

    private async Task DismissError()
    {
        await OnDismiss.InvokeAsync();
    }
}
