@using System.Globalization
@inherits ComponentBase

@if (_loading)
{
    <span class="text-muted small">Loading...</span>
}
else if (_error)
{
    <span class="text-danger small">Unable to load</span>
}
else
{
    <div class="w-100">
        <div class="small mb-1">Total Owed: <strong>@_total.ToString("C")</strong></div>
        <BarChart @ref="_chart" Height="130" />
    </div>
}
