@using StageFright.Core.Enums
@using StageFright.Reports.Models
@using StageFright.Reports.Registry

@if (Provider == null)
{
    @* No provider selected — render nothing *@
}
else if (_generating)
{
    <div class="modal-backdrop-light d-flex align-items-center justify-content-center py-4" role="status" aria-live="polite">
        <div class="text-center">
            <div class="spinner-border text-primary mb-2" role="status" aria-hidden="true"></div>
            <p class="mb-0 small">@Shared["Shared_Report_GeneratingText"]</p>
            @if (_showCancel)
            {
                <button class="btn btn-sm btn-outline-secondary mt-2" @onclick="CancelGeneration">
                    @Shared["Shared_Action_Cancel"]
                </button>
            }
        </div>
    </div>
}
else if (_error != null)
{
    <div class="alert alert-danger py-1 mb-2 small" role="alert">
        <strong>@Shared["Shared_Report_GenerateFailedHeading"]</strong> @_error
        <div class="mt-1">
            <button class="btn btn-sm btn-outline-danger" @onclick="Regenerate">@Shared["Shared_Action_TryAgain"]</button>
        </div>
    </div>
}
else if (_report != null)
{
    <div class="report-viewer">
        <div class="d-flex justify-content-between align-items-start mb-2">
            <div>
                <h2 class="h5 mb-1">@_report.Title</h2>
                @if (!string.IsNullOrEmpty(_report.SubTitle))
                {
                    <p class="text-muted mb-0 small">@_report.SubTitle</p>
                }
                <small class="text-muted">@GeneratedAtText()</small>
            </div>
            <div class="report-actions" role="group" aria-label="@Shared["Shared_Report_ActionsAriaLabel"]">
                <button class="btn btn-outline-primary btn-sm" @onclick="PrintReport">
                    @Shared["Shared_Report_PrintButton"]
                </button>
                <button class="btn btn-outline-secondary btn-sm" @onclick="ExportCsv">
                    @Shared["Shared_Report_ExportCsvButton"]
                </button>
                <button class="btn btn-outline-secondary btn-sm" @onclick="Regenerate">
                    @Shared["Shared_Report_RefreshButton"]
                </button>
            </div>
        </div>

        @* Filter panel *@
        @if (Provider.Filters.Any())
        {
            <div class="card mb-2">
                <div class="card-body py-2">
                    <div class="row g-2 align-items-end">
                        @foreach (var filter in Provider.Filters)
                        {
                            <div class="col-auto">
                                <label class="form-label mb-1 small">@filter.Label</label>
                                @if (filter.Type == ReportFilterType.Select)
                                {
                                    <select class="form-select form-select-sm"
                                            value="@_filterValues.Get(filter.Key)"
                                            @onchange="e => OnFilterChanged(filter.Key, e.Value?.ToString())">
                                        @for (var oi = 0; oi < filter.Options.Count; oi++)
                                        {
                                            var optionValue = filter.Options[oi];
                                            var optionLabel = oi < filter.OptionLabels.Count ? filter.OptionLabels[oi] : optionValue;
                                            <option value="@optionValue">@optionLabel</option>
                                        }
                                    </select>
                                }
                                else if (filter.Type == ReportFilterType.Boolean)
                                {
                                    <div class="form-check mt-1">
                                        <input type="checkbox"
                                               class="form-check-input"
                                               checked="@(_filterValues.Get(filter.Key) == "true")"
                                               @onchange="e => OnFilterChanged(filter.Key, ((bool)e.Value!).ToString().ToLowerInvariant())" />
                                    </div>
                                }
                                else if (filter.Type == ReportFilterType.Text)
                                {
                                    <input type="text"
                                           class="form-control form-control-sm"
                                           value="@_filterValues.Get(filter.Key)"
                                           @onchange="e => OnFilterChanged(filter.Key, e.Value?.ToString())" />
                                }
                                else
                                {
                                    <input type="date"
                                           class="form-control form-control-sm"
                                           value="@_filterValues.Get(filter.Key)"
                                           @onchange="e => OnFilterChanged(filter.Key, e.Value?.ToString())" />
                                }
                            </div>
                        }
                        <div class="col-auto">
                            <button class="btn btn-primary btn-sm" @onclick="Regenerate">@Shared["Shared_Action_Apply"]</button>
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (UseMasterDetail)
        {
            <RadzenDataGrid @key="_masterDetailGeneration" Data="@_report.Sections" TItem="ReportSection"
                             AllowPaging="true" PageSize="15" class="rz-shadow-0" AllowSorting="false"
                             ExpandMode="DataGridExpandMode.Multiple">
                <Columns>
                    @for (var i = 0; i < _report.SummaryColumns!.Count; i++)
                    {
                        var colIndex = i;
                        var summaryCol = _report.SummaryColumns[colIndex];
                        <RadzenDataGridColumn TItem="ReportSection" Title="@summaryCol.Header" Sortable="false">
                            <Template Context="section">
                                <span class="@AlignClass(summaryCol.Alignment)">@(colIndex < section.SummaryRow!.Cells.Count ? section.SummaryRow.Cells[colIndex] : string.Empty)</span>
                            </Template>
                        </RadzenDataGridColumn>
                    }
                </Columns>
                <Template Context="section">
                    <div class="table-responsive">
                        <table class="table table-sm table-bordered mb-0">
                            <thead>
                                <tr>
                                    @foreach (var col in _report.Columns)
                                    {
                                        <th class="@AlignClass(col.Alignment)">@col.Header</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in section.Rows)
                                {
                                    <tr class="@(row.IsEmphasized ? "fw-bold" : "")">
                                        @for (var i = 0; i < _report.Columns.Count; i++)
                                        {
                                            var col = _report.Columns[i];
                                            var value = i < row.Cells.Count ? row.Cells[i] : string.Empty;
                                            <td class="@AlignClass(col.Alignment)">@value</td>
                                        }
                                    </tr>
                                }

                                @if (section.Subtotal != null)
                                {
                                    <tr class="fw-bold table-light">
                                        @for (var i = 0; i < _report.Columns.Count; i++)
                                        {
                                            var col = _report.Columns[i];
                                            var value = i < section.Subtotal.Cells.Count ? section.Subtotal.Cells[i] : string.Empty;
                                            <td class="@AlignClass(col.Alignment)">@value</td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </Template>
            </RadzenDataGrid>
        }
        else
        {
            @* Report table *@
            <div class="table-responsive">
                <table class="table table-sm table-bordered">
                    <thead>
                        <tr>
                            @foreach (var col in _report.Columns)
                            {
                                <th class="@AlignClass(col.Alignment)">@col.Header</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var section in GetPagedSections())
                        {
                            @if (!string.IsNullOrEmpty(section.Heading))
                            {
                                <tr class="table-secondary">
                                    <td colspan="@_report.Columns.Count" class="fw-bold">@section.Heading</td>
                                </tr>
                            }

                            @foreach (var row in section.Rows)
                            {
                                <tr class="@(row.IsEmphasized ? "fw-bold" : "")">
                                    @for (var i = 0; i < _report.Columns.Count; i++)
                                    {
                                        var col = _report.Columns[i];
                                        var value = i < row.Cells.Count ? row.Cells[i] : string.Empty;
                                        <td class="@AlignClass(col.Alignment)">@value</td>
                                    }
                                </tr>
                            }

                            @if (section.Subtotal != null)
                            {
                                <tr class="fw-bold table-light">
                                    @for (var i = 0; i < _report.Columns.Count; i++)
                                    {
                                        var col = _report.Columns[i];
                                        var value = i < section.Subtotal.Cells.Count ? section.Subtotal.Cells[i] : string.Empty;
                                        <td class="@AlignClass(col.Alignment)">@value</td>
                                    }
                                </tr>
                            }
                        }

                        @if (_report.GrandTotal != null && (!UsePaging || _currentPage == TotalPages))
                        {
                            <tr class="fw-bold table-dark">
                                @for (var i = 0; i < _report.Columns.Count; i++)
                                {
                                    var col = _report.Columns[i];
                                    var value = i < _report.GrandTotal.Cells.Count ? _report.GrandTotal.Cells[i] : string.Empty;
                                    <td class="@AlignClass(col.Alignment)">@value</td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (UsePaging)
            {
                <div class="d-flex justify-content-between align-items-center mt-1">
                    <small class="text-muted">@RowsRangeText()</small>
                    <nav aria-label="@Shared["Shared_Report_PageNavAriaLabel"]">
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(_currentPage == 1 ? "disabled" : "")">
                                <button class="page-link" @onclick="PrevPage" disabled="@(_currentPage == 1)"
                                        aria-label="@Shared["Shared_Report_PrevPageAriaLabel"]">@Shared["Shared_Report_PrevPage"]</button>
                            </li>
                            <li class="page-item disabled">
                                <span class="page-link">@PageOfText()</span>
                            </li>
                            <li class="page-item @(_currentPage == TotalPages ? "disabled" : "")">
                                <button class="page-link" @onclick="NextPage" disabled="@(_currentPage == TotalPages)"
                                        aria-label="@Shared["Shared_Report_NextPageAriaLabel"]">@Shared["Shared_Report_NextPage"]</button>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        }
    </div>
}
