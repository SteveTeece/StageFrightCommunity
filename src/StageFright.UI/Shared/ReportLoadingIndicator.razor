@* Modal dialog for report generation - always displayed throughout generation, no timeout, no cancel button *@

<div class="modal-backdrop show" style="display: @(IsVisible ? "block" : "none")"></div>

<div class="modal show" style="display: @(IsVisible ? "block" : "none"); position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); z-index: 1050;">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-body text-center">
                <div class="spinner-border mb-3" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p class="mb-0">Generating report...</p>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public bool IsVisible { get; set; } = false;
}
