@* Base component for dashboard tiles with progressive loading and error handling *@
@using System.Diagnostics

<div class="dashboard-tile @CssClass">
    <div class="tile-header">
        <h3>@Title</h3>
    </div>

    <div class="tile-content">
        @if (IsLoading)
        {
            <div class="tile-loading">
                <div class="spinner"></div>
                <p>Loading...</p>
            </div>
        }
        else if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="tile-error">
                <p>@ErrorMessage</p>
                @if (OnRetry.HasDelegate)
                {
                    <button class="btn-retry" @onclick="HandleRetry">Retry</button>
                }
            </div>
        }
        else
        {
            @ChildContent
        }
    </div>
</div>

@code {
    /// <summary>Tile title</summary>
    [Parameter]
    public string Title { get; set; } = "Tile";

    /// <summary>Child content to display when loaded</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>Additional CSS classes for styling</summary>
    [Parameter]
    public string CssClass { get; set; } = "";

    /// <summary>Loading state</summary>
    [Parameter]
    public bool IsLoading { get; set; } = false;

    /// <summary>Error message to display</summary>
    [Parameter]
    public string? ErrorMessage { get; set; }

    /// <summary>Optional retry callback</summary>
    [Parameter]
    public EventCallback OnRetry { get; set; }

    private async Task HandleRetry()
    {
        await OnRetry.InvokeAsync();
    }
}
