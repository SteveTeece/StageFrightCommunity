@inherits ComponentBase

@if (_loading)
{
    <span class="text-muted small">Loading...</span>
}
else if (_error)
{
    <span class="text-danger small">Unable to load</span>
}
else if (_recordedDate is null && _pendingDate is null && _upcomingDate is null)
{
    <span class="text-muted small">No events recorded</span>
}
else
{
    <div class="d-flex align-items-center gap-3">
        <ul class="list-unstyled mb-0 small d-flex flex-column gap-2">
            @if (_recordedDate is not null)
            {
                <li><span class="badge" style="background-color:#fd7e14">Participated: @_participatedLabel</span></li>
                <li><span class="badge" style="background-color:#dc3545">Absent: @_absentLabel</span></li>
                <li class="text-muted" style="font-size:0.7rem">@_recordedDate.Value.ToString("d MMM yyyy")</li>
            }
            @if (_pendingDate is not null)
            {
                <li class="text-warning" style="font-size:0.7rem">&#9888; Pending: @_pendingDate.Value.ToString("d MMM yyyy")</li>
            }
            @if (_upcomingDate is not null)
            {
                <li class="text-info" style="font-size:0.7rem">&#8594; Upcoming: @_upcomingDate.Value.ToString("d MMM yyyy")</li>
            }
        </ul>
        @if (_hasRate)
        {
            <DoughnutChart @ref="_chart" Width="130" />
        }
    </div>
    @if (_showYtd && _hasYtdData)
    {
        <div class="mt-2" style="font-size:0.7rem; color: var(--bs-secondary-color);">YTD Participation</div>
        <BarChart @ref="_ytdChart" Width="260" />
    }
}
