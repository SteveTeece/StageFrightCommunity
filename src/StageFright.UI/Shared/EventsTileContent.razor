@inject IEventService EventService

@if (_loading)
{
    <span class="text-muted small">Loading...</span>
}
else if (_error)
{
    <span class="text-danger small">Unable to load</span>
}
else
{
    <ul class="list-unstyled mb-0 small">
        <li>Last event: <strong>@(_lastDate?.ToString("d MMM yyyy") ?? "—")</strong></li>
        <li>Participation rate: <strong>@(_participationRate.HasValue ? $"{_participationRate:F1}%" : "—")</strong></li>
    </ul>
}

@code {
    private bool _loading = true;
    private bool _error;
    private DateTime? _lastDate;
    private decimal? _participationRate;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var recent = await EventService.GetMostRecentPastAsync(DateTime.UtcNow);
            _lastDate = recent?.Date;
            _participationRate = recent?.StoredParticipationRate;
        }
        catch
        {
            _error = true;
        }
        finally
        {
            _loading = false;
        }
    }
}
