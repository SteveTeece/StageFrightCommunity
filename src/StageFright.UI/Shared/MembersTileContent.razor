@inherits ComponentBase

@if (_loading)
{
    <span class="text-muted small">Loading...</span>
}
else if (_error)
{
    <span class="text-danger small">Unable to load</span>
}
else if (_total == 0)
{
    <span class="text-muted small">No members found</span>
}
else
{
    <div class="d-flex align-items-center gap-3">
        <ul class="list-unstyled mb-0 small d-flex flex-column gap-2">
            <li><span class="badge" style="background-color:#0d6efd">Active: @_activeCount</span></li>
            <li><span class="badge" style="background-color:#dc3545">Inactive: @_inactiveCount</span></li>
        </ul>
        <DoughnutChart @ref="_chart" Width="130" />
    </div>
}
