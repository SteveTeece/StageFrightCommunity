@using System.Globalization
@inject IMemberService MemberService

@if (_loading)
{
    <span class="text-muted small">Loading...</span>
}
else if (_error)
{
    <span class="text-danger small">Unable to load</span>
}
else if (_total == 0)
{
    <span class="text-muted small">No members found</span>
}
else
{
    <div class="d-flex align-items-center">
        <ul class="list-unstyled mb-0 small d-flex flex-column gap-2 me-3">
            <li><span class="badge" style="background-color:#0d6efd">Active: @_activeCount</span></li>
            <li><span class="badge" style="background-color:#dc3545">Inactive: @_inactiveCount</span></li>
        </ul>
        <svg viewBox="0 0 42 42" width="120" height="120" aria-hidden="true">
            <circle cx="21" cy="21" r="15.91549430918954" fill="transparent" stroke="#dee2e6" stroke-width="5.5" />
            <circle cx="21" cy="21" r="15.91549430918954" fill="transparent"
                    stroke="#0d6efd" stroke-width="5"
                    stroke-dasharray="@_activeDash"
                    stroke-dashoffset="25" />
            <circle cx="21" cy="21" r="15.91549430918954" fill="transparent"
                    stroke="#dc3545" stroke-width="5"
                    stroke-dasharray="@_inactiveDash"
                    stroke-dashoffset="@_inactiveOffset" />
            <text x="21" y="19" text-anchor="middle" font-size="5" font-weight="bold" fill="currentColor">@_total</text>
            <text x="21" y="24.5" text-anchor="middle" font-size="3.5" fill="currentColor">Total</text>
        </svg>
    </div>
}

@code {
    private bool _loading = true;
    private bool _error;
    private int _activeCount;
    private int _inactiveCount;
    private int _total => _activeCount + _inactiveCount;
    private string _activeDash = "0 100";
    private string _inactiveDash = "0 100";
    private string _inactiveOffset = "25";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var active = await MemberService.GetByStatusAsync(MemberStatus.Active);
            var inactive = await MemberService.GetByStatusAsync(MemberStatus.Inactive);
            _activeCount = active.Count;
            _inactiveCount = inactive.Count;

            if (_total > 0)
            {
                double ap = _activeCount * 100.0 / _total;
                double ip = _inactiveCount * 100.0 / _total;
                _activeDash   = Fmt(ap) + " " + Fmt(100 - ap);
                _inactiveDash = Fmt(ip) + " " + Fmt(100 - ip);
                _inactiveOffset = Fmt(25 - ap);
            }
        }
        catch
        {
            _error = true;
        }
        finally
        {
            _loading = false;
        }
    }

    private static string Fmt(double v) => v.ToString("F2", CultureInfo.InvariantCulture);
}
