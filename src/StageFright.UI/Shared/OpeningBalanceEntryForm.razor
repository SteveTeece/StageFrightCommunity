@using StageFright.Core.Entities

<div class="opening-balance-entry-form">
    <p class="small">@InstructionText()</p>

    <RadzenDataGrid Data="@_rows" TItem="OpeningBalanceRowModel"
                    AllowSorting="true" AllowPaging="true" PageSize="15"
                    class="rz-shadow-0 opening-balances-table">
        <Columns>
            <RadzenDataGridColumn TItem="OpeningBalanceRowModel" Property="Account.AccountNumber" Title="@Shared["Shared_OpeningBalances_NumberColumn"]" Width="6rem" />
            <RadzenDataGridColumn TItem="OpeningBalanceRowModel" Property="Account.Name" Title="@Shared["Shared_OpeningBalances_AccountColumn"]">
                <FooterTemplate><strong>@Shared["Shared_OpeningBalances_PlugRow"]</strong></FooterTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="OpeningBalanceRowModel" Property="Account.Type" Title="@Shared["Shared_OpeningBalances_TypeColumn"]" Width="8rem">
                <Template Context="row">@row.Account.Type.LocalizeEnum()</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="OpeningBalanceRowModel" Property="Amount" Title="@Shared["Shared_OpeningBalances_BalanceColumn"]"
                                  Width="10rem" TextAlign="TextAlign.Right" Sortable="false">
                <Template Context="row">
                    <input type="number" step="0.01"
                           class="form-control form-control-sm text-end opening-balance-amount"
                           value="@(row.Amount == 0m ? null : row.Amount)"
                           @onchange="e => SetAmountAsync(row, e)"
                           aria-label="@BalanceAriaLabel(row.Account.Name)" />
                </Template>
                <FooterTemplate><strong class="opening-balances-plug">@MoneyFormatter.Format(Plug)</strong></FooterTemplate>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>

    @if (!SubmitOnChange)
    {
        <div class="d-flex gap-2 mt-2">
            <button type="button" class="btn btn-primary btn-sm wizard-post" @onclick="HandleSubmitAsync"
                    disabled="@(NonZeroRows.Count == 0 || _submitting)">
                @(_submitting ? PostingText : (SubmitButtonText ?? DefaultSubmitText))
            </button>
        </div>
    }
</div>
