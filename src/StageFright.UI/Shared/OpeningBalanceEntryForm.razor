@using StageFright.Core.Entities

<div class="opening-balance-entry-form">
    @if (ShowAlreadyPostedWarning && HasExistingOpeningBalances)
    {
        <div class="alert alert-warning py-1 mb-2 small opening-balances-warning" role="alert">
            @Shared["Shared_OpeningBalances_AlreadyPostedWarning"]
        </div>
    }

    <p class="small">@InstructionText()</p>

    <div class="table-responsive">
        <table class="table table-sm align-middle opening-balances-table">
            <thead>
                <tr>
                    <th style="width: 6rem;">@Shared["Shared_OpeningBalances_NumberColumn"]</th>
                    <th>@Shared["Shared_OpeningBalances_AccountColumn"]</th>
                    <th style="width: 8rem;">@Shared["Shared_OpeningBalances_TypeColumn"]</th>
                    <th class="text-end" style="width: 10rem;">@Shared["Shared_OpeningBalances_BalanceColumn"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in _rows)
                {
                    <tr>
                        <td>@row.Account.AccountNumber</td>
                        <td>@row.Account.Name</td>
                        <td>@row.Account.Type.LocalizeEnum()</td>
                        <td>
                            <input type="number" step="0.01"
                                   class="form-control form-control-sm text-end opening-balance-amount"
                                   value="@(row.Amount == 0m ? null : row.Amount)"
                                   @onchange="e => SetAmount(row, e)"
                                   aria-label="@BalanceAriaLabel(row.Account.Name)" />
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr class="fw-semibold">
                    <td colspan="3">@Shared["Shared_OpeningBalances_PlugRow"]</td>
                    <td class="text-end opening-balances-plug">@Plug.ToString("N2")</td>
                </tr>
            </tfoot>
        </table>
    </div>

    <div class="d-flex gap-2 mt-2">
        <button type="button" class="btn btn-primary btn-sm wizard-post" @onclick="HandleSubmitAsync"
                disabled="@(NonZeroRows.Count == 0 || _submitting)">
            @(_submitting ? PostingText : (SubmitButtonText ?? DefaultSubmitText))
        </button>
    </div>
</div>
