@using StageFright.Core.Entities

<div class="opening-balance-entry-form">
    @if (ShowAlreadyPostedWarning && HasExistingOpeningBalances)
    {
        <div class="alert alert-warning py-1 mb-2 small opening-balances-warning" role="alert">
            Opening balances have already been posted. Posting again will add to the
            existing balances rather than replace them.
        </div>
    }

    <p class="small">
        Enter each account's balance as at @AsAtDate.ToString("d MMMM yyyy").
        Leave accounts you don't need at zero. Any difference is posted to
        Opening Balance Equity automatically.
    </p>

    <div class="table-responsive">
        <table class="table table-sm align-middle opening-balances-table">
            <thead>
                <tr>
                    <th style="width: 6rem;">Number</th>
                    <th>Account</th>
                    <th style="width: 8rem;">Type</th>
                    <th class="text-end" style="width: 10rem;">Balance</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in _rows)
                {
                    <tr>
                        <td>@row.Account.AccountNumber</td>
                        <td>@row.Account.Name</td>
                        <td>@row.Account.Type</td>
                        <td>
                            <input type="number" step="0.01"
                                   class="form-control form-control-sm text-end opening-balance-amount"
                                   value="@(row.Amount == 0m ? null : row.Amount)"
                                   @onchange="e => SetAmount(row, e)"
                                   aria-label="Balance for @row.Account.Name" />
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr class="fw-semibold">
                    <td colspan="3">Opening Balance Equity plug</td>
                    <td class="text-end opening-balances-plug">@Plug.ToString("N2")</td>
                </tr>
            </tfoot>
        </table>
    </div>

    <div class="d-flex gap-2 mt-2">
        <button type="button" class="btn btn-primary btn-sm wizard-post" @onclick="HandleSubmitAsync"
                disabled="@(NonZeroRows.Count == 0 || _submitting)">
            @(_submitting ? "Posting…" : SubmitButtonText)
        </button>
    </div>
</div>
