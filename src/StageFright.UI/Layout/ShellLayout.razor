@inherits LayoutComponentBase
@inject NavigationManager Nav
@inject IEnumerable<IMenuItemProvider> MenuProviders

<ThemeProvider @ref="_themeProvider">
    <div class="shell-container">
        <!-- Dark brand strip -->
        <header class="shell-brand" role="banner">
            <span class="brand-wordmark">StageFright</span>
            <div class="brand-actions">
                <button class="btn-theme-toggle"
                        type="button"
                        @onclick="ToggleThemeAsync"
                        aria-label="@(_themeProvider?.CurrentTheme == Core.Enums.Theme.Light ? "Switch to dark mode" : "Switch to light mode")">
                    @if (_themeProvider?.CurrentTheme == Core.Enums.Theme.Light)
                    {
                        <span aria-hidden="true">&#9788;</span><span class="visually-hidden">Light</span>
                    }
                    else
                    {
                        <span aria-hidden="true">&#9790;</span><span class="visually-hidden">Dark</span>
                    }
                </button>
            </div>
        </header>

        <!-- Horizontal navigation bar -->
        <nav class="shell-nav" role="navigation" aria-label="Main navigation">
            <ul class="nav-list" role="list">
                @foreach (var provider in MenuProviders.OrderBy(p => p.DisplayOrder))
                {
                    @foreach (var item in provider.GetMenuItems().OrderBy(i => i.DisplayOrder))
                    {
                        <li class="nav-item">
                            <a class="nav-link @(IsActive(item.Route) ? "active" : "")"
                               href="@item.Route"
                               @onclick:preventDefault
                               @onclick="() => Navigate(item.Route)"
                               tabindex="0">
                                @if (!string.IsNullOrEmpty(item.Icon))
                                {
                                    <span class="nav-icon @item.Icon" aria-hidden="true"></span>
                                }
                                @item.Title
                                @if (!string.IsNullOrEmpty(item.BadgeText))
                                {
                                    <span class="nav-badge" role="status" aria-label="@item.BadgeText items">@item.BadgeText</span>
                                }
                                @if (item.SubItems.Any())
                                {
                                    <span class="nav-caret" aria-hidden="true">&#9660;</span>
                                }
                            </a>
                            @if (item.SubItems.Any())
                            {
                                <ul class="nav-subitems" role="list">
                                    @foreach (var sub in item.SubItems.OrderBy(s => s.DisplayOrder))
                                    {
                                        <li class="nav-sub-item">
                                            <a class="nav-sublink @(IsActive(sub.Route) ? "active" : "")"
                                               href="@sub.Route"
                                               @onclick:preventDefault
                                               @onclick="() => Navigate(sub.Route)"
                                               tabindex="0">
                                                @sub.Title
                                                @if (sub.SubItems.Any())
                                                {
                                                    <span class="nav-flyout-caret" aria-hidden="true">&#9658;</span>
                                                }
                                            </a>
                                            @if (sub.SubItems.Any())
                                            {
                                                <ul class="nav-sub-subitems" role="list">
                                                    @foreach (var deep in sub.SubItems.OrderBy(d => d.DisplayOrder))
                                                    {
                                                        <li>
                                                            <a class="nav-sublink @(IsActive(deep.Route) ? "active" : "")"
                                                               href="@deep.Route"
                                                               @onclick:preventDefault
                                                               @onclick="() => Navigate(deep.Route)"
                                                               tabindex="0">
                                                                @deep.Title
                                                            </a>
                                                        </li>
                                                    }
                                                </ul>
                                            }
                                        </li>
                                    }
                                </ul>
                            }
                        </li>
                    }
                }
            </ul>
        </nav>

        <!-- Main content area -->
        <main class="shell-content" role="main">
            @Body
        </main>
    </div>
</ThemeProvider>
