@inherits LayoutComponentBase
@inject NavigationManager Nav
@inject IEnumerable<IMenuItemProvider> MenuProviders

<ThemeProvider @ref="_themeProvider">
    <div class="shell-container">
        <!-- Floating glass navigation dock -->
        <nav class="shell-dock" role="navigation" aria-label="Main navigation">
            <div class="dock-logo" aria-hidden="true"></div>
            <ul class="dock-list" role="list">
                @foreach (var provider in MenuProviders.OrderBy(p => p.DisplayOrder))
                {
                    @foreach (var item in provider.GetMenuItems().OrderBy(i => i.DisplayOrder))
                    {
                        <li class="dock-item">
                            <a class="dock-link @(IsActive(item.Route) ? "active" : "")"
                               href="@item.Route"
                               title="@item.Title"
                               aria-label="@item.Title"
                               @onclick:preventDefault
                               @onclick="() => Navigate(item.Route)"
                               tabindex="0">
                                <span class="dock-glyph @GlyphClass(item.Route)" aria-hidden="true"></span>
                                <span class="dock-label">@ShortLabelFor(item)</span>
                                @if (!string.IsNullOrEmpty(item.BadgeText))
                                {
                                    <span class="dock-badge" role="status" aria-label="@item.BadgeText items">@item.BadgeText</span>
                                }
                            </a>
                            @if (item.SubItems.Any())
                            {
                                <ul class="dock-flyout" role="list">
                                    @foreach (var sub in item.SubItems.OrderBy(s => s.DisplayOrder))
                                    {
                                        <li class="dock-sub-item">
                                            <a class="dock-flyout-link @(IsActive(sub.Route) ? "active" : "")"
                                               href="@sub.Route"
                                               @onclick:preventDefault
                                               @onclick="() => Navigate(sub.Route)"
                                               tabindex="0">
                                                @sub.Title
                                                @if (sub.SubItems.Any())
                                                {
                                                    <span class="nav-flyout-caret" aria-hidden="true">&#9658;</span>
                                                }
                                            </a>
                                            @if (sub.SubItems.Any())
                                            {
                                                <ul class="dock-flyout" role="list">
                                                    @foreach (var deep in sub.SubItems.OrderBy(d => d.DisplayOrder))
                                                    {
                                                        <li>
                                                            <a class="dock-flyout-link @(IsActive(deep.Route) ? "active" : "")"
                                                               href="@deep.Route"
                                                               @onclick:preventDefault
                                                               @onclick="() => Navigate(deep.Route)"
                                                               tabindex="0">
                                                                @deep.Title
                                                            </a>
                                                        </li>
                                                    }
                                                </ul>
                                            }
                                        </li>
                                    }
                                </ul>
                            }
                        </li>
                    }
                }
            </ul>
            <div class="dock-avatar" aria-hidden="true">SF</div>
        </nav>

        <!-- Top bar: shared light/dark toggle -->
        <header class="shell-topbar" role="banner">
            <button class="btn-theme-toggle"
                    type="button"
                    @onclick="ToggleThemeAsync"
                    aria-label="@(_themeProvider?.CurrentTheme == Core.Enums.Theme.Light ? "Switch to dark mode" : "Switch to light mode")">
                <span class="theme-toggle-dot" aria-hidden="true"></span>
                @(_themeProvider?.CurrentTheme == Core.Enums.Theme.Light ? "Light" : "Dark")
            </button>
        </header>

        <!-- Main content area -->
        <main class="shell-content" role="main">
            @Body
        </main>
    </div>
</ThemeProvider>
