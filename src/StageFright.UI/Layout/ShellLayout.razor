@inherits LayoutComponentBase
@inject NavigationManager Nav
@inject IEnumerable<IMenuItemProvider> MenuProviders

<ThemeProvider @ref="_themeProvider">
    <div class="shell-container">
        <!-- Fixed vertical sidebar navigation -->
        <nav class="shell-sidebar" role="navigation" aria-label="@L["Nav_Sidebar_MainNavigationAriaLabel"]">
            <div class="sidebar-brand">
                <div class="sidebar-logo" aria-hidden="true"></div>
                <span class="sidebar-brand-text">@L["Nav_Sidebar_BrandText"]</span>
            </div>
            <ul class="sidebar-list" role="list">
                @foreach (var provider in MenuProviders.OrderBy(p => p.DisplayOrder))
                {
                    @foreach (var item in provider.GetMenuItems().OrderBy(i => i.DisplayOrder))
                    {
                        @if (item.SubItems.Count > 0)
                        {
                            <li class="sidebar-item sidebar-group">
                                <div class="sidebar-link sidebar-group-header @(IsParentActive(item) ? "active" : "")">
                                    <a class="sidebar-group-link"
                                       href="@item.Route"
                                       title="@item.Title"
                                       aria-label="@item.Title"
                                       @onclick:preventDefault
                                       @onclick="() => Navigate(item.Route)"
                                       tabindex="0">
                                        <span class="nav-icon @IconClass(item.Route)" aria-hidden="true"></span>
                                        <span class="sidebar-label">@item.Title</span>
                                    </a>
                                    <button class="sidebar-chevron @(IsGroupExpanded(item) ? "expanded" : "")"
                                            type="button"
                                            aria-label="@GroupToggleAriaLabel(item)"
                                            aria-expanded="@(IsGroupExpanded(item) ? "true" : "false")"
                                            @onclick="() => ToggleGroup(item.Route)"
                                            @onclick:stopPropagation>
                                    </button>
                                </div>
                                @if (IsGroupExpanded(item))
                                {
                                    <ul class="sidebar-sublist" role="list">
                                        @foreach (var sub in item.SubItems.OrderBy(s => s.DisplayOrder))
                                        {
                                            <li class="sidebar-item">
                                                <a class="sidebar-link sidebar-sublink @(IsActive(sub.Route) ? "active" : "")"
                                                   href="@sub.Route"
                                                   title="@sub.Title"
                                                   aria-label="@sub.Title"
                                                   @onclick:preventDefault
                                                   @onclick="() => Navigate(sub.Route)"
                                                   tabindex="0">
                                                    <span class="sidebar-label">@sub.Title</span>
                                                    @if (!string.IsNullOrEmpty(sub.BadgeText))
                                                    {
                                                        <span class="sidebar-badge" role="status" aria-label="@BadgeItemsAriaLabel(sub.BadgeText)">@sub.BadgeText</span>
                                                    }
                                                </a>
                                            </li>
                                        }
                                    </ul>
                                }
                            </li>
                        }
                        else
                        {
                            <li class="sidebar-item">
                                <a class="sidebar-link @(IsActive(item.Route) ? "active" : "")"
                                   href="@item.Route"
                                   title="@item.Title"
                                   aria-label="@item.Title"
                                   @onclick:preventDefault
                                   @onclick="() => Navigate(item.Route)"
                                   tabindex="0">
                                    <span class="nav-icon @IconClass(item.Route)" aria-hidden="true"></span>
                                    <span class="sidebar-label">@item.Title</span>
                                    @if (!string.IsNullOrEmpty(item.BadgeText))
                                    {
                                        <span class="sidebar-badge" role="status" aria-label="@BadgeItemsAriaLabel(item.BadgeText)">@item.BadgeText</span>
                                    }
                                </a>
                            </li>
                        }
                    }
                }
            </ul>

            <!-- Theme toggle: pinned to the bottom of the sidebar (hidden on the Setup Wizard, which has its own) -->
            @if (CurrentPath != "/setup")
            {
                <div class="btn-theme-toggle"
                     aria-label="@(_themeProvider?.CurrentTheme == Core.Enums.Theme.Light ? L["Nav_ThemeToggle_SwitchToDarkAriaLabel"] : L["Nav_ThemeToggle_SwitchToLightAriaLabel"])">
                    <label for="themeToggleSwitch" class="btn-theme-toggle-label">@L["Nav_ThemeToggle_Label"]</label>
                    <span class="btn-theme-toggle-switch-group">
                        <span>@(_themeProvider?.CurrentTheme == Core.Enums.Theme.Light ? Core.Enums.Theme.Light.LocalizeEnum() : Core.Enums.Theme.Dark.LocalizeEnum())</span>
                        <RadzenSwitch Name="themeToggleSwitch"
                                      Value="@(_themeProvider?.CurrentTheme == Core.Enums.Theme.Dark)"
                                      Change="@(async (bool _) => await ToggleThemeAsync())" />
                    </span>
                </div>
            }
        </nav>

        <!-- Main content area -->
        <main class="shell-content" role="main">
            @Body
        </main>
    </div>
</ThemeProvider>
