@inherits LayoutComponentBase
@inject NavigationManager Nav
@inject IEnumerable<IMenuItemProvider> MenuProviders

<div class="shell-container">
    <!-- Dark brand strip -->
    <header class="shell-brand" role="banner">
        <span class="brand-wordmark">StageFright</span>
        <div class="brand-actions">
            @* Theme toggle wired in Phase 14 *@
        </div>
    </header>

    <!-- White navigation bar -->
    <nav class="shell-nav" role="navigation" aria-label="Main navigation">
        <ul class="nav-list" role="list">
            @foreach (var provider in MenuProviders.OrderBy(p => p.DisplayOrder))
            {
                @foreach (var item in provider.GetMenuItems().OrderBy(i => i.DisplayOrder))
                {
                    <li class="nav-item">
                        <a class="nav-link @(IsActive(item.Route) ? "active" : "")"
                           href="@item.Route"
                           @onclick:preventDefault
                           @onclick="() => Navigate(item.Route)"
                           tabindex="0">
                            @if (!string.IsNullOrEmpty(item.Icon))
                            {
                                <span class="nav-icon @item.Icon" aria-hidden="true"></span>
                            }
                            @item.Title
                            @if (!string.IsNullOrEmpty(item.BadgeText))
                            {
                                <span class="nav-badge" role="status" aria-label="@item.BadgeText items">@item.BadgeText</span>
                            }
                        </a>
                        @if (item.SubItems.Any())
                        {
                            <ul class="nav-subitems" role="list">
                                @foreach (var sub in item.SubItems.OrderBy(s => s.DisplayOrder))
                                {
                                    <li>
                                        <a class="nav-sublink @(IsActive(sub.Route) ? "active" : "")"
                                           href="@sub.Route"
                                           @onclick:preventDefault
                                           @onclick="() => Navigate(sub.Route)"
                                           tabindex="0">
                                            @sub.Title
                                        </a>
                                    </li>
                                }
                            </ul>
                        }
                    </li>
                }
            }
        </ul>
    </nav>

    <!-- Main content area -->
    <main class="shell-content" role="main">
        @Body
    </main>
</div>
