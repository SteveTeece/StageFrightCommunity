@page "/language-select"
@inherits ComponentBase

<PageTitle>@L["Setup_FirstRun_PageTitle"]</PageTitle>

<div class="mt-3">
    <h1 class="mb-1">@L["Setup_FirstRun_Heading"]</h1>
    <p class="text-muted mb-3 small">@L["Setup_FirstRun_Subheading"]</p>

    @if (_errorMessage is not null)
    {
        <div class="alert alert-danger py-1 mb-2 small" role="alert">@_errorMessage</div>
    }

    <div class="setup-language-select d-flex align-items-center gap-2 mb-3">
        <label for="languageSelect" class="small text-muted mb-0">@L["Setup_Language_Label"]</label>
        <select id="languageSelect" class="form-select form-select-sm" style="width: auto;"
                value="@_selectedLanguageCode"
                @onchange="HandleLanguageChanged">
            @foreach (var language in Languages.All)
            {
                <option value="@language.CultureCode">@language.Endonym</option>
            }
        </select>
        <span class="form-text small mb-0">@L["Setup_Language_HelpText"]</span>
    </div>

    <div class="d-flex gap-2 mt-3">
        <button type="button" id="btn-confirm-language" class="btn btn-primary btn-sm" disabled="@_confirming" @onclick="HandleConfirmAsync">
            @if (_confirming)
            {
                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
            }
            @L["Setup_FirstRun_ConfirmButton"]
        </button>
    </div>
</div>
