@using StageFright.Core.Modules.Settings
@using StageFright.UI.Shared

<div class="mb-3">
    <h2 class="h6">@L["Setup_Review_Heading"]</h2>
    <h3 id="review-group-organisation" class="h6 small fw-semibold mb-1">@L["Setup_Review_OrganisationGroupHeading"]</h3>
    <dl class="row small mb-2">
        <dt class="col-5">@L["Setup_Review_OrgNameTerm"]</dt><dd class="col-7">@Model.OrganizationName</dd>
        <dt class="col-5">@L["Setup_Review_ThemeTerm"]</dt><dd class="col-7">@ThemeText()</dd>
        <dt class="col-5">@L["Setup_Review_RenewalMonthTerm"]</dt><dd class="col-7">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(Model.MembershipRenewalMonth)</dd>
        <dt class="col-5">@L["Setup_Review_AuditRetentionTerm"]</dt><dd class="col-7">@AuditRetentionText()</dd>
        <dt class="col-5">@L["Setup_Review_AgmMonthTerm"]</dt><dd class="col-7">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(Model.CommitteeRenewalMonth)</dd>
        <dt class="col-5">@L["Setup_Review_SeatTargetTerm"]</dt><dd class="col-7">@(Model.GeneralCommitteeSeatCountTarget?.ToString() ?? L["Setup_Review_NotSet"].Value)</dd>
    </dl>

    <h3 id="review-group-accounting" class="h6 small fw-semibold mb-1">@L["Setup_Review_AccountingGroupHeading"]</h3>
    <dl class="row small mb-2">
        <dt class="col-5">@L["Setup_Review_CurrencyTerm"]</dt><dd class="col-7">@CurrencyText()</dd>
        <dt class="col-5">@L["Setup_Review_FinancialYearStartTerm"]</dt><dd class="col-7">@FinancialYearStartText()</dd>
        <dt class="col-5">@L["Setup_Review_InceptionDateTerm"]</dt><dd class="col-7">@(Model.InceptionDate?.ToString("d") ?? L["Setup_Review_NotSet"].Value)</dd>
        <dt class="col-5">@L["Setup_Review_AnnualFeeTerm"]</dt><dd class="col-7">@MoneyFormatter.Format(Model.AnnualFee)</dd>
        <dt class="col-5">@L["Setup_Review_AttendanceFeeTerm"]</dt><dd class="col-7">@MoneyFormatter.Format(Model.AttendanceFee)</dd>
        <dt class="col-5">@L["Setup_Review_SalesTaxAppliesTerm"]</dt><dd class="col-7">@YesNo(Model.IsTaxApplicable)</dd>
        @if (Model.IsTaxApplicable)
        {
            <dt class="col-5">@L["Setup_Review_TaxRateTerm"]</dt><dd class="col-7">@(Model.TaxRate?.ToString("N2") ?? "")%</dd>
            <dt class="col-5">@L["Setup_Review_TaxEntryModeTerm"]</dt><dd class="col-7">@Model.TaxEntryMode.LocalizeEnum()</dd>
            <dt class="col-5">@L["Setup_Review_AnnualFeeTaxTerm"]</dt><dd class="col-7">@TaxCodeText(Model.AnnualFeeTaxCode)</dd>
            <dt class="col-5">@L["Setup_Review_AttendanceFeeTaxTerm"]</dt><dd class="col-7">@TaxCodeText(Model.AttendanceFeeTaxCode)</dd>
        }
    </dl>

    <div class="row g-3 mb-2">
        <div class="col-md-6">
            <h3 class="h6 small fw-semibold mb-1">@L["Setup_Review_TitlesHeading"]</h3>
            <BorderedListBox TItem="string" Items="QueuedCommitteeTitles" EmptyText="@L["Setup_Review_TitlesEmpty"]">
                <RowTemplate Context="title"><span>@title</span></RowTemplate>
            </BorderedListBox>
        </div>

        <div class="col-md-6">
            <h3 class="h6 small fw-semibold mb-1">@L["Setup_Review_AccountsHeading"]</h3>
            <BorderedListBox TItem="QueuedAccountRequest" Items="QueuedAccounts" EmptyText="@L["Setup_Review_AccountsEmpty"]">
                <RowTemplate Context="account">
                    <span>@account.Name</span>
                    <span class="text-muted small ms-2">
                        @AccountTypeText(account)
                    </span>
                </RowTemplate>
            </BorderedListBox>
        </div>
    </div>
</div>
