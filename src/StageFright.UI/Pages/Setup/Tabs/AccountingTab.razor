<div class="mb-3">
    <label for="setup-currency" class="form-label">@L["Setup_General_CurrencyLabel"] <span aria-hidden="true" class="text-danger">*</span></label>
    <select id="setup-currency" class="form-select form-select-sm" @bind="Model.CurrencyCode">
        @foreach (var currency in CurrencyCatalog.All)
        {
            <option value="@currency.Code">@currency.DisplayName (@currency.Code)</option>
        }
    </select>
    <div class="form-text small">@L["Setup_General_CurrencyHelp"]</div>
</div>

<div class="row g-2 mb-3">
    <div class="col-md-6">
        <label for="setup-fy-start-month" class="form-label">@L["Setup_General_FinancialYearStartMonthLabel"] <span aria-hidden="true" class="text-danger">*</span></label>
        <InputSelect id="setup-fy-start-month" class="form-select form-select-sm" @bind-Value="Model.FinancialYearStartMonth">
            @for (var m = 1; m <= 12; m++)
            {
                var month = m;
                <option value="@month">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(month)</option>
            }
        </InputSelect>
        <ValidationMessage For="() => Model.FinancialYearStartMonth" class="text-danger small" />
    </div>
    <div class="col-md-6">
        <label for="setup-fy-start-day" class="form-label">@L["Setup_General_FinancialYearStartDayLabel"] <span aria-hidden="true" class="text-danger">*</span></label>
        <InputSelect id="setup-fy-start-day" class="form-select form-select-sm" @bind-Value="Model.FinancialYearStartDay">
            @for (var d = 1; d <= 28; d++)
            {
                var day = d;
                <option value="@day">@day</option>
            }
        </InputSelect>
        <ValidationMessage For="() => Model.FinancialYearStartDay" class="text-danger small" />
    </div>
    <div class="form-text small">@L["Setup_General_FinancialYearStartHelp"]</div>
</div>

<div class="mb-3">
    <label for="setup-inception-date" class="form-label">@L["Setup_General_InceptionDateLabel"]</label>
    <InputDate id="setup-inception-date" class="form-control form-control-sm" @bind-Value="Model.InceptionDate" />
    <div class="form-text small">@L["Setup_General_InceptionDateHelp"]</div>
</div>

<div class="row g-2 mb-2">
    <div class="col">
        <label for="annualFee" class="form-label">@L["Setup_Fees_AnnualFeeLabel"]</label>
        <div class="input-group input-group-sm">
            <span class="input-group-text">$</span>
            <InputNumber id="annualFee" class="form-control" @bind-Value="Model.AnnualFee" @bind-Value:format="N2" />
        </div>
        <ValidationMessage For="() => Model.AnnualFee" class="text-danger small" />
    </div>
    <div class="col">
        <label for="attendanceFee" class="form-label">@L["Setup_Fees_AttendanceFeeLabel"]</label>
        <div class="input-group input-group-sm">
            <span class="input-group-text">$</span>
            <InputNumber id="attendanceFee" class="form-control" @bind-Value="Model.AttendanceFee" @bind-Value:format="N2" />
        </div>
        <ValidationMessage For="() => Model.AttendanceFee" class="text-danger small" />
    </div>
</div>

<div class="row g-3 mb-3">
    <SalesTaxTab Model="Model" />
</div>
