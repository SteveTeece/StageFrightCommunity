<div class="col-md-6 setup-language-select d-flex align-items-center gap-2">
    <label for="languageSelect" class="small text-muted mb-0">@L["Setup_Language_Label"]</label>
    <select id="languageSelect" class="form-select form-select-sm" style="width: auto;"
            value="@_selectedLanguageCode"
            @onchange="HandleLanguageChanged">
        @foreach (var language in Languages.All)
        {
            <option value="@language.CultureCode">@language.Endonym</option>
        }
    </select>
    <span class="form-text small mb-0">@L["Setup_Language_HelpText"]</span>
</div>
