@using StageFright.Core.Entities
@using StageFright.Core.Modules.Settings
@using StageFright.UI.Shared

<p class="text-muted small">
    @L["Setup_Coa_Intro"]
</p>

<div class="row g-3 mb-3">
    <div class="col-md-6">
        <h6 class="mb-1">@L["Setup_Coa_AddHeading"]</h6>
        <AddAccountForm OnSubmit="HandleAddAsync" ExistingNames="ExistingNames" SubmitButtonText="@L["Setup_Coa_QueueAccountButton"]" />
    </div>
</div>

<div class="row g-3">
    <div class="col-md-6">
        <h6 class="mb-1">@L["Setup_Coa_ExistingHeading"]</h6>
        <BorderedListBox TItem="Account" Items="_existingAccounts"
                          EmptyText="@L["Setup_Coa_ExistingEmpty"]">
            <RowTemplate Context="account">
                <code class="me-1">@account.AccountNumber</code>
                <span>@account.Name</span>
                <span class="text-muted small ms-2">
                    @AccountTypeText(account)
                </span>
                @if (account.IsSystem)
                {
                    <span class="badge bg-secondary ms-1" title="@L["Setup_Coa_SystemBadge"]">@L["Setup_Coa_SystemBadge"]</span>
                }
            </RowTemplate>
        </BorderedListBox>
    </div>

    <div class="col-md-6">
        <h6 class="mb-1">@L["Setup_Coa_QueuedHeading"]</h6>
        <BorderedListBox TItem="QueuedAccountRequest" Items="QueuedAccounts"
                          OnRemove="@(EventCallback.Factory.Create<QueuedAccountRequest>(this, HandleRemoveAsync))"
                          EmptyText="@L["Setup_Coa_QueuedEmpty"]">
            <RowTemplate Context="account">
                <span>@account.Name</span>
                <span class="text-muted small ms-2">
                    @QueuedAccountTypeText(account)
                </span>
            </RowTemplate>
        </BorderedListBox>
    </div>
</div>
