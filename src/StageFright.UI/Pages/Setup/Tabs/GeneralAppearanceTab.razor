<div class="mb-3">
    <label for="orgName" class="form-label">Organisation Name <span aria-hidden="true" class="text-danger">*</span></label>
    <InputText id="orgName" class="form-control form-control-sm" @bind-Value="Model.OrganizationName" placeholder="e.g. Springfield Choral Society" />
    <ValidationMessage For="() => Model.OrganizationName" class="text-danger small" />
</div>
