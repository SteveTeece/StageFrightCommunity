@using StageFright.UI.Shared

<div class="row g-2 mb-3">
    <div class="col">
        <label for="agmMonth" class="form-label">AGM Month</label>
        <InputSelect id="agmMonth" class="form-select form-select-sm" @bind-Value="Model.CommitteeRenewalMonth">
            @for (var m = 1; m <= 12; m++)
            {
                var month = m;
                <option value="@month">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(month)</option>
            }
        </InputSelect>
        <div class="form-text small">The month your AGM is normally held. Drives committee term boundaries.</div>
    </div>
    <div class="col">
        <label for="seatCountTarget" class="form-label">General Committee Seat Count Target</label>
        <InputNumber id="seatCountTarget" class="form-control form-control-sm" @bind-Value="Model.GeneralCommitteeSeatCountTarget" />
        <div class="form-text small">Optional — guidance only, no hard cap is enforced when recording an AGM.</div>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-6">
        <label for="committee-role-input" class="form-label">Additional Office-Holder Titles</label>
        <div class="input-group input-group-sm">
            <input id="committee-role-input" type="text" class="form-control"
                   @bind="_titleInput" @bind:event="oninput"
                   placeholder="e.g. Publicity Officer" />
            <button id="committee-role-add-btn" type="button" class="btn btn-outline-primary" @onclick="HandleAddAsync" aria-label="Add title">&rarr;</button>
        </div>
        @if (_error is not null)
        {
            <div class="text-danger small">@_error</div>
        }
        <div class="form-text small">
            Optional, one at a time. President/Secretary/Treasurer are always included.
            Can also be configured later from Settings.
        </div>
    </div>
    <div class="col-md-6">
        <label class="form-label">Additional Titles</label>
        <BorderedListBox TItem="string" Items="QueuedTitles"
                          OnRemove="@(EventCallback.Factory.Create<string>(this, HandleRemoveAsync))"
                          EmptyText="No additional titles added yet.">
            <RowTemplate Context="title">
                <span>@title</span>
            </RowTemplate>
        </BorderedListBox>
    </div>
</div>
