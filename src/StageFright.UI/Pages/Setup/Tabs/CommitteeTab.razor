@using StageFright.UI.Shared

<div class="row g-2 mb-3">
    <div class="col">
        <label for="agmMonth" class="form-label">@L["Setup_Committee_AgmMonthLabel"]</label>
        <InputSelect id="agmMonth" class="form-select form-select-sm" @bind-Value="Model.CommitteeRenewalMonth">
            @for (var m = 1; m <= 12; m++)
            {
                var month = m;
                <option value="@month">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(month)</option>
            }
        </InputSelect>
        <div class="form-text small">@L["Setup_Committee_AgmMonthHelp"]</div>
    </div>
    <div class="col">
        <label for="seatCountTarget" class="form-label">@L["Setup_Committee_SeatTargetLabel"]</label>
        <InputNumber id="seatCountTarget" class="form-control form-control-sm" @bind-Value="Model.GeneralCommitteeSeatCountTarget" />
        <div class="form-text small">@L["Setup_Committee_SeatTargetHelp"]</div>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-6">
        <label for="committee-role-input" class="form-label">@L["Setup_Committee_TitlesLabel"]</label>
        <div class="input-group input-group-sm">
            <input id="committee-role-input" type="text" class="form-control"
                   @bind="_titleInput" @bind:event="oninput"
                   placeholder="@L["Setup_Committee_TitlesPlaceholder"]" />
            <button id="committee-role-add-btn" type="button" class="btn btn-outline-primary" @onclick="HandleAddAsync" aria-label="@L["Setup_Committee_AddTitleAriaLabel"]">&rarr;</button>
        </div>
        @if (_error is not null)
        {
            <div class="text-danger small">@_error</div>
        }
        <div class="form-text small">
            @L["Setup_Committee_TitlesHelp"]
        </div>
    </div>
    <div class="col-md-6">
        <label class="form-label">@L["Setup_Committee_TitlesListLabel"]</label>
        <BorderedListBox TItem="string" Items="QueuedTitles"
                          OnRemove="@(EventCallback.Factory.Create<string>(this, HandleRemoveAsync))"
                          EmptyText="@L["Setup_Committee_TitlesListEmpty"]">
            <RowTemplate Context="title">
                <span>@title</span>
            </RowTemplate>
        </BorderedListBox>
    </div>
</div>
