@page "/setup"
@inherits ComponentBase
@inject ISetupService SetupService
@inject NavigationManager Nav

<PageTitle>First-Time Setup — StageFright Community</PageTitle>

<div class="container mt-5" style="max-width:560px">
    <h1 class="mb-1">Welcome to StageFright Community</h1>
    <p class="text-muted mb-4">Complete the short setup below to get started.</p>

    @if (_errorMessage is not null)
    {
        <div class="alert alert-danger" role="alert">@_errorMessage</div>
    }

    <EditForm Model="_model" OnValidSubmit="HandleValidSubmitAsync">
        <DataAnnotationsValidator />

        <div class="mb-3">
            <label for="orgName" class="form-label">Organisation Name <span aria-hidden="true" class="text-danger">*</span></label>
            <InputText id="orgName" class="form-control" @bind-Value="_model.OrganizationName" placeholder="e.g. Springfield Choral Society" />
            <ValidationMessage For="() => _model.OrganizationName" class="text-danger small" />
        </div>

        <div class="row g-3 mb-3">
            <div class="col">
                <label for="annualFee" class="form-label">Annual Fee ($)</label>
                <InputNumber id="annualFee" class="form-control" @bind-Value="_model.AnnualFee" />
                <ValidationMessage For="() => _model.AnnualFee" class="text-danger small" />
            </div>
            <div class="col">
                <label for="attendanceFee" class="form-label">Attendance Fee ($)</label>
                <InputNumber id="attendanceFee" class="form-control" @bind-Value="_model.AttendanceFee" />
                <ValidationMessage For="() => _model.AttendanceFee" class="text-danger small" />
            </div>
        </div>

        <div class="mb-4">
            <label for="renewalMonth" class="form-label">Membership Renewal Month <span aria-hidden="true" class="text-danger">*</span></label>
            <InputSelect id="renewalMonth" class="form-select" @bind-Value="_model.MembershipRenewalMonth">
                @for (var m = 1; m <= 12; m++)
                {
                    var month = m;
                    <option value="@month">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(month)</option>
                }
            </InputSelect>
            <ValidationMessage For="() => _model.MembershipRenewalMonth" class="text-danger small" />
        </div>

        <button type="submit" class="btn btn-primary w-100" disabled="@_submitting">
            @if (_submitting)
            {
                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
            }
            Get Started
        </button>
    </EditForm>
</div>
