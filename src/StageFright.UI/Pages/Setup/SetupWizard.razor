@page "/setup"
@inherits ComponentBase
@inject ISetupService SetupService
@inject NavigationManager Nav
@using StageFright.UI.Pages.Setup.Tabs
@using StageFright.UI.Shared

<PageTitle>@L["Setup_Page_Title"]</PageTitle>

<div class="mt-3">
    <h1 class="mb-1">@L["Setup_Wizard_Heading"]</h1>
    <p class="text-muted mb-3 small">@L["Setup_Wizard_Subheading"]</p>

    @if (_errorMessage is not null)
    {
        <div class="alert alert-danger py-1 mb-2 small" role="alert">@_errorMessage</div>
    }

    <EditForm EditContext="_editContext" OnValidSubmit="HandleValidSubmitAsync" OnInvalidSubmit="HandleInvalidSubmit">
        <DataAnnotationsValidator />

        <Tabs @ref="_tabsRef">
            <Tab Title="@L["Setup_Tab_OrganisationSettings"]" OnClick="@(() => SetActiveTab(0))">
                <Content>
                    <div class="pt-3">
                        @if (_tabShown[0])
                        {
                            <ErrorBoundary>
                                <ChildContent>
                                    <GeneralAppearanceTab Model="_model" />
                                    <MembershipFeesTab Model="_model" />
                                    <div class="row g-3 mb-3">
                                        <ThemeSelectionTab />
                                        <SalesTaxTab Model="_model" />
                                    </div>
                                    <SampleDataTab DebugSeederAvailable="_debugSeeder is not null"
                                                   SeedWithTestData="_seedWithTestData"
                                                   SeedWithTestDataChanged="HandleSeedWithTestDataChanged" />
                                </ChildContent>
                                <ErrorContent Context="tabError"><div class="alert alert-danger">@L["Setup_Tab_LoadFailed"]</div></ErrorContent>
                            </ErrorBoundary>
                        }
                    </div>
                </Content>
            </Tab>
            <Tab Title="@L["Setup_Tab_ChartOfAccounts"]" Disabled="@_seedWithTestData" OnClick="@(() => SetActiveTab(1))">
                <Content>
                    <div class="pt-3">
                        @if (_tabShown[1])
                        {
                            <ErrorBoundary>
                                <ChildContent>
                                    <ChartOfAccountsTab QueuedAccounts="_queuedAccounts"
                                                         OnAdd="HandleQueueAccount"
                                                         OnRemove="HandleRemoveQueuedAccount" />
                                </ChildContent>
                                <ErrorContent Context="tabError"><div class="alert alert-danger">@L["Setup_Tab_LoadFailed"]</div></ErrorContent>
                            </ErrorBoundary>
                        }
                    </div>
                </Content>
            </Tab>
            <Tab Title="@L["Setup_Tab_OpeningBalances"]" Disabled="@_seedWithTestData" OnClick="@(() => SetActiveTab(2))">
                <Content>
                    <div class="pt-3">
                        @if (_tabShown[2])
                        {
                            <ErrorBoundary>
                                <ChildContent>
                                    <OpeningBalancesTab QueuedAccounts="_queuedAccounts"
                                                         OnSubmit="HandleQueueOpeningBalances" />
                                </ChildContent>
                                <ErrorContent Context="tabError"><div class="alert alert-danger">@L["Setup_Tab_LoadFailed"]</div></ErrorContent>
                            </ErrorBoundary>
                        }
                    </div>
                </Content>
            </Tab>
            <Tab Title="@L["Setup_Tab_Committee"]" Disabled="@_seedWithTestData" OnClick="@(() => SetActiveTab(3))">
                <Content>
                    <div class="pt-3">
                        @if (_tabShown[3])
                        {
                            <ErrorBoundary>
                                <ChildContent>
                                    <CommitteeTab Model="_model"
                                                  QueuedTitles="_queuedCommitteeTitles"
                                                  OnAdd="HandleQueueCommitteeTitle"
                                                  OnRemove="HandleRemoveQueuedCommitteeTitle" />
                                </ChildContent>
                                <ErrorContent Context="tabError"><div class="alert alert-danger">@L["Setup_Tab_LoadFailed"]</div></ErrorContent>
                            </ErrorBoundary>
                        }
                    </div>
                </Content>
            </Tab>
            <Tab Title="@L["Setup_Tab_Review"]" OnClick="@(() => SetActiveTab(4))">
                <Content>
                    <div class="pt-3">
                        @if (_tabShown[4])
                        {
                            <ErrorBoundary>
                                <ChildContent>
                                    <ReviewTab Model="_model"
                                               QueuedCommitteeTitles="_queuedCommitteeTitles"
                                               QueuedAccounts="_queuedAccounts"
                                               DebugSeederAvailable="_debugSeeder is not null"
                                               SeedWithTestData="_seedWithTestData" />
                                </ChildContent>
                                <ErrorContent Context="tabError"><div class="alert alert-danger">@L["Setup_Tab_LoadFailed"]</div></ErrorContent>
                            </ErrorBoundary>
                        }
                    </div>
                </Content>
            </Tab>
        </Tabs>

        <div class="d-flex gap-2 mt-3">
            @if (_currentTabIndex < _tabShown.Count - 1)
            {
                <button type="button" id="btn-next" class="btn btn-primary btn-sm" @onclick="HandleNextAsync">@L["Setup_Nav_NextButton"]</button>
            }
            else
            {
                <button type="submit" id="btn-finish" class="btn btn-primary btn-sm" disabled="@_submitting">
                    @if (_submitting)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                    }
                    @L["Setup_Nav_FinishButton"]
                </button>
            }
        </div>
    </EditForm>
</div>

@if (_seedingInProgress)
{
    <div class="setup-seeding-overlay" role="status" aria-live="polite" aria-atomic="true">
        <div class="setup-seeding-overlay-card text-center">
            <div class="spinner-border text-primary mb-2" role="status" aria-hidden="true"></div>
            <p class="mb-1">@L["Setup_Seeding_Message"]</p>
            @if (_seedingProgress is not null)
            {
                <p class="mb-0 small text-muted">@_seedingProgress</p>
            }
        </div>
    </div>
}
