@page "/setup"
@inherits ComponentBase
@inject ISetupService SetupService
@inject NavigationManager Nav

<PageTitle>First-Time Setup — StageFright Community</PageTitle>

<div class="container mt-3" style="max-width:560px">
    <h1 class="mb-1">Welcome to StageFright Community</h1>
    <p class="text-muted mb-3 small">Complete the short setup below to get started.</p>

    @if (_errorMessage is not null)
    {
        <div class="alert alert-danger py-1 mb-2 small" role="alert">@_errorMessage</div>
    }

    <EditForm Model="_model" OnValidSubmit="HandleValidSubmitAsync">
        <DataAnnotationsValidator />

        <div class="mb-2">
            <label for="orgName" class="form-label">Organisation Name <span aria-hidden="true" class="text-danger">*</span></label>
            <InputText id="orgName" class="form-control form-control-sm" @bind-Value="_model.OrganizationName" placeholder="e.g. Springfield Choral Society" />
            <ValidationMessage For="() => _model.OrganizationName" class="text-danger small" />
        </div>

        <div class="row g-2 mb-2">
            <div class="col">
                <label for="annualFee" class="form-label">Annual Fee</label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text">@System.Globalization.CultureInfo.CurrentCulture.NumberFormat.CurrencySymbol</span>
                    <InputNumber id="annualFee" class="form-control" @bind-Value="_model.AnnualFee" @bind-Value:format="N2" />
                </div>
                <ValidationMessage For="() => _model.AnnualFee" class="text-danger small" />
            </div>
            <div class="col">
                <label for="attendanceFee" class="form-label">Attendance Fee</label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text">@System.Globalization.CultureInfo.CurrentCulture.NumberFormat.CurrencySymbol</span>
                    <InputNumber id="attendanceFee" class="form-control" @bind-Value="_model.AttendanceFee" @bind-Value:format="N2" />
                </div>
                <ValidationMessage For="() => _model.AttendanceFee" class="text-danger small" />
            </div>
        </div>

        <div class="mb-2">
            <label for="renewalMonth" class="form-label">Membership Renewal Month <span aria-hidden="true" class="text-danger">*</span></label>
            <InputSelect id="renewalMonth" class="form-select form-select-sm" @bind-Value="_model.MembershipRenewalMonth">
                @for (var m = 1; m <= 12; m++)
                {
                    var month = m;
                    <option value="@month">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(month)</option>
                }
            </InputSelect>
            <ValidationMessage For="() => _model.MembershipRenewalMonth" class="text-danger small" />
        </div>

        <div class="mb-3">
            <div class="form-check form-check-sm">
                <InputCheckbox id="seedData" class="form-check-input" @bind-Value="_seedWithTestData" />
                <label for="seedData" class="form-check-label">Load sample data (members, rehearsals, events &amp; finances)</label>
            </div>
        </div>

        <button type="submit" class="btn btn-primary btn-sm w-100" disabled="@_submitting">
            @if (_submitting)
            {
                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
            }
            Get Started
        </button>

        @if (_submitting && _seedingProgress is not null)
        {
            <div class="mt-2 d-flex align-items-center gap-2 text-muted small" aria-live="polite" aria-atomic="true">
                <span class="spinner-border spinner-border-sm flex-shrink-0" role="status" aria-hidden="true"></span>
                <span>@_seedingProgress</span>
            </div>
        }
    </EditForm>
</div>
