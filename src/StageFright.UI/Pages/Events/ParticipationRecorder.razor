@using StageFright.Data.Repositories
@using StageFright.Core.Entities

<div class="participation-recorder">
    @if (ErrorMessage != null)
    {
        <div class="error-message">@ErrorMessage</div>
    }

    @if (IsLoading)
    {
        <div class="loading">Loading participation recorder...</div>
    }
    else if (Event != null)
    {
        <div class="recorder-header">
            <h2>Record Participation - @Event.Date.ToShortDateString()</h2>
        </div>

        <form @onsubmit="SaveParticipation">
            <table class="participation-table">
                <thead>
                    <tr>
                        <th>Member Name</th>
                        <th>
                            <label>
                                <input type="checkbox" @bind="AllParticipated" />
                                Participated
                            </label>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var member in Members)
                    {
                        var memberParticipation = ParticipationRecords.FirstOrDefault(p => p.MemberId == member.Id) ?? new ParticipationRecord { MemberId = member.Id };

                        <tr>
                            <td>@member.Name</td>
                            <td>
                                <input type="checkbox" @bind="memberParticipation.Participated" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="form-buttons">
                <button type="submit" class="btn btn-primary">Save Participation</button>
                <button type="button" class="btn btn-secondary" @onclick="Cancel">Cancel</button>
            </div>
        </form>
    }
</div>
