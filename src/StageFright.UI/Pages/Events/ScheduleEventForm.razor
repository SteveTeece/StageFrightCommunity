@using StageFright.Data.Repositories
@using StageFright.Core.Entities

<div class="schedule-event-form">
    @if (ErrorMessage != null)
    {
        <div class="error-message">@ErrorMessage</div>
    }

    <form @onsubmit="ScheduleEvent">
        <div class="form-group">
            <label for="date">Date (required):</label>
            <input id="date" type="date" class="form-control" value="@DateString" @onchange="@((ChangeEventArgs e) => DateString = e?.Value?.ToString() ?? "")" required />
        </div>

        <div class="form-group">
            <label for="eventType">Event Type (required):</label>
            <select id="eventType" class="form-control" @bind="EventType" required>
                <option value="">Select event type...</option>
                <option value="Performance">Performance</option>
                <option value="Eisteddfod">Eisteddfod</option>
                <option value="Fund raiser">Fund raiser</option>
                <option value="Promotional">Promotional</option>
                <option value="Annual General Meeting">Annual General Meeting</option>
            </select>
        </div>

        <div class="form-group">
            <label for="notes">Notes (optional):</label>
            <textarea id="notes" class="form-control" @bind="Notes" rows="3"></textarea>
        </div>

        <div class="form-buttons">
            <button type="submit" class="btn btn-primary">Schedule Event</button>
            <button type="button" class="btn btn-secondary" @onclick="Cancel">Cancel</button>
        </div>
    </form>
</div>
