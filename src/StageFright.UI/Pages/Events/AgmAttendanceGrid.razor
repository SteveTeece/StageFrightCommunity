@if (_rows.Count == 0)
{
    <div class="alert alert-warning py-1 mb-2 small">@L["Events_AgmAttendance_NoActiveMembers"]</div>
}
else
{
    <div class="agm-attendance-scroll" style="flex:1; min-height:0; overflow-y:auto;">
        <RadzenDataGrid Data="@_rows" TItem="AttendanceRow"
                        AllowSorting="true" AllowPaging="false"
                        class="rz-shadow-0">
            <Columns>
                <RadzenDataGridColumn TItem="AttendanceRow" Title="@L["Events_AgmAttendance_AttendedColumn"]" Width="120px" Sortable="false">
                    <HeaderTemplate>
                        <div class="d-flex flex-column align-items-center gap-1">
                            <span>@L["Events_AgmAttendance_AttendedColumn"]</span>
                            <span class="select-all-inline small text-muted">
                                (<input type="checkbox" class="form-check-input" id="select-all-agm-attended"
                                        checked="@AllAttended"
                                        @onchange="e => { ToggleSelectAll((bool)(e.Value ?? false)); StateHasChanged(); }"
                                        aria-label="@L["Events_AgmAttendance_SelectAllAriaLabel"]" />
                                <label class="form-check-label mb-0" for="select-all-agm-attended">@L["Events_AgmAttendance_SelectAllLabel"]</label>)
                            </span>
                        </div>
                    </HeaderTemplate>
                    <Template Context="row">
                        <div class="text-center">
                            <input type="checkbox" class="form-check-input" id="agm-attended-@row.MemberId"
                                   checked="@row.Attended"
                                   @onchange="e => { row.Attended = (bool)(e.Value ?? false); StateHasChanged(); }"
                                   aria-label="@RowAriaLabel(row.MemberName)" />
                        </div>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="AttendanceRow" Property="MemberName" Title="@L["Events_AgmAttendance_MemberColumn"]" />
            </Columns>
        </RadzenDataGrid>
    </div>
}
