@page "/events/agm/new"

<PageTitle>@L["Events_Agm_SchedulePageTitle"]</PageTitle>

<div class="page-header mb-2">
    <h1 class="h3">@L["Events_Agm_ScheduleHeading"]</h1>
</div>

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="alert alert-danger py-1 mb-2 small" role="alert">@_errorMessage</div>
}

<div class="row g-2 mb-2">
    <div class="col-md-4">
        <label for="agmDate" class="form-label">@L["Events_Agm_MeetingDateLabel"]</label>
        <input type="date" id="agmDate" class="form-control form-control-sm"
               @bind="_date" @bind:format="yyyy-MM-dd" />
    </div>
    <div class="col-md-8">
        <label for="agmNotes" class="form-label">@L["Events_Agm_NotesLabel"]</label>
        <input type="text" id="agmNotes" class="form-control form-control-sm" @bind="_notes" />
    </div>
</div>

<div class="d-flex gap-2 mt-2">
    <button class="btn btn-primary btn-sm" @onclick="SaveAsync" disabled="@_saving">
        @(_saving ? Shared["Shared_Action_Saving"] : L["Events_Agm_ScheduleSubmitButton"])
    </button>
    <a href="/events/agm" class="btn btn-outline-secondary btn-sm">@Shared["Shared_Action_Cancel"]</a>
</div>
