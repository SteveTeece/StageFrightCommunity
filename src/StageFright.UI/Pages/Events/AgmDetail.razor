@page "/events/agm/{id:guid}"

<PageTitle>@L["Events_Agm_DetailPageTitle"]</PageTitle>

@if (_loading)
{
    <p role="status" aria-live="polite">@Shared["Shared_Common_Loading"]</p>
}
else if (_notFound)
{
    <div class="alert alert-warning py-1 mb-2 small">@L["Events_Agm_NotFoundNotice"]</div>
    <a href="/events/agm" class="btn btn-outline-secondary btn-sm">@L["Events_Agm_BackButton"]</a>
}
else
{
    <div class="page-header d-flex align-items-center justify-content-between mb-2">
        <h1 class="h3 mb-0">
            @DetailHeadingText()
            @if (_agm!.IsRecorded)
            {
                <span class="badge bg-success">@L["Events_Status_Recorded"]</span>
            }
            else
            {
                <span class="badge bg-warning text-dark">@L["Events_Status_Scheduled"]</span>
            }
        </h1>
        <div class="d-flex gap-1">
            <button class="btn btn-outline-secondary btn-sm"
                    @onclick="PrintAttendanceReport"
                    aria-label="@L["Events_Agm_PrintReportButtonAriaLabel"]">
                @L["Events_Agm_PrintReportButton"]
            </button>
            <button class="btn btn-outline-secondary btn-sm"
                    @onclick="PrintAgmResults"
                    aria-label="@L["Events_Agm_PrintResultsButtonAriaLabel"]">
                @L["Events_Agm_PrintResultsButton"]
            </button>
            <button class="btn btn-outline-danger btn-sm" @onclick="ArchiveAsync" disabled="@_archiving">
                @(_archiving ? L["Events_Agm_ArchivingText"] : L["Events_Agm_ArchiveButton"])
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_printMessage))
    {
        <div class="alert alert-warning py-1 mb-2 small" role="alert">@_printMessage</div>
    }

    @if (!string.IsNullOrWhiteSpace(_agm.Notes))
    {
        <p class="text-muted">@_agm.Notes</p>
    }

    @if (!_agm.IsRecorded)
    {
        <a href="@($"/events/agm/{_agm.Id}/record")" class="btn btn-primary btn-sm mt-1 mb-2">
            @L["Events_Agm_RecordAttendanceLink"]
        </a>
    }
    else
    {
        <h2 class="h6 mb-1">@L["Events_Agm_AttendanceHeading"]</h2>
        <p class="small">@AttendanceSummaryText()</p>

        <h2 class="h6 mb-1 mt-3">@L["Events_Agm_ElectedPositionsHeading"]</h2>
        @if (PositionLines.Count == 0 && GeneralCommitteeMemberNames.Count == 0)
        {
            <p class="small text-muted">@L["Events_Agm_NoPositionsRecorded"]</p>
        }
        else
        {
            @if (PositionLines.Count > 0)
            {
                <ul class="list-unstyled small">
                    @foreach (var line in PositionLines)
                    {
                        <li class="mb-1">
                            <strong>@line.Label</strong> — @line.MemberText
                        </li>
                    }
                </ul>
            }
            @if (GeneralCommitteeMemberNames.Count > 0)
            {
                <div class="mb-1">
                    <strong class="small d-block mb-1">@L["Events_Agm_GeneralCommitteeHeading"]</strong>
                    <BorderedListBox TItem="string" Items="GeneralCommitteeMemberNames">
                        <RowTemplate Context="name"><span class="small">@name</span></RowTemplate>
                    </BorderedListBox>
                </div>
            }
        }
    }

    <a href="/events/agm" class="btn btn-outline-secondary btn-sm mt-2">@L["Events_Agm_BackButton"]</a>
}
