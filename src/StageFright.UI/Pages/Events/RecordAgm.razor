@page "/events/agm/{Id:guid}/record"

<PageTitle>@L["Events_Agm_RecordPageTitle"]</PageTitle>

<div class="page-header mb-2">
    <h1 class="h3">@L["Events_Agm_RecordHeading"]</h1>
</div>

@if (_loading)
{
    <p role="status" aria-live="polite">@Shared["Shared_Common_Loading"]</p>
}
else if (!string.IsNullOrEmpty(_guardMessage))
{
    <div class="alert alert-warning py-1 mb-2 small" role="alert">@_guardMessage</div>
    <a href="/events/agm" class="btn btn-outline-secondary btn-sm">@L["Events_Agm_BackButton"]</a>
}
else
{
    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-danger py-1 mb-2 small" role="alert">@_errorMessage</div>
    }

    <p class="text-muted">@MeetingDateText()</p>

    <h2 class="h6 mb-1">@L["Events_Agm_AttendanceHeading"]</h2>
    <div style="display:flex; flex-direction:column; height:360px;">
        <AgmAttendanceGrid @ref="_attendanceGrid" Members="@_activeMembers" />
    </div>

    <h2 class="h6 mb-1 mt-3">@L["Events_Agm_CommitteeElectionsHeading"]</h2>
    <div class="row g-2 mb-2">
        @foreach (var type in _officeHolderTypes)
        {
            <div class="col-md-4">
                <label for="office-@type.Id" class="form-label">@type.Name</label>
                <select id="office-@type.Id" class="form-select form-select-sm"
                        value="@(_officeHolderAssignments[type.Id]?.ToString() ?? "")"
                        @onchange="e => OnOfficeHolderChanged(type.Id, e.Value?.ToString())">
                    <option value="">@L["Events_Agm_VacantOption"]</option>
                    @foreach (var member in _activeMembers)
                    {
                        <option value="@member.Id">@member.SortableFullName</option>
                    }
                </select>
            </div>
        }
    </div>

    <h2 class="h6 mb-1">@L["Events_Agm_GeneralCommitteeMembersHeading"]</h2>
    <p class="small text-muted">
        @SelectedCountText()
        @if (_seatCountTarget.HasValue)
        {
            <span> @SelectedOfTargetText()</span>
        }
    </p>
    <div class="mb-2" style="max-height:200px; overflow-y:auto;">
        @foreach (var member in _activeMembers)
        {
            <div class="form-check">
                <input type="checkbox" class="form-check-input" id="general-@member.Id"
                       checked="@_generalCommitteeMemberIds.Contains(member.Id)"
                       @onchange="e => ToggleGeneralCommittee(member.Id, (bool)(e.Value ?? false))" />
                <label class="form-check-label" for="general-@member.Id">@member.SortableFullName</label>
            </div>
        }
    </div>

    <div class="d-flex gap-2 mt-2">
        <button class="btn btn-primary btn-sm" @onclick="SaveAsync" disabled="@_saving">
            @(_saving ? Shared["Shared_Action_Saving"] : L["Events_Agm_RecordSubmitButton"])
        </button>
        <a href="/events/agm" class="btn btn-outline-secondary btn-sm">@Shared["Shared_Action_Cancel"]</a>
    </div>
}
