@page "/events"
@layout MainLayout
@using StageFright.Data.Repositories
@using StageFright.Core.Entities

<div class="events-module">
    <div class="module-header">
        <h1>Events</h1>
        <button class="btn btn-primary" @onclick="OpenScheduleForm">Schedule Event</button>
    </div>

    @if (ShowScheduleForm)
    {
        <ScheduleEventForm OnSaved="EventScheduled" OnCancelled="HideScheduleForm" />
    }

    @if (ShowParticipationRecorder)
    {
        <ParticipationRecorder EventId="SelectedEventId" OnSaved="ParticipationRecorded" OnCancelled="HideParticipationRecorder" />
    }

    @if (IsLoading)
    {
        <div class="loading">Loading events...</div>
    }
    else if (ErrorMessage != null)
    {
        <div class="error-message">@ErrorMessage</div>
    }
    else
    {
        <div class="events-list">
            <h2>Scheduled Events</h2>
            @if (EventList.Count == 0)
            {
                <p>No events scheduled yet.</p>
            }
            else
            {
                <table class="table">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Event Type</th>
                            <th>Participation Rate</th>
                            <th>Notes</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var evt in EventList)
                        {
                            <tr>
                                <td>@evt.Date.ToShortDateString()</td>
                                <td>@evt.EventType</td>
                                <td>@(evt.StoredParticipationRate > 0 ? evt.StoredParticipationRate.ToString("F1") + "%" : "Not recorded")</td>
                                <td>@evt.Notes</td>
                                <td>
                                    <button class="btn btn-sm btn-primary" @onclick="() => RecordParticipation(evt.Id)">Record Participation</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    }
</div>
