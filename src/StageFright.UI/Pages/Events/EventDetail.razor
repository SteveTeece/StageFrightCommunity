@page "/events/{Id:guid}"

<PageTitle>@PageTitleText()</PageTitle>

@if (_loading)
{
    <p role="status" aria-live="polite">@Shared["Shared_Common_Loading"]</p>
}
else if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="alert alert-warning py-1 mb-2 small">@_errorMessage</div>
    <a href="/events" class="btn btn-outline-secondary btn-sm mt-2">@L["Events_Detail_BackButton"]</a>
}
else if (_event is not null)
{
    <div class="page-header d-flex align-items-center justify-content-between mb-2">
        <h1 class="h3 mb-0">@_event.Date.ToString("dddd, d MMMM yyyy")</h1>
        <div class="d-flex gap-1">
            <button class="btn btn-outline-secondary btn-sm"
                    @onclick="PrintAttendanceSheet"
                    aria-label="@L["Events_Detail_PrintSheetAriaLabel"]">
                @L["Events_Detail_PrintSheetButton"]
            </button>
            <a href="/events" class="btn btn-outline-secondary btn-sm">@L["Events_Detail_BackButton"]</a>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_printMessage))
    {
        <div class="alert alert-warning py-1 mb-2 small" role="alert">@_printMessage</div>
    }

    <div class="row g-2 mb-2">
        <div class="col-md-6">
            <dl class="row mb-0 small">
                <dt class="col-sm-5">@L["Events_Detail_EventTypeLabel"]</dt>
                <dd class="col-sm-7">@(_event.EventType?.Name ?? "—")</dd>

                @if (!string.IsNullOrEmpty(_event.Notes))
                {
                    <dt class="col-sm-5">@L["Events_Detail_NotesLabel"]</dt>
                    <dd class="col-sm-7">@_event.Notes</dd>
                }

                <dt class="col-sm-5">@L["Events_Detail_ParticipationRateLabel"]</dt>
                <dd class="col-sm-7">
                    @if (_event.StoredParticipationRate.HasValue)
                    {
                        <span>@($"{_event.StoredParticipationRate:F1}%")</span>
                    }
                    else
                    {
                        <span class="text-muted">@L["Events_Status_NotRecorded"]</span>
                    }
                </dd>
            </dl>
        </div>
    </div>

    @if (_event.ParticipationRecords.Any())
    {
        <section aria-label="@L["Events_Detail_AttendanceSection"]">
            <h2 class="h6 mb-1">@L["Events_Detail_AttendanceSection"]</h2>
            <RadzenDataGrid Data="@_event.ParticipationRecords.OrderBy(p => p.Member?.SortableFullName)" TItem="ParticipationRecord"
                            AllowSorting="true" AllowPaging="true" PageSize="15"
                            class="rz-shadow-0">
                <Columns>
                    <RadzenDataGridColumn TItem="ParticipationRecord" Title="@L["Events_Detail_MemberColumn"]">
                        <Template Context="record">
                            @(record.Member?.SortableFullName ?? "—")
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ParticipationRecord" Title="@L["Events_Detail_ParticipatedColumn"]" Width="140px" Sortable="false">
                        <Template Context="record">
                            <div class="text-center">
                                @if (record.Participated)
                                {
                                    <span class="badge bg-success" aria-label="@L["Events_Detail_ParticipatedYesAriaLabel"]">@L["Events_Detail_ParticipatedYes"]</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary" aria-label="@L["Events_Detail_ParticipatedNoAriaLabel"]">@L["Events_Detail_ParticipatedNo"]</span>
                                }
                            </div>
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </section>
    }
    else if (_event.StoredParticipationRate.HasValue)
    {
        <p class="text-muted small">@L["Events_Detail_NoAttendanceRecords"]</p>
    }
    else
    {
        <p class="text-muted small">@L["Events_Detail_ParticipationNotRecorded"]</p>
        <a href="/events/@_event.Id/participation" class="btn btn-primary btn-sm">@L["Events_Detail_RecordParticipationButton"]</a>
    }
}
