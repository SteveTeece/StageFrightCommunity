@using StageFright.Core.Services
@using StageFright.Core.Entities

<div class="payment-recording-form">
    @if (ErrorMessage != null)
    {
        <div class="error-message">@ErrorMessage</div>
    }

    @if (SuccessMessage != null)
    {
        <div class="success-message">@SuccessMessage</div>
    }

    <form @onsubmit="SavePayment">
        <div class="form-group">
            <label for="paymentDate">Payment Date (required):</label>
            <input id="paymentDate" type="date" class="form-control" value="@PaymentDateString" @onchange="@((ChangeEventArgs e) => PaymentDateString = e?.Value?.ToString() ?? "")" required />
        </div>

        <div class="form-group">
            <label for="amount">Amount (required):</label>
            <input id="amount" type="number" step="0.01" min="0" class="form-control" @bind="FormModel.Amount" required />
        </div>

        <div class="form-group">
            <label for="paymentMethod">Payment Method (required):</label>
            <select id="paymentMethod" class="form-control" @bind="FormModel.PaymentMethod" required>
                <option value="">-- Select Payment Method --</option>
                <option value="Cash">Cash</option>
                <option value="Check">Check</option>
                <option value="Card">Card</option>
                <option value="Electronic Transfer">Electronic Transfer</option>
                <option value="Other">Other</option>
            </select>
        </div>

        <div class="form-group">
            <label for="paymentType">Payment Type (required):</label>
            <select id="paymentType" class="form-control" @bind="FormModel.PaymentType" required>
                <option value="">-- Select Payment Type --</option>
                <option value="Annual">Annual</option>
                <option value="Attendance">Attendance</option>
                <option value="Other">Other</option>
            </select>
        </div>

        <div class="form-group">
            <label for="member">Member (required):</label>
            <select id="member" class="form-control" @bind="FormModel.MemberId" required>
                <option value="">-- Select Member --</option>
                @foreach (var member in AvailableMembers)
                {
                    <option value="@member.Id">@member.Name</option>
                }
            </select>
        </div>

        <div class="form-group">
            <label for="category">Category (required):</label>
            <select id="category" class="form-control" @bind="FormModel.Category" required>
                <option value="">-- Select Category --</option>
                @foreach (var category in AvailableCategories)
                {
                    <option value="@category.Name">@category.Name (@category.Type)</option>
                }
            </select>
        </div>

        <div class="form-group">
            <label for="notes">Notes (optional):</label>
            <textarea id="notes" class="form-control" @bind="FormModel.Notes" rows="3"></textarea>
        </div>

        <div class="form-buttons">
            <button type="submit" class="btn btn-primary">Record Payment</button>
            <button type="button" class="btn btn-secondary" @onclick="Cancel">Cancel</button>
        </div>
    </form>
</div>
