@page "/finance/expenses"

<PageTitle>@L["Finance_Expense_PageTitle"]</PageTitle>

<div class="expense-payment-page container-fluid py-2">
    <h4 class="mb-2">@L["Finance_Expense_Heading"]</h4>

    @if (_loading)
    {
        <p role="status" aria-live="polite">@Shared["Shared_Common_Loading"]</p>
    }
    else
    {
        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="alert alert-danger py-1 mb-2 small" role="alert">@_errorMessage</div>
        }

        @if (_successMessage is not null)
        {
            <div class="alert alert-success py-1 mb-2 small" role="status">
                @_successMessage
                <div class="mt-1">
                    <button class="btn btn-sm btn-outline-success" @onclick="RecordAnother">@L["Finance_Common_RecordAnotherButton"]</button>
                </div>
            </div>
        }

        @if (_successMessage is null)
        {
            @if (_expenseAccounts.Count == 0)
            {
                <div class="alert alert-warning py-1 mb-2 small" role="alert">
                    @((MarkupString)L["Finance_Expense_NoAccountsHtml"].Value)
                </div>
            }
            else
            {
                <div class="card mb-2">
                    <div class="card-body py-2">
                        <EditForm Model="_form" OnValidSubmit="SaveAsync">
                            <div class="row g-2">

                                <div class="col-md-4">
                                    <label class="form-label" for="expenseDate">@L["Finance_Common_DateLabel"] <span aria-hidden="true">*</span></label>
                                    <InputDate id="expenseDate" class="form-control form-control-sm" @bind-Value="_form.Date" />
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label" for="expenseAmount">@L["Finance_Common_AmountLabel"] <span aria-hidden="true">*</span></label>
                                    <div class="input-group input-group-sm @(_errors.ContainsKey("Amount") ? "has-validation" : "")">
                                        <span class="input-group-text">@System.Globalization.CultureInfo.CurrentCulture.NumberFormat.CurrencySymbol</span>
                                        <InputNumber id="expenseAmount"
                                                     class="@(_errors.ContainsKey("Amount") ? "form-control is-invalid" : "form-control")"
                                                     @bind-Value="_form.Amount"
                                                     @bind-Value:format="N2" />
                                        @if (_errors.TryGetValue("Amount", out var amtErr))
                                        {
                                            <div class="invalid-feedback">@amtErr</div>
                                        }
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label" for="bankAccount">@L["Finance_Expense_PaidFromLabel"] <span aria-hidden="true">*</span></label>
                                    <InputSelect id="bankAccount"
                                                 class="@(_errors.ContainsKey("BankAccountId") ? "form-select form-select-sm is-invalid" : "form-select form-select-sm")"
                                                 @bind-Value="_form.BankAccountId">
                                        <option value="@Guid.Empty">@L["Finance_Common_SelectOption"]</option>
                                        @foreach (var bank in _bankAccounts)
                                        {
                                            <option value="@bank.Id">@bank.AccountNumber @bank.Name</option>
                                        }
                                    </InputSelect>
                                    @if (_errors.TryGetValue("BankAccountId", out var bankErr))
                                    {
                                        <div class="invalid-feedback d-block">@bankErr</div>
                                    }
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label" for="expenseAccount">@L["Finance_Expense_ExpenseAccountLabel"] <span aria-hidden="true">*</span></label>
                                    <InputSelect id="expenseAccount"
                                                 class="@(_errors.ContainsKey("ExpenseAccountId") ? "form-select form-select-sm is-invalid" : "form-select form-select-sm")"
                                                 @bind-Value="_form.ExpenseAccountId">
                                        <option value="@Guid.Empty">@L["Finance_Common_SelectOption"]</option>
                                        @foreach (var acc in _expenseAccounts)
                                        {
                                            <option value="@acc.Id">@acc.Name</option>
                                        }
                                    </InputSelect>
                                    @if (_errors.TryGetValue("ExpenseAccountId", out var accErr))
                                    {
                                        <div class="invalid-feedback d-block">@accErr</div>
                                    }
                                </div>

                                @if (_isTaxApplicable)
                                {
                                    <div class="col-md-4">
                                        <label class="form-label" for="expenseTaxCode">@L["Finance_Common_TaxTreatmentLabel"]</label>
                                        <InputSelect id="expenseTaxCode" class="form-select form-select-sm" @bind-Value="_form.TaxCode">
                                            <option value="">@L["Finance_Common_TaxExemptDefaultOption"]</option>
                                            <option value="@StageFright.Core.Enums.TaxCode.Taxable">@StageFright.Core.Enums.TaxCode.Taxable.LocalizeEnum()</option>
                                            <option value="@StageFright.Core.Enums.TaxCode.TaxExempt">@StageFright.Core.Enums.TaxCode.TaxExempt.LocalizeEnum()</option>
                                        </InputSelect>
                                        @if (TaxInclusiveHint is not null)
                                        {
                                            <div class="form-text small">@TaxInclusiveHint</div>
                                        }
                                    </div>
                                }

                                <div class="col-md-8">
                                    <label class="form-label" for="payee">@L["Finance_Expense_PayeeLabel"]</label>
                                    <InputText id="payee" class="form-control form-control-sm"
                                               @bind-Value="_form.Payee"
                                               placeholder="@L["Finance_Expense_PayeePlaceholder"]" />
                                </div>

                                <div class="col-12">
                                    <label class="form-label" for="expenseDescription">@L["Finance_Common_DescriptionLabel"]</label>
                                    <InputTextArea id="expenseDescription" class="form-control form-control-sm" rows="2"
                                                   @bind-Value="_form.Description"
                                                   placeholder="@L["Finance_Expense_DescriptionPlaceholder"]" />
                                </div>

                            </div>

                            <div class="d-flex gap-2 mt-2">
                                <button type="submit" class="btn btn-primary btn-sm" disabled="@_saving">
                                    @(_saving ? Shared["Shared_Action_Saving"] : L["Finance_Expense_SubmitButton"])
                                </button>
                                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="RecordAnother">@L["Finance_Common_ClearButton"]</button>
                            </div>
                        </EditForm>
                    </div>
                </div>
            }
        }
    }
</div>
