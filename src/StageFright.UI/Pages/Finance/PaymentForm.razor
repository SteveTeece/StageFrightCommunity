@using StageFright.Core.Enums

@if (_memberName is not null)
{
    <p class="text-muted mb-1 small">Member: <strong>@_memberName</strong></p>
}

@if (_loading)
{
    <p role="status" aria-live="polite">Loading…</p>
}
else
{
    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-danger py-1 mb-2 small" role="alert">@_errorMessage</div>
    }

    @if (_saved && _successMessage is not null)
    {
        <div class="alert alert-success py-1 mb-2 small" role="status">@_successMessage</div>
    }

    <div class="card mb-2">
        <div class="card-body py-2">
            <EditForm Model="_form" OnValidSubmit="SaveAsync">
                <div class="row g-2">

                    <div class="col-md-6">
                        <label class="form-label" for="payDate">Date <span aria-hidden="true">*</span></label>
                        <InputDate id="payDate" class="form-control form-control-sm" @bind-Value="_form.Date"
                                   disabled="@_saved" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label" for="amount">Amount <span aria-hidden="true">*</span></label>
                        <div class="input-group input-group-sm @(_errors.ContainsKey("Amount") ? "has-validation" : "")">
                            <span class="input-group-text">@System.Globalization.CultureInfo.CurrentCulture.NumberFormat.CurrencySymbol</span>
                            <InputNumber id="amount" class="@(_errors.ContainsKey("Amount") ? "form-control is-invalid" : "form-control")"
                                         @bind-Value="_form.Amount" @bind-Value:format="N2"
                                         disabled="@_saved" />
                            @if (_errors.TryGetValue("Amount", out var amtErr))
                            {
                                <div class="invalid-feedback">@amtErr</div>
                            }
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label" for="method">Payment Method <span aria-hidden="true">*</span></label>
                        <InputSelect id="method" class="form-select form-select-sm" @bind-Value="_form.PaymentMethod"
                                     disabled="@_saved">
                            @foreach (var method in Enum.GetValues<PaymentMethod>())
                            {
                                <option value="@method">@method</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label" for="type">Payment Type <span aria-hidden="true">*</span></label>
                        <InputSelect id="type" class="form-select form-select-sm" @bind-Value="_form.PaymentType"
                                     disabled="@_saved">
                            @foreach (var type in Enum.GetValues<PaymentType>())
                            {
                                <option value="@type">@type</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="col-12">
                        <OutstandingFeeSelectionGrid @ref="_feeGrid" Fees="_outstandingFees" ReadOnly="_saved"
                                                      SelectionChanged="OutstandingFeesSelectionChanged" />
                    </div>

                    <div class="col-12">
                        <label class="form-label" for="notes">Notes</label>
                        <InputTextArea id="notes" class="form-control form-control-sm" rows="2"
                                       @bind-Value="_form.Notes" />
                    </div>

                </div>

                @if (!_saved)
                {
                    <div class="d-flex gap-2 mt-2">
                        <button type="submit" class="btn btn-primary btn-sm" disabled="@(_saving || _outstandingFees.Count == 0)">
                            @(_saving ? "Saving…" : "Record Member Payment")
                        </button>
                        <button type="button" class="btn btn-outline-secondary btn-sm"
                                @onclick="Cancel">Cancel</button>
                    </div>
                }
                else
                {
                    <div class="d-flex gap-2 mt-2">
                        <button type="submit" class="btn btn-primary btn-sm" disabled="@_saving">
                            @(_saving ? "Saving…" : "Update Notes")
                        </button>
                        <button type="button" class="btn btn-outline-secondary btn-sm"
                                @onclick="Cancel">Back to Balances</button>
                    </div>
                }
            </EditForm>
        </div>
    </div>
}
