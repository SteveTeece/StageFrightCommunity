@using StageFright.Core.Modules.Finance

@if (_loading)
{
    <p role="status" aria-live="polite">Loading member balances…</p>
}
else if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="alert alert-danger py-1 mb-2 small" role="alert">@_errorMessage</div>
}
else if (_balances.Count == 0)
{
    <p class="text-muted">No outstanding balances found.</p>
}
else
{
    <RadzenDataGrid Data="@_balances" TItem="MemberBalance"
                    AllowSorting="true" AllowPaging="true" PageSize="15"
                    class="rz-shadow-0">
        <Columns>
            <RadzenDataGridColumn TItem="MemberBalance" Property="Name" Title="Member" Width="200px">
                <Template Context="row">
                    <a href="#" @onclick:preventDefault @onclick="() => GoToPayment(row.MemberId)"
                       class="text-decoration-none fw-semibold">
                        @row.Name
                    </a>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MemberBalance" Property="Balance" Title="Outstanding" Width="120px" FormatString="{0:C}" />
            <RadzenDataGridColumn TItem="MemberBalance" Title="Fee Breakdown" Sortable="false">
                <Template Context="row">
                    @if (_expanded.Contains(row.MemberId))
                    {
                        <div class="small">
                            @foreach (var fee in row.Fees)
                            {
                                <div class="d-flex gap-3">
                                    <span>@fee.FeeDate.Year @fee.FeeType</span>
                                    <span>@fee.Amount.ToString("C")</span>
                                    <span class="text-muted">due @fee.DueDate.ToString("d MMM yyyy")</span>
                                </div>
                            }
                        </div>
                        <button class="btn btn-link btn-sm p-0" @onclick="() => ToggleExpand(row.MemberId)">Hide fees</button>
                    }
                    else
                    {
                        <button class="btn btn-link btn-sm p-0" @onclick="() => ToggleExpand(row.MemberId)">
                            Show @row.Fees.Count @(row.Fees.Count == 1 ? "fee" : "fees")
                        </button>
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MemberBalance" Title="Actions" Width="210px" Sortable="false">
                <Template Context="row">
                    <button class="btn btn-primary btn-sm" @onclick="() => GoToPayment(row.MemberId)">
                        Record Member Payment
                    </button>
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
}
