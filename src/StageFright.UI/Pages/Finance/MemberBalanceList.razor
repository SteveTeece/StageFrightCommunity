@using StageFright.Core.Modules.Finance

@if (_loading)
{
    <p role="status" aria-live="polite">@L["Finance_Balances_LoadingText"]</p>
}
else if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="alert alert-danger py-1 mb-2 small" role="alert">@_errorMessage</div>
}
else if (_balances.Count == 0)
{
    <p class="text-muted">@L["Finance_Balances_EmptyText"]</p>
}
else
{
    <RadzenDataGrid Data="@_balances" TItem="MemberBalance"
                    AllowSorting="true" AllowPaging="true" PageSize="15"
                    class="rz-shadow-0">
        <Columns>
            <RadzenDataGridColumn TItem="MemberBalance" Property="Name" Title="@L["Finance_Balances_MemberColumn"]" Width="200px">
                <Template Context="row">
                    <a href="#" @onclick:preventDefault @onclick="() => GoToPayment(row.MemberId)"
                       class="text-decoration-none fw-semibold">
                        @row.Name
                    </a>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MemberBalance" Property="Balance" Title="@L["Finance_Balances_OutstandingColumn"]" Width="120px">
                <Template Context="row">@MoneyFormatter.Format(row.Balance)</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MemberBalance" Title="@L["Finance_Balances_FeeBreakdownColumn"]" Sortable="false">
                <Template Context="row">
                    @if (_expanded.Contains(row.MemberId))
                    {
                        <div class="small">
                            @foreach (var fee in row.Fees)
                            {
                                <div class="d-flex gap-3">
                                    <span>@fee.FeeDate.Year @fee.FeeType.LocalizeEnum()</span>
                                    <span>@MoneyFormatter.Format(fee.Amount)</span>
                                    <span class="text-muted">@FeeDueText(fee.DueDate)</span>
                                </div>
                            }
                        </div>
                        <button class="btn btn-link btn-sm p-0" @onclick="() => ToggleExpand(row.MemberId)">@L["Finance_Balances_HideFeesButton"]</button>
                    }
                    else
                    {
                        <button class="btn btn-link btn-sm p-0" @onclick="() => ToggleExpand(row.MemberId)">
                            @ShowFeesText(row.Fees.Count)
                        </button>
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MemberBalance" Title="@Shared["Shared_Table_ActionsColumn"]" Width="210px" Sortable="false">
                <Template Context="row">
                    <button class="btn btn-primary btn-sm" @onclick="() => GoToPayment(row.MemberId)">
                        @L["Finance_Balances_RecordPaymentButton"]
                    </button>
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
}
