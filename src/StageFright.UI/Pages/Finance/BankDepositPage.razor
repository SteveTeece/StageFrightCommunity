@page "/finance/bank-deposit"

<PageTitle>@L["Finance_BankDeposit_PageTitle"]</PageTitle>

<div class="bank-deposit-page container-fluid py-2">
    <h4 class="mb-2">@L["Finance_BankDeposit_Heading"]</h4>

    @if (_loading)
    {
        <p role="status" aria-live="polite">@Shared["Shared_Common_Loading"]</p>
    }
    else
    {
        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="alert alert-danger py-1 mb-2 small" role="alert">@_errorMessage</div>
        }

        @if (_successMessage is not null)
        {
            <div class="alert alert-success py-1 mb-2 small" role="status">
                @_successMessage
                <div class="mt-1">
                    <button class="btn btn-sm btn-outline-success" @onclick="RecordAnother">@L["Finance_Common_RecordAnotherButton"]</button>
                </div>
            </div>
        }

        @if (_successMessage is null)
        {
            @if (_destinationAccounts.Count == 0)
            {
                <div class="alert alert-warning py-1 mb-2 small" role="alert">
                    @((MarkupString)L["Finance_BankDeposit_NoAccountsHtml"].Value)
                </div>
            }
            else
            {
                <div class="card mb-2">
                    <div class="card-body py-2">
                        <EditForm Model="_form" OnValidSubmit="SaveAsync">
                            <div class="row g-2">

                                <div class="col-md-4">
                                    <label class="form-label" for="depositDate">@L["Finance_Common_DateLabel"] <span aria-hidden="true">*</span></label>
                                    <InputDate id="depositDate" class="form-control form-control-sm" @bind-Value="_form.Date" />
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label" for="depositAmount">@L["Finance_Common_AmountLabel"] <span aria-hidden="true">*</span></label>
                                    <div class="input-group input-group-sm @(_errors.ContainsKey("Amount") ? "has-validation" : "")">
                                        <span class="input-group-text">@System.Globalization.CultureInfo.CurrentCulture.NumberFormat.CurrencySymbol</span>
                                        <InputNumber id="depositAmount"
                                                     class="@(_errors.ContainsKey("Amount") ? "form-control is-invalid" : "form-control")"
                                                     @bind-Value="_form.Amount"
                                                     @bind-Value:format="N2" />
                                        @if (_errors.TryGetValue("Amount", out var amtErr))
                                        {
                                            <div class="invalid-feedback">@amtErr</div>
                                        }
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label" for="depositFrom">@L["Finance_BankDeposit_FromLabel"]</label>
                                    <input id="depositFrom" class="form-control form-control-sm" value="@L["Finance_BankDeposit_FromValue"]" disabled />
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label" for="toAccount">@L["Finance_BankDeposit_ToLabel"] <span aria-hidden="true">*</span></label>
                                    <InputSelect id="toAccount"
                                                 class="@(_errors.ContainsKey("ToAccountId") ? "form-select form-select-sm is-invalid" : "form-select form-select-sm")"
                                                 @bind-Value="_form.ToAccountId">
                                        <option value="@Guid.Empty">@L["Finance_Common_SelectOption"]</option>
                                        @foreach (var bank in _destinationAccounts)
                                        {
                                            <option value="@bank.Id">@bank.AccountNumber @bank.Name</option>
                                        }
                                    </InputSelect>
                                    @if (_errors.TryGetValue("ToAccountId", out var toErr))
                                    {
                                        <div class="invalid-feedback d-block">@toErr</div>
                                    }
                                </div>

                                <div class="col-12">
                                    <label class="form-label" for="depositDescription">@L["Finance_Common_DescriptionLabel"]</label>
                                    <InputTextArea id="depositDescription" class="form-control form-control-sm" rows="2"
                                                   @bind-Value="_form.Description"
                                                   placeholder="@L["Finance_BankDeposit_DescriptionPlaceholder"]" />
                                </div>

                            </div>

                            <div class="d-flex gap-2 mt-2">
                                <button type="submit" class="btn btn-primary btn-sm" disabled="@_saving">
                                    @(_saving ? Shared["Shared_Action_Saving"] : L["Finance_BankDeposit_SubmitButton"])
                                </button>
                                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="RecordAnother">@L["Finance_Common_ClearButton"]</button>
                            </div>
                        </EditForm>
                    </div>
                </div>
            }
        }
    }
</div>
