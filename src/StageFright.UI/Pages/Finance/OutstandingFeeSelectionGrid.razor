@if (Fees.Count == 0)
{
    <div class="alert alert-warning py-1 mb-2 small">@L["Finance_FeeSelection_EmptyText"]</div>
}
else
{
    <RadzenDataGrid Data="@_rows" TItem="OutstandingFeeRow"
                    AllowSorting="true" AllowPaging="true" PageSize="15"
                    class="rz-shadow-0">
        <Columns>
            <RadzenDataGridColumn TItem="OutstandingFeeRow" Title="@L["Finance_FeeSelection_SelectColumn"]" Width="100px" Sortable="false">
                <HeaderTemplate>
                    <div class="d-flex flex-column align-items-center gap-1">
                        <span>@L["Finance_FeeSelection_SelectColumn"]</span>
                        <span class="select-all-inline small text-muted">
                            (<input type="checkbox" class="form-check-input" id="select-all-outstanding-fees"
                                    checked="@AllSelected" disabled="@ReadOnly"
                                    @onchange="e => ToggleSelectAll((bool)(e.Value ?? false))"
                                    aria-label="@L["Finance_FeeSelection_SelectAllAriaLabel"]" />
                            <label class="form-check-label mb-0" for="select-all-outstanding-fees">@L["Finance_FeeSelection_SelectAllLabel"]</label>)
                        </span>
                    </div>
                </HeaderTemplate>
                <Template Context="row">
                    <div class="text-center">
                        <input type="checkbox" class="form-check-input" id="fee-@row.Fee.FeeId"
                               checked="@row.Selected" disabled="@ReadOnly"
                               @onchange="e => ToggleRow(row, (bool)(e.Value ?? false))"
                               aria-label="@SelectRowAriaLabel(row.Fee)" />
                    </div>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="OutstandingFeeRow" Title="@L["Finance_FeeSelection_FeeTypeColumn"]">
                <Template Context="row">
                    @row.Fee.FeeType.LocalizeEnum()
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="OutstandingFeeRow" Title="@L["Finance_FeeSelection_FeeDateColumn"]">
                <Template Context="row">
                    @row.Fee.FeeDate.ToString("d MMM yyyy")
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="OutstandingFeeRow" Title="@L["Finance_FeeSelection_DueDateColumn"]">
                <Template Context="row">
                    @row.Fee.DueDate.ToString("d MMM yyyy")
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="OutstandingFeeRow" Title="@L["Finance_FeeSelection_RemainingColumn"]">
                <Template Context="row">
                    <div class="text-end">@MoneyFormatter.Format(row.Fee.RemainingAmount)</div>
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
}
