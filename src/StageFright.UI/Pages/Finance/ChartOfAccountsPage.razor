@page "/finance/accounts"
@using StageFright.Core.Enums
@using StageFright.Core.Modules.Finance
@using StageFright.UI.Shared

<PageTitle>Chart of Accounts</PageTitle>

<div class="chart-of-accounts-page container-fluid py-2">
    <h4 class="mb-2">Chart of Accounts</h4>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-danger py-1 mb-2 small" role="alert">@_errorMessage</div>
    }

    @if (!string.IsNullOrEmpty(_successMessage))
    {
        <div class="alert alert-success py-1 mb-2 small" role="status">@_successMessage</div>
    }

    @if (_loading)
    {
        <p role="status" aria-live="polite">Loading accounts…</p>
    }
    else
    {
        <!-- Add Account Form -->
        <div class="card mb-2">
            <div class="card-body py-2">
                <h6 class="card-title mb-2">Add Account</h6>
                <AddAccountForm OnSubmit="HandleCreateAsync" ExistingNames="ExistingAccountNames" />
            </div>
        </div>

        <!-- Type filter -->
        <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
            <label for="type-filter" class="form-label small mb-0">Show:</label>
            <select id="type-filter" class="form-select form-select-sm w-auto"
                    value="@_typeFilter" @onchange="OnTypeFilterChanged" aria-label="Filter by account type">
                <option value="">All types</option>
                <option value="@AccountType.Asset">Assets</option>
                <option value="@AccountType.Liability">Liabilities</option>
                <option value="@AccountType.Equity">Equity</option>
                <option value="@AccountType.Income">Income</option>
                <option value="@AccountType.Expense">Expenses</option>
            </select>
            <div class="d-flex align-items-center gap-2 ms-auto">
                <label for="includeBalancesSwitch" class="form-label mb-0 small">Include Current Balances</label>
                <RadzenSwitch Name="includeBalancesSwitch" @bind-Value="_includeBalances" Change="@((bool _) => StateHasChanged())" />
                <button class="btn btn-outline-secondary btn-sm" @onclick="PrintAsync">Print Chart of Accounts</button>
            </div>
        </div>

        <!-- Active accounts -->
        <section aria-labelledby="accounts-heading" class="mb-2">
            <h6 id="accounts-heading" class="mb-1">Active Accounts</h6>
            @if (!FilteredAccounts.Any())
            {
                <p class="text-muted small mb-0">No accounts match the current filter.</p>
            }
            else
            {
                <RadzenDataGrid Data="@FilteredAccounts" TItem="AccountBalance"
                                AllowSorting="true" AllowPaging="true" PageSize="15"
                                class="rz-shadow-0">
                    <Columns>
                        <RadzenDataGridColumn TItem="AccountBalance" Title="No." Width="70px">
                            <Template Context="account">
                                <code>@account.AccountNumber</code>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="AccountBalance" Title="Name">
                            <Template Context="account">
                                @if (_editingId == account.AccountId)
                                {
                                    <input class="form-control form-control-sm d-inline-block w-auto me-1"
                                           @bind="_editName" aria-label="New name for @account.Name" />
                                    <button class="btn btn-primary btn-sm me-1" @onclick="() => SaveRenameAsync(account.AccountId)">Save</button>
                                    <button class="btn btn-outline-secondary btn-sm" @onclick="CancelRename">Cancel</button>
                                }
                                else
                                {
                                    @account.Name
                                    @if (account.IsSystem)
                                    {
                                        <span class="badge bg-secondary ms-1" title="System account">System</span>
                                    }
                                    @if (account.IsBankAccount)
                                    {
                                        <span class="badge bg-info ms-1" title="Bank / cash account">Bank</span>
                                    }
                                }
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="AccountBalance" Title="Type" Width="110px">
                            <Template Context="account">
                                @account.Type
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="AccountBalance" Property="Balance" Title="Balance" Width="120px">
                            <Template Context="account">
                                @if (account.HasError)
                                {
                                    <span class="text-danger" title="Balance could not be calculated for this account">—</span>
                                }
                                else
                                {
                                    @account.Balance?.ToString("C")
                                }
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="AccountBalance" Title="" Width="210px" Sortable="false">
                            <Template Context="account">
                                @if (!account.IsSystem && _editingId != account.AccountId)
                                {
                                    <button class="btn btn-outline-secondary btn-sm me-1"
                                            @onclick="() => StartRename(account)">
                                        Rename
                                    </button>
                                    <button class="btn btn-outline-danger btn-sm"
                                            @onclick="() => ArchiveAsync(account.AccountId)">
                                        Archive
                                    </button>
                                }
                                else if (account.IsSystem)
                                {
                                    <span class="text-muted small">Read-only</span>
                                }
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            }
        </section>

        <!-- Archived accounts -->
        @if (_archivedAccounts.Any())
        {
            <section aria-labelledby="archived-heading" class="mb-2">
                <h6 id="archived-heading" class="mb-1">Archived Accounts</h6>
                <RadzenDataGrid Data="@_archivedAccounts" TItem="AccountBalance"
                                AllowSorting="true" AllowPaging="true" PageSize="15"
                                class="rz-shadow-0">
                    <Columns>
                        <RadzenDataGridColumn TItem="AccountBalance" Title="No." Width="90px">
                            <Template Context="account">
                                <code>@account.AccountNumber</code>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="AccountBalance" Property="Name" Title="Name" />
                        <RadzenDataGridColumn TItem="AccountBalance" Property="Type" Title="Type" Width="120px" />
                        <RadzenDataGridColumn TItem="AccountBalance" Property="Balance" Title="Balance" Width="120px">
                            <Template Context="account">
                                @if (account.HasError)
                                {
                                    <span class="text-danger" title="Balance could not be calculated for this account">—</span>
                                }
                                else
                                {
                                    @account.Balance?.ToString("C")
                                }
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="AccountBalance" Title="Actions" Width="120px" Sortable="false">
                            <Template Context="account">
                                <button class="btn btn-outline-secondary btn-sm"
                                        @onclick="() => RestoreAsync(account.AccountId)">
                                    Restore
                                </button>
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            </section>
        }
    }
</div>
