@page "/finance"

<PageTitle>Finance — StageFright Community</PageTitle>

<div class="page-header mb-3">
    <h1 class="h3 mb-0">Finance</h1>
</div>

<div class="tab-container">
    <ul class="tab-strip" role="tablist" aria-label="Finance tabs">
        <li role="presentation">
            <button class="tab-button @(ActiveTab == "balances" ? "active" : "")"
                    role="tab"
                    id="tab-balances"
                    aria-selected="@(ActiveTab == "balances")"
                    aria-controls="tabpanel-balances"
                    @onclick='() => ActivateTab("balances")'>
                Balances
            </button>
        </li>
        <li role="presentation">
            <button class="tab-button @(ActiveTab == "payments" ? "active" : "")"
                    role="tab"
                    id="tab-payments"
                    aria-selected="@(ActiveTab == "payments")"
                    aria-controls="tabpanel-payments"
                    @onclick='() => ActivateTab("payments")'>
                Payments
            </button>
        </li>
        <li role="presentation">
            <button class="tab-button @(ActiveTab == "annual-fees" ? "active" : "")"
                    role="tab"
                    id="tab-annual-fees"
                    aria-selected="@(ActiveTab == "annual-fees")"
                    aria-controls="tabpanel-annual-fees"
                    @onclick='() => ActivateTab("annual-fees")'>
                Apply Annual Fees
            </button>
        </li>
    </ul>

    <div class="tab-panel @(ActiveTab == "balances" ? "active" : "")"
         id="tabpanel-balances"
         role="tabpanel"
         aria-labelledby="tab-balances"
         hidden="@(ActiveTab != "balances")">
        <MemberBalanceList />
    </div>

    <div class="tab-panel @(ActiveTab == "payments" ? "active" : "")"
         id="tabpanel-payments"
         role="tabpanel"
         aria-labelledby="tab-payments"
         hidden="@(ActiveTab != "payments")">
        <p class="text-muted">Select a member from the Balances tab to record a payment.</p>
    </div>

    <div class="tab-panel @(ActiveTab == "annual-fees" ? "active" : "")"
         id="tabpanel-annual-fees"
         role="tabpanel"
         aria-labelledby="tab-annual-fees"
         hidden="@(ActiveTab != "annual-fees")">
        <div class="mt-2">
            <a href="/finance/annual-fees" class="btn btn-primary">Go to Annual Fee Application</a>
        </div>
    </div>
</div>
