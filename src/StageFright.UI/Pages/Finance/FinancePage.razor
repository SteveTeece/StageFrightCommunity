@page "/finance"

<PageTitle>Finance — StageFright Community</PageTitle>

<div class="page-header mb-2">
    <h1 class="h3 mb-0">Finance</h1>
</div>

<Tabs DefaultActiveTabIndex="@DefaultTabIndex">
    <Tab Title="Balances" OnShown="@(() => NavToTab("balances"))">
        <Content>
            <div class="pt-2">
                <MemberBalanceList />
            </div>
        </Content>
    </Tab>
    <Tab Title="Record Member Payment" OnShown="@(() => NavToTab("record-payment"))">
        <Content>
            <div class="pt-2">
                @if (SelectedMemberId == Guid.Empty)
                {
                    <p class="text-muted small">Select a member from the Balances tab to record a payment.</p>
                }
                else
                {
                    <PaymentForm MemberId="@SelectedMemberId" />
                }
            </div>
        </Content>
    </Tab>
    <Tab Title="Record Income" OnShown="@(() => NavToTab("record-income"))">
        <Content>
            <div class="pt-2">
                <RecordIncome />
            </div>
        </Content>
    </Tab>
    <Tab Title="Apply Annual Fees" OnShown="@(() => NavToTab("annual-fees"))">
        <Content>
            <div class="pt-2">
                <a href="/finance/annual-fees" class="btn btn-primary btn-sm">Go to Annual Fee Application</a>
            </div>
        </Content>
    </Tab>
</Tabs>
