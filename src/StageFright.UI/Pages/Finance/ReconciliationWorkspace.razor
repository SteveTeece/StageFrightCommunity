@page "/finance/reconciliation/{Id:guid}"
@using StageFright.Core.Enums
@using StageFright.Core.Modules.Finance

<PageTitle>@L["Finance_Reconciliation_WorkspacePageTitle"]</PageTitle>

<div class="reconciliation-workspace container-fluid py-2">
    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-danger py-1 mb-2 small" role="alert">@_errorMessage</div>
    }

    @if (_loading)
    {
        <p role="status" aria-live="polite">@L["Finance_Reconciliation_WorkspaceLoadingText"]</p>
    }
    else if (_workspace is null)
    {
        <p class="text-muted">@((MarkupString)L["Finance_Reconciliation_NotFoundHtml"].Value)</p>
    }
    else
    {
        <div class="d-flex align-items-center justify-content-between mb-2">
            <h4 class="mb-0">
                @L["Finance_Reconciliation_ReconcilePrefix"]@_workspace.Account.Name
                <small class="text-muted">@ToDateText()</small>
            </h4>
            @if (IsFinalised)
            {
                <span class="badge bg-success fs-6">@ReconciliationStatus.Finalised.LocalizeEnum()</span>
            }
            else
            {
                <span class="badge bg-warning text-dark fs-6">@ReconciliationStatus.Draft.LocalizeEnum()</span>
            }
        </div>

        <div class="row g-2 mb-3">
            <div class="col-sm-3">
                <div class="card text-center">
                    <div class="card-body py-2">
                        <div class="small text-muted">@L["Finance_Reconciliation_ClosingBalanceLabel"]</div>
                        <div class="fs-5" id="summary-statement">@MoneyFormatter.Format(_workspace.Reconciliation.StatementClosingBalance)</div>
                    </div>
                </div>
            </div>
            <div class="col-sm-3">
                <div class="card text-center">
                    <div class="card-body py-2">
                        <div class="small text-muted">@L["Finance_Reconciliation_OpeningBalanceLabel"]</div>
                        <div class="fs-5" id="summary-opening">@MoneyFormatter.Format(_workspace.Reconciliation.OpeningBalance)</div>
                    </div>
                </div>
            </div>
            <div class="col-sm-3">
                <div class="card text-center">
                    <div class="card-body py-2">
                        <div class="small text-muted">@L["Finance_Reconciliation_ClearedLabel"]</div>
                        <div class="fs-5" id="summary-cleared">@MoneyFormatter.Format(_workspace.ClearedTotal)</div>
                    </div>
                </div>
            </div>
            <div class="col-sm-3">
                <div class="card text-center @(IsBalanced ? "border-success" : "border-danger")">
                    <div class="card-body py-2">
                        <div class="small text-muted">@L["Finance_Reconciliation_DifferenceLabel"]</div>
                        <div class="fs-5 @(IsBalanced ? "text-success" : "text-danger")" id="summary-difference">
                            @MoneyFormatter.Format(_workspace.Difference)
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @if (!_workspace.Transactions.Any())
        {
            <p class="text-muted">@L["Finance_Reconciliation_NoTransactions"]</p>
        }
        else
        {
            <RadzenDataGrid Data="@_workspace.Transactions" TItem="ReconciliationTransactionView"
                            AllowSorting="true" AllowPaging="true" PageSize="15"
                            class="rz-shadow-0">
                <Columns>
                    <RadzenDataGridColumn TItem="ReconciliationTransactionView" Title="@L["Finance_Reconciliation_ClearedColumn"]" Width="80px" Sortable="false">
                        <Template Context="line">
                            <input type="checkbox" class="form-check-input reconciliation-tick"
                                   checked="@line.IsCleared"
                                   disabled="@(IsFinalised || _busy)"
                                   aria-label="@L["Finance_Reconciliation_ClearedAriaLabel"]"
                                   @onchange="() => ToggleAsync(line.Transaction.Id)" />
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ReconciliationTransactionView" Title="@L["Finance_Reconciliation_DateColumn"]" Width="130px">
                        <Template Context="line">@line.Transaction.Date.ToString("d MMM yyyy")</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ReconciliationTransactionView" Title="@L["Finance_Common_DescriptionLabel"]">
                        <Template Context="line">@(line.Transaction.Description ?? "—")</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ReconciliationTransactionView" Title="@L["Finance_Reconciliation_DepositColumn"]" Width="120px">
                        <Template Context="line">
                            @(line.Transaction.DebitAmount != 0m ? MoneyFormatter.Format(line.Transaction.DebitAmount) : "")
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ReconciliationTransactionView" Title="@L["Finance_Reconciliation_PaymentColumn"]" Width="120px">
                        <Template Context="line">
                            @(line.Transaction.CreditAmount != 0m ? MoneyFormatter.Format(line.Transaction.CreditAmount) : "")
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        }

        @if (!IsFinalised)
        {
            <div class="d-flex gap-2 mt-3">
                <button class="btn btn-primary" id="finalise-button"
                        disabled="@(!IsBalanced || _busy)" @onclick="FinaliseAsync">
                    @L["Finance_Reconciliation_FinaliseButton"]
                </button>
                <button class="btn btn-outline-danger" id="delete-draft-button"
                        disabled="@_busy" @onclick="DeleteDraftAsync">
                    @L["Finance_Reconciliation_DeleteDraftButton"]
                </button>
                <a class="btn btn-outline-secondary ms-auto" href="/finance/reconciliation">@L["Finance_Reconciliation_BackButton"]</a>
            </div>
        }
        else
        {
            <div class="mt-3">
                <a class="btn btn-outline-secondary" href="/finance/reconciliation">@L["Finance_Reconciliation_BackButton"]</a>
            </div>
        }
    }
</div>
