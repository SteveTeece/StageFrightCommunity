@page "/finance/reconciliation"
@using StageFright.Core.Entities
@using StageFright.Core.Enums

<PageTitle>@L["Finance_Reconciliation_ListPageTitle"]</PageTitle>

<div class="reconciliation-list-page container-fluid py-2">
    <h4 class="mb-2">@L["Finance_Reconciliation_ListHeading"]</h4>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-danger py-1 mb-2 small" role="alert">@_errorMessage</div>
    }

    @if (_loading)
    {
        <p role="status" aria-live="polite">@Shared["Shared_Common_Loading"]</p>
    }
    else if (!_bankAccounts.Any())
    {
        <p class="text-muted">
            @((MarkupString)L["Finance_Reconciliation_NoAccountsHtml"].Value)
        </p>
    }
    else
    {
        <div class="d-flex align-items-center gap-2 mb-3">
            <label for="account-picker" class="form-label small mb-0">@L["Finance_Reconciliation_AccountLabel"]</label>
            <select id="account-picker" class="form-select form-select-sm w-auto"
                    value="@_selectedAccountId" @onchange="OnAccountChangedAsync"
                    aria-label="@L["Finance_Reconciliation_AccountAriaLabel"]">
                <option value="">@L["Finance_Reconciliation_SelectAccountOption"]</option>
                @foreach (var account in _bankAccounts)
                {
                    <option value="@account.Id">@account.AccountNumber — @account.Name</option>
                }
            </select>
        </div>

        @if (_selectedAccountId is not null)
        {
            @if (_draft is not null)
            {
                <div class="alert alert-info py-2 mb-3 d-flex align-items-center justify-content-between" role="status">
                    <span>@DraftInProgressText()</span>
                    <button class="btn btn-primary btn-sm" @onclick="ResumeDraft">@L["Finance_Reconciliation_ResumeDraftButton"]</button>
                </div>
            }
            else
            {
                <div class="card mb-3">
                    <div class="card-body py-2">
                        <h6 class="card-title mb-2">@L["Finance_Reconciliation_NewHeading"]</h6>
                        <EditForm Model="_startModel" OnValidSubmit="StartDraftAsync">
                            <DataAnnotationsValidator />
                            <div class="row g-2 align-items-start">
                                <div class="col-auto">
                                    <label for="statement-date" class="form-label small mb-0">@L["Finance_Reconciliation_StatementDateLabel"]</label>
                                    <InputDate id="statement-date" class="form-control form-control-sm"
                                               @bind-Value="_startModel.StatementDate" />
                                </div>
                                <div class="col-auto">
                                    <label for="closing-balance" class="form-label small mb-0">@L["Finance_Reconciliation_ClosingBalanceLabel"]</label>
                                    <InputNumber id="closing-balance" class="form-control form-control-sm"
                                                 @bind-Value="_startModel.StatementClosingBalance" />
                                </div>
                                <div class="col">
                                    <label for="rec-notes" class="form-label small mb-0">@L["Finance_Reconciliation_NotesLabel"]</label>
                                    <InputText id="rec-notes" class="form-control form-control-sm"
                                               @bind-Value="_startModel.Notes" />
                                </div>
                                <div class="col-auto d-flex align-items-end">
                                    <button type="submit" class="btn btn-primary btn-sm" disabled="@_starting">
                                        @(_starting ? L["Finance_Reconciliation_StartingText"] : L["Finance_Reconciliation_StartButton"])
                                    </button>
                                </div>
                            </div>
                        </EditForm>
                    </div>
                </div>
            }

            <section aria-labelledby="history-heading">
                <h6 id="history-heading" class="mb-1">@L["Finance_Reconciliation_HistoryHeading"]</h6>
                @if (!_history.Any())
                {
                    <p class="text-muted small mb-0">@L["Finance_Reconciliation_HistoryEmpty"]</p>
                }
                else
                {
                    <RadzenDataGrid Data="@_history" TItem="BankReconciliation"
                                    AllowSorting="true" AllowPaging="true" PageSize="15"
                                    class="rz-shadow-0">
                        <Columns>
                            <RadzenDataGridColumn TItem="BankReconciliation" Title="@L["Finance_Reconciliation_StatementDateColumn"]" Width="140px">
                                <Template Context="rec">@rec.StatementDate.ToString("d MMM yyyy")</Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="BankReconciliation" Title="@L["Finance_Reconciliation_OpeningColumn"]" Width="120px">
                                <Template Context="rec">@MoneyFormatter.Format(rec.OpeningBalance)</Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="BankReconciliation" Title="@L["Finance_Reconciliation_ClosingColumn"]" Width="120px">
                                <Template Context="rec">@MoneyFormatter.Format(rec.StatementClosingBalance)</Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="BankReconciliation" Title="@Shared["Shared_Table_StatusColumn"]" Width="110px">
                                <Template Context="rec">
                                    <span class="badge @(rec.Status == ReconciliationStatus.Finalised ? "bg-success" : "bg-warning text-dark")">@rec.Status.LocalizeEnum()</span>
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="BankReconciliation" Title="" Width="110px" Sortable="false">
                                <Template Context="rec">
                                    <button class="btn btn-outline-secondary btn-sm"
                                            @onclick="() => OpenWorkspace(rec.Id)">
                                        @(rec.Status == ReconciliationStatus.Draft ? L["Finance_Reconciliation_ResumeButton"] : L["Finance_Reconciliation_ViewButton"])
                                    </button>
                                </Template>
                            </RadzenDataGridColumn>
                        </Columns>
                    </RadzenDataGrid>
                }
            </section>
        }
    }
</div>
