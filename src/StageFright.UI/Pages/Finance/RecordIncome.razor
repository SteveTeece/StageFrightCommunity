@page "/finance/income/new"

<PageTitle>Record Income — StageFright Community</PageTitle>

<div class="page-header mb-3">
    <h1 class="h3 mb-0">Record Income</h1>
    <p class="text-muted mb-0">Record income from raffles, fundraising events, donations, and other sources.</p>
</div>

@if (_loading)
{
    <p role="status" aria-live="polite">Loading…</p>
}
else
{
    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-danger" role="alert">@_errorMessage</div>
    }

    @if (_successMessage is not null)
    {
        <div class="alert alert-success" role="status">
            @_successMessage
            <div class="mt-2">
                <button class="btn btn-sm btn-outline-success" @onclick="RecordAnother">Record Another</button>
                <a href="/finance" class="btn btn-sm btn-outline-secondary ms-2">Back to Finance</a>
            </div>
        </div>
    }

    @if (_successMessage is null)
    {
        @if (_categories.Count == 0)
        {
            <div class="alert alert-warning" role="alert">
                No income categories are configured. Please add an income category in
                <a href="/settings?tab=categories">Settings → Categories</a> before recording income.
            </div>
        }
        else
        {
            <div class="card" style="max-width: 540px;">
                <div class="card-body">
                    <EditForm Model="_form" OnValidSubmit="SaveAsync">
                        <div class="row g-3">

                            <div class="col-md-6">
                                <label class="form-label" for="incomeDate">Date <span aria-hidden="true">*</span></label>
                                <InputDate id="incomeDate" class="form-control" @bind-Value="_form.Date" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label" for="amount">Amount <span aria-hidden="true">*</span></label>
                                <div class="input-group @(_errors.ContainsKey("Amount") ? "has-validation" : "")">
                                    <span class="input-group-text">@System.Globalization.CultureInfo.CurrentCulture.NumberFormat.CurrencySymbol</span>
                                    <InputNumber id="amount"
                                                 class="@(_errors.ContainsKey("Amount") ? "form-control is-invalid" : "form-control")"
                                                 @bind-Value="_form.Amount"
                                                 @bind-Value:format="N2" />
                                    @if (_errors.TryGetValue("Amount", out var amtErr))
                                    {
                                        <div class="invalid-feedback">@amtErr</div>
                                    }
                                </div>
                            </div>

                            <div class="col-12">
                                <label class="form-label" for="category">Category <span aria-hidden="true">*</span></label>
                                <InputSelect id="category"
                                             class="@(_errors.ContainsKey("CategoryId") ? "form-select is-invalid" : "form-select")"
                                             @bind-Value="_form.CategoryId">
                                    <option value="@Guid.Empty">— select a category —</option>
                                    @foreach (var cat in _categories)
                                    {
                                        <option value="@cat.Id">@cat.Name</option>
                                    }
                                </InputSelect>
                                @if (_errors.TryGetValue("CategoryId", out var catErr))
                                {
                                    <div class="invalid-feedback d-block">@catErr</div>
                                }
                            </div>

                            <div class="col-12">
                                <label class="form-label" for="description">Description</label>
                                <InputTextArea id="description" class="form-control" rows="2"
                                               @bind-Value="_form.Description"
                                               placeholder="e.g. Christmas raffle, Annual fundraiser…" />
                            </div>

                        </div>

                        <div class="d-flex gap-2 mt-3">
                            <button type="submit" class="btn btn-primary" disabled="@_saving">
                                @(_saving ? "Saving…" : "Record Income")
                            </button>
                            <a href="/finance" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </EditForm>
                </div>
            </div>
        }
    }
}
