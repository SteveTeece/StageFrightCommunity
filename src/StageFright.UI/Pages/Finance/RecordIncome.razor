@if (_loading)
{
    <p role="status" aria-live="polite">@Shared["Shared_Common_Loading"]</p>
}
else
{
    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-danger py-1 mb-2 small" role="alert">@_errorMessage</div>
    }

    @if (_successMessage is not null)
    {
        <div class="alert alert-success py-1 mb-2 small" role="status">
            @_successMessage
            <div class="mt-1">
                <button class="btn btn-sm btn-outline-success" @onclick="RecordAnother">@L["Finance_Common_RecordAnotherButton"]</button>
            </div>
        </div>
    }

    @if (_successMessage is null)
    {
        @if (_accounts.Count == 0)
        {
            <div class="alert alert-warning py-1 mb-2 small" role="alert">
                @((MarkupString)L["Finance_RecordIncome_NoAccountsHtml"].Value)
            </div>
        }
        else
        {
            <div class="card mb-2">
                <div class="card-body py-2">
                    <EditForm Model="_form" OnValidSubmit="SaveAsync">
                        <div class="row g-2">

                            <div class="col-md-4">
                                <label class="form-label" for="incomeDate">@L["Finance_Common_DateLabel"] <span aria-hidden="true">*</span></label>
                                <InputDate id="incomeDate" class="form-control form-control-sm" @bind-Value="_form.Date" />
                            </div>

                            <div class="col-md-4">
                                <label class="form-label" for="amount">@L["Finance_Common_AmountLabel"] <span aria-hidden="true">*</span></label>
                                <div class="input-group input-group-sm @(_errors.ContainsKey("Amount") ? "has-validation" : "")">
                                    <span class="input-group-text">@System.Globalization.CultureInfo.CurrentCulture.NumberFormat.CurrencySymbol</span>
                                    <InputNumber id="amount"
                                                 class="@(_errors.ContainsKey("Amount") ? "form-control is-invalid" : "form-control")"
                                                 @bind-Value="_form.Amount"
                                                 @bind-Value:format="N2" />
                                    @if (_errors.TryGetValue("Amount", out var amtErr))
                                    {
                                        <div class="invalid-feedback">@amtErr</div>
                                    }
                                </div>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label" for="account">@L["Finance_RecordIncome_AccountLabel"] <span aria-hidden="true">*</span></label>
                                <InputSelect id="account"
                                             class="@(_errors.ContainsKey("AccountId") ? "form-select form-select-sm is-invalid" : "form-select form-select-sm")"
                                             @bind-Value="_form.AccountId">
                                    <option value="@Guid.Empty">@L["Finance_Common_SelectOption"]</option>
                                    @foreach (var cat in _accounts)
                                    {
                                        <option value="@cat.Id">@cat.Name</option>
                                    }
                                </InputSelect>
                                @if (_errors.TryGetValue("AccountId", out var catErr))
                                {
                                    <div class="invalid-feedback d-block">@catErr</div>
                                }
                            </div>

                            <div class="col-md-4">
                                <label class="form-label" for="depositAccount">@L["Finance_RecordIncome_DepositToLabel"]</label>
                                <InputSelect id="depositAccount" class="form-select form-select-sm"
                                             @bind-Value="_form.DepositAccountId">
                                    @foreach (var bank in _bankAccounts)
                                    {
                                        <option value="@bank.Id">@bank.AccountNumber @bank.Name</option>
                                    }
                                </InputSelect>
                            </div>

                            @if (_isTaxApplicable)
                            {
                                <div class="col-md-4">
                                    <label class="form-label" for="taxCode">@L["Finance_Common_TaxTreatmentLabel"]</label>
                                    <InputSelect id="taxCode" class="form-select form-select-sm" @bind-Value="_form.TaxCode">
                                        <option value="">@L["Finance_Common_TaxExemptDefaultOption"]</option>
                                        <option value="@StageFright.Core.Enums.TaxCode.Taxable">@StageFright.Core.Enums.TaxCode.Taxable.LocalizeEnum()</option>
                                        <option value="@StageFright.Core.Enums.TaxCode.TaxExempt">@StageFright.Core.Enums.TaxCode.TaxExempt.LocalizeEnum()</option>
                                    </InputSelect>
                                    @if (TaxInclusiveHint is not null)
                                    {
                                        <div class="form-text small">@TaxInclusiveHint</div>
                                    }
                                </div>
                            }

                            <div class="col-12">
                                <label class="form-label" for="description">@L["Finance_Common_DescriptionLabel"]</label>
                                <InputTextArea id="description" class="form-control form-control-sm" rows="2"
                                               @bind-Value="_form.Description"
                                               placeholder="@L["Finance_RecordIncome_DescriptionPlaceholder"]" />
                            </div>

                        </div>

                        <div class="d-flex gap-2 mt-2">
                            <button type="submit" class="btn btn-primary btn-sm" disabled="@_saving">
                                @(_saving ? Shared["Shared_Action_Saving"] : L["Finance_RecordIncome_SubmitButton"])
                            </button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="RecordAnother">@L["Finance_Common_ClearButton"]</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        }
    }
}
