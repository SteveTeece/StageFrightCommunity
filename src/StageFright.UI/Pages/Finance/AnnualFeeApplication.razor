@page "/finance/annual-fees"

<PageTitle>Apply Annual Fees — StageFright Community</PageTitle>

<div class="page-header mb-2">
    <h1 class="h3">Apply Annual Membership Fees</h1>
    <p class="text-muted mb-0 small">Apply the current year annual fee to all eligible active members.</p>
</div>

@if (_loading)
{
    <p role="status" aria-live="polite">Loading eligible members…</p>
}
else
{
    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-danger py-1 mb-2 small" role="alert">@_errorMessage</div>
    }

    @if (_successMessage is not null)
    {
        <div class="alert alert-success py-1 mb-2 small" role="status">@_successMessage</div>
        <a href="/finance" class="btn btn-outline-secondary btn-sm mt-1">Back to Finance</a>
    }
    else if (!_confirmed)
    {
        <div class="card mb-2">
            <div class="card-body py-2">
                <h6 class="card-title mb-2">Confirmation</h6>
                <p class="mb-1 small">
                    <strong>@_eligibleCount</strong> active @(_eligibleCount == 1 ? "member is" : "members are") eligible for an annual fee this year.
                </p>
                @if (_eligibleCount == 0)
                {
                    <p class="text-muted small mb-2">No eligible members found. Either all active members already have an annual fee for the current year, or there are no active members.</p>
                    <a href="/finance" class="btn btn-outline-secondary btn-sm">Back to Finance</a>
                }
                else
                {
                    <p class="text-muted small mb-2">Annual fee amount: <strong>@_annualFee.ToString("C")</strong></p>
                    <div class="d-flex gap-2">
                        <button class="btn btn-primary btn-sm" @onclick="ConfirmApply" disabled="@_applying">
                            Apply Annual Fees
                        </button>
                        <a href="/finance" class="btn btn-outline-secondary btn-sm">Cancel</a>
                    </div>
                }
            </div>
        </div>
    }
}
