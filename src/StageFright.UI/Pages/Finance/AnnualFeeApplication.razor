@page "/finance/annual-fees"

<PageTitle>@L["Finance_AnnualFees_PageTitle"]</PageTitle>

<div class="page-header mb-2">
    <h1 class="h3">@L["Finance_AnnualFees_Heading"]</h1>
    <p class="text-muted mb-0 small">@L["Finance_AnnualFees_Intro"]</p>
</div>

@if (_loading)
{
    <p role="status" aria-live="polite">@L["Finance_AnnualFees_LoadingText"]</p>
}
else
{
    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-danger py-1 mb-2 small" role="alert">@_errorMessage</div>
    }

    @if (_successMessage is not null)
    {
        <div class="alert alert-success py-1 mb-2 small" role="status">@_successMessage</div>
        <a href="/finance" class="btn btn-outline-secondary btn-sm mt-1">@L["Finance_AnnualFees_BackToFinanceButton"]</a>
    }
    else if (!_confirmed)
    {
        <div class="card mb-2">
            <div class="card-body py-2">
                <h6 class="card-title mb-2">@L["Finance_AnnualFees_ConfirmationHeading"]</h6>
                <p class="mb-1 small">@EligibleSummaryText()</p>
                @if (_eligibleCount == 0)
                {
                    <p class="text-muted small mb-2">@L["Finance_AnnualFees_NoneEligible"]</p>
                    <a href="/finance" class="btn btn-outline-secondary btn-sm">@L["Finance_AnnualFees_BackToFinanceButton"]</a>
                }
                else
                {
                    <p class="text-muted small mb-2">@L["Finance_AnnualFees_FeeAmountLabel"] <strong>@MoneyFormatter.Format(_annualFee)</strong></p>
                    <div class="d-flex gap-2">
                        <button class="btn btn-primary btn-sm" @onclick="ConfirmApply" disabled="@_applying">
                            @L["Finance_AnnualFees_ApplyButton"]
                        </button>
                        <a href="/finance" class="btn btn-outline-secondary btn-sm">@Shared["Shared_Action_Cancel"]</a>
                    </div>
                }
            </div>
        </div>
    }
}
