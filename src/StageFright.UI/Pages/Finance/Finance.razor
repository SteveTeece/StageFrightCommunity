@page "/finance"
@layout MainLayout

<div class="finance-module">
    <div class="module-header">
        <h1>Finance</h1>
    </div>

    <div class="tabs">
        <button class="tab-button @(ActiveTab == "payments" ? "active" : "")" @onclick='() => ActiveTab = "payments"'>
            Payments
        </button>
        <button class="tab-button @(ActiveTab == "balances" ? "active" : "")" @onclick='() => ActiveTab = "balances"'>
            Member Balances
        </button>
        <button class="tab-button @(ActiveTab == "categories" ? "active" : "")" @onclick='() => ActiveTab = "categories"'>
            Categories
        </button>
        <button class="tab-button @(ActiveTab == "annualfee" ? "active" : "")" @onclick='() => ActiveTab = "annualfee"'>
            Annual Fee Application
        </button>
    </div>

    <div class="tab-content">
        @if (ActiveTab == "payments")
        {
            <PaymentRecordingForm OnPaymentRecorded="HandlePaymentRecorded" OnCancel="HandleFormCancel" />
        }
        else if (ActiveTab == "balances")
        {
            <MemberBalanceViewer />
        }
        else if (ActiveTab == "categories")
        {
            <CategoryManagement />
        }
        else if (ActiveTab == "annualfee")
        {
            @if (ShowingAnnualFeeDialog)
            {
                <AnnualFeeApplicationDialog OnFeesApplied="HandleFeesApplied" OnCancel="HandleAnnualFeeCancel" />
            }
            else
            {
                <div class="annual-fee-section">
                    <p>Click the button below to apply annual fees to all eligible members.</p>
                    <button class="btn btn-primary" @onclick="() => ShowingAnnualFeeDialog = true">Apply Annual Fees</button>
                </div>
            }
        }
    </div>
</div>

<style>
    .finance-module {
        padding: 20px;
    }

    .module-header {
        margin-bottom: 20px;
    }

    .module-header h1 {
        margin: 0 0 20px 0;
    }

    .tabs {
        display: flex;
        gap: 10px;
        border-bottom: 2px solid var(--color-border);
        margin-bottom: 20px;
        flex-wrap: wrap;
    }

    .tab-button {
        padding: 12px 20px;
        border: none;
        background: none;
        cursor: pointer;
        font-size: 16px;
        font-weight: 500;
        color: var(--color-text-muted);
        border-bottom: 3px solid transparent;
        transition: all 0.2s;
        margin-bottom: -2px;
    }

    .tab-button:hover {
        color: var(--color-text);
    }

    .tab-button.active {
        color: var(--color-primary);
        border-bottom-color: var(--color-primary);
    }

    .tab-content {
        background-color: var(--color-background);
        padding: 20px;
        border-radius: 4px;
        min-height: 400px;
    }

    .annual-fee-section {
        padding: 40px;
        text-align: center;
    }

    .annual-fee-section p {
        font-size: 16px;
        margin-bottom: 20px;
        color: var(--color-text);
    }

    .btn {
        padding: 10px 20px;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        font-size: 14px;
        font-weight: 500;
        transition: background-color 0.2s;
    }

    .btn-primary {
        background-color: var(--color-primary);
        color: white;
    }

    .btn-primary:hover {
        background-color: var(--color-primary-hover);
    }
</style>
