@page "/startup-error"
@using StageFright.Core.Contracts

<div class="container mt-5">
    <div class="alert alert-danger" role="alert">
        <h4 class="alert-heading">@L["Shared_StartupError_Heading"]</h4>
        <p>
            @L["Shared_StartupError_Body"]
        </p>
        @if (!string.IsNullOrEmpty(_errorDetail))
        {
            <hr />
            <p class="mb-0 text-muted small">@_errorDetail</p>
        }
    </div>

    @if (!string.IsNullOrEmpty(_dbPath))
    {
        <p class="text-muted small">@L["Shared_StartupError_DbLocationLabel"] <code>@_dbPath</code></p>
    }

    <div class="d-flex gap-2 mt-3">
        @if (!string.IsNullOrEmpty(_dbPath))
        {
            <button class="btn btn-outline-secondary" type="button" @onclick="OpenFolderAsync">
                @L["Shared_StartupError_OpenFolderButton"]
            </button>
            <button class="btn btn-warning" type="button" @onclick="RecreateAsync" disabled="@_recreating">
                @(_recreating ? L["Shared_StartupError_RecreatingText"] : L["Shared_StartupError_RecreateButton"])
            </button>
        }
    </div>

    @if (!string.IsNullOrEmpty(_actionError))
    {
        <div class="alert alert-warning mt-3" role="alert">@_actionError</div>
    }
</div>
