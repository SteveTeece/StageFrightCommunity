@using StageFright.Data.Repositories
@using StageFright.Core.Entities

<div class="categories-tab">
    <div class="tab-header">
        <h2>Manage Categories</h2>
        <button class="btn btn-primary" @onclick="ShowCreateForm">Add Category</button>
    </div>

    @if (IsLoading)
    {
        <div class="loading">Loading categories...</div>
    }
    else if (ErrorMessage != null)
    {
        <div class="error-message">@ErrorMessage</div>
    }
    else
    {
        @if (ShowForm)
        {
            <div class="form-section">
                <h3>@(EditingCategory == null ? "Add New Category" : "Edit Category")</h3>
                <form @onsubmit="SaveCategory">
                    <div class="form-group">
                        <label for="catName">Name:</label>
                        <input id="catName" type="text" class="form-control" @bind="FormName" required />
                    </div>

                    <div class="form-group">
                        <label for="catType">Type:</label>
                        <select id="catType" class="form-control" @bind="FormType" required>
                            <option value="Income">Income</option>
                            <option value="Expense">Expense</option>
                        </select>
                    </div>

                    <div class="form-buttons">
                        <button type="submit" class="btn btn-primary">Save</button>
                        <button type="button" class="btn btn-secondary" @onclick="CancelForm">Cancel</button>
                    </div>
                </form>
            </div>
        }

        <div class="categories-list">
            <h3>Income Categories</h3>
            <table class="table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>GL Account</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var cat in IncomeCategories)
                    {
                        <tr>
                            <td>@cat.Name</td>
                            <td>@cat.GlAccount</td>
                            <td>
                                <button class="btn btn-sm btn-secondary" @onclick="() => EditCategory(cat)">Edit</button>
                                @if (cat.IsArchived)
                                {
                                    <button class="btn btn-sm btn-success" @onclick="() => RestoreCategory(cat.Id)">Restore</button>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-danger" @onclick="() => ArchiveCategory(cat.Id)">Archive</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <h3>Expense Categories</h3>
            <table class="table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>GL Account</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var cat in ExpenseCategories)
                    {
                        <tr>
                            <td>@cat.Name</td>
                            <td>@cat.GlAccount</td>
                            <td>
                                <button class="btn btn-sm btn-secondary" @onclick="() => EditCategory(cat)">Edit</button>
                                @if (cat.IsArchived)
                                {
                                    <button class="btn btn-sm btn-success" @onclick="() => RestoreCategory(cat.Id)">Restore</button>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-danger" @onclick="() => ArchiveCategory(cat.Id)">Archive</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
