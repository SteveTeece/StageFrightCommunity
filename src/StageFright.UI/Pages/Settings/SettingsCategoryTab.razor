@using StageFright.Core.Enums
@using StageFright.Core.Entities

<div class="category-settings-tab">

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-danger py-1 mb-2 small" role="alert">@_errorMessage</div>
    }

    @if (!string.IsNullOrEmpty(_successMessage))
    {
        <div class="alert alert-success py-1 mb-2 small" role="status">@_successMessage</div>
    }

    @if (_loading)
    {
        <p role="status" aria-live="polite">Loading categories…</p>
    }
    else
    {
        <!-- Add Category Form — full width, single-row inline layout -->
        <div class="card mb-2">
            <div class="card-body py-2">
                <h6 class="card-title mb-2">Add Category</h6>
                <EditForm Model="_newCategoryModel" OnValidSubmit="HandleCreateAsync">
                    <DataAnnotationsValidator />
                    <div class="row g-2 align-items-start">
                        <div class="col">
                            <InputText id="cat-name" class="form-control form-control-sm"
                                       @bind-Value="_newCategoryModel.Name"
                                       placeholder="Category name"
                                       aria-label="Category name" />
                            <ValidationMessage For="() => _newCategoryModel.Name" class="text-danger small" />
                        </div>
                        <div class="col-auto">
                            <InputSelect id="cat-type" class="form-select form-select-sm"
                                         @bind-Value="_newCategoryModel.Type"
                                         aria-label="Category type">
                                <option value="@CategoryType.Income">Income</option>
                                <option value="@CategoryType.Expense">Expense</option>
                            </InputSelect>
                        </div>
                        <div class="col-auto">
                            <button type="submit" class="btn btn-primary btn-sm" disabled="@_creating">
                                @(_creating ? "Creating…" : "Add Category")
                            </button>
                        </div>
                    </div>
                </EditForm>
            </div>
        </div>

        <!-- Income and Expense columns side by side -->
        <div class="row g-2 mb-2">

            <!-- Income Categories -->
            <div class="col-xl-6 col-12">
                <section aria-labelledby="income-heading">
                    <h6 id="income-heading" class="mb-1">Income Categories</h6>
                    @if (!_incomeCategories.Any())
                    {
                        <p class="text-muted small mb-0">No income categories defined yet.</p>
                    }
                    else
                    {
                        <RadzenDataGrid Data="@_incomeCategories" TItem="Category"
                                        AllowSorting="false" AllowPaging="true" PageSize="10"
                                        class="rz-shadow-0">
                            <Columns>
                                <RadzenDataGridColumn TItem="Category" Title="Name">
                                    <Template Context="cat">
                                        @cat.Name
                                        @if (cat.IsSystem)
                                        {
                                            <span class="badge bg-secondary ms-1" title="System category">System</span>
                                        }
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="Category" Title="GL" Width="80px">
                                    <Template Context="cat">
                                        <code>@cat.GLAccount</code>
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="Category" Title="Order" Width="88px" Sortable="false">
                                    <Template Context="cat">
                                        @if (!cat.IsSystem)
                                        {
                                            <button class="btn btn-outline-secondary btn-sm me-1"
                                                    @onclick="() => MoveUpAsync(cat, _incomeCategories)"
                                                    title="Move up" aria-label="Move @cat.Name up">▲</button>
                                            <button class="btn btn-outline-secondary btn-sm"
                                                    @onclick="() => MoveDownAsync(cat, _incomeCategories)"
                                                    title="Move down" aria-label="Move @cat.Name down">▼</button>
                                        }
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="Category" Title="" Width="95px" Sortable="false">
                                    <Template Context="cat">
                                        @if (!cat.IsSystem)
                                        {
                                            <button class="btn btn-outline-danger btn-sm"
                                                    @onclick="() => ArchiveAsync(cat.Id)">
                                                Archive
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">Read-only</span>
                                        }
                                    </Template>
                                </RadzenDataGridColumn>
                            </Columns>
                        </RadzenDataGrid>
                    }
                </section>
            </div>

            <!-- Expense Categories -->
            <div class="col-xl-6 col-12">
                <section aria-labelledby="expense-heading">
                    <h6 id="expense-heading" class="mb-1">Expense Categories</h6>
                    @if (!_expenseCategories.Any())
                    {
                        <p class="text-muted small mb-0">No expense categories defined yet.</p>
                    }
                    else
                    {
                        <RadzenDataGrid Data="@_expenseCategories" TItem="Category"
                                        AllowSorting="false" AllowPaging="true" PageSize="10"
                                        class="rz-shadow-0">
                            <Columns>
                                <RadzenDataGridColumn TItem="Category" Title="Name">
                                    <Template Context="cat">
                                        @cat.Name
                                        @if (cat.IsSystem)
                                        {
                                            <span class="badge bg-secondary ms-1" title="System category">System</span>
                                        }
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="Category" Title="GL" Width="80px">
                                    <Template Context="cat">
                                        <code>@cat.GLAccount</code>
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="Category" Title="Order" Width="88px" Sortable="false">
                                    <Template Context="cat">
                                        @if (!cat.IsSystem)
                                        {
                                            <button class="btn btn-outline-secondary btn-sm me-1"
                                                    @onclick="() => MoveUpAsync(cat, _expenseCategories)"
                                                    title="Move up" aria-label="Move @cat.Name up">▲</button>
                                            <button class="btn btn-outline-secondary btn-sm"
                                                    @onclick="() => MoveDownAsync(cat, _expenseCategories)"
                                                    title="Move down" aria-label="Move @cat.Name down">▼</button>
                                        }
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="Category" Title="" Width="95px" Sortable="false">
                                    <Template Context="cat">
                                        @if (!cat.IsSystem)
                                        {
                                            <button class="btn btn-outline-danger btn-sm"
                                                    @onclick="() => ArchiveAsync(cat.Id)">
                                                Archive
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">Read-only</span>
                                        }
                                    </Template>
                                </RadzenDataGridColumn>
                            </Columns>
                        </RadzenDataGrid>
                    }
                </section>
            </div>

        </div>

        <!-- Archived Categories -->
        @if (_archivedCategories.Any())
        {
            <section aria-labelledby="archived-heading" class="mb-2">
                <h6 id="archived-heading" class="mb-1">Archived Categories</h6>
                <RadzenDataGrid Data="@_archivedCategories" TItem="Category"
                                AllowSorting="true" AllowPaging="true" PageSize="10"
                                class="rz-shadow-0">
                    <Columns>
                        <RadzenDataGridColumn TItem="Category" Property="Name" Title="Name" Width="160px" />
                        <RadzenDataGridColumn TItem="Category" Property="Type" Title="Type" Width="140px" />
                        <RadzenDataGridColumn TItem="Category" Title="GL Account" Width="140px">
                            <Template Context="cat">
                                <code>@cat.GLAccount</code>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="Category" Title="Actions" Width="140px" Sortable="false">
                            <Template Context="cat">
                                <button class="btn btn-outline-secondary btn-sm"
                                        @onclick="() => RestoreAsync(cat.Id)">
                                    Restore
                                </button>
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            </section>
        }
    }
</div>
