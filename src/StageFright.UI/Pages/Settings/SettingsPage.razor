@page "/settings"

<PageTitle>Settings — StageFright Community</PageTitle>

<div class="settings-page">
    <h1>Settings</h1>

    <Tabs DefaultActiveTabIndex="@DefaultTabIndex">
        <Tab Title="General" OnShown="OnGeneralShown">
            <Content>
                <div class="pt-3">
                    @if (GeneralShown)
                    {
                        <ErrorBoundary>
                            <ChildContent><GeneralSettingsTab /></ChildContent>
                            <ErrorContent><div class="alert alert-danger">This tab failed to load.</div></ErrorContent>
                        </ErrorBoundary>
                    }
                </div>
            </Content>
        </Tab>
        <Tab Title="Categories" OnShown="OnCategoriesShown">
            <Content>
                <div class="pt-3">
                    @if (CategoriesShown)
                    {
                        <ErrorBoundary>
                            <ChildContent><SettingsCategoryTab /></ChildContent>
                            <ErrorContent><div class="alert alert-danger">This tab failed to load.</div></ErrorContent>
                        </ErrorBoundary>
                    }
                </div>
            </Content>
        </Tab>
        <Tab Title="Event Types" OnShown="OnEventTypesShown">
            <Content>
                <div class="pt-3">
                    @if (EventTypesShown)
                    {
                        <ErrorBoundary>
                            <ChildContent><EventTypesTab /></ChildContent>
                            <ErrorContent><div class="alert alert-danger">This tab failed to load.</div></ErrorContent>
                        </ErrorBoundary>
                    }
                </div>
            </Content>
        </Tab>
        <Tab Title="Backup &amp; Restore" OnShown="OnBackupShown">
            <Content>
                <div class="pt-3">
                    @if (BackupShown)
                    {
                        <ErrorBoundary>
                            <ChildContent><BackupRestoreTab /></ChildContent>
                            <ErrorContent><div class="alert alert-danger">This tab failed to load.</div></ErrorContent>
                        </ErrorBoundary>
                    }
                </div>
            </Content>
        </Tab>
        @foreach (var tab in PluginTabs)
        {
            var key = tab.TabKey;
            <Tab Title="@tab.TabTitle" OnShown="@(() => NavToTab(key))">
                <Content>
                    <ErrorBoundary>
                        <ChildContent><DynamicComponent Type="tab.SettingsComponentType" /></ChildContent>
                        <ErrorContent><div class="alert alert-warning">This settings tab failed to load.</div></ErrorContent>
                    </ErrorBoundary>
                </Content>
            </Tab>
        }
    </Tabs>
</div>
