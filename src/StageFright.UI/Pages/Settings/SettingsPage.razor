@page "/settings"
@using Microsoft.AspNetCore.Components.Web
@inject NavigationManager Nav
@inject IEnumerable<ISettingsTabProvider> TabProviders

<PageTitle>Settings — StageFright Community</PageTitle>

<div class="settings-page">
    <h1>Settings</h1>

    <Tabs DefaultActiveTabIndex="@DefaultTabIndex">
        @foreach (var tab in OrderedTabs)
        {
            var tabKey = tab.TabKey;
            <Tab Title="@tab.TabTitle" OnShown="@(() => NavToTab(tabKey))">
                <Content>
                    @try
                    {
                        <DynamicComponent Type="tab.SettingsComponentType" />
                    }
                    catch (Exception)
                    {
                        <div class="alert alert-warning">This settings tab failed to load.</div>
                    }
                </Content>
            </Tab>
        }
    </Tabs>
</div>
