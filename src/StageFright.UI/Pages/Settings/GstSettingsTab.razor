@using StageFright.Core.Entities
@using StageFright.Core.Enums
@using AppSettings = StageFright.Core.Entities.Settings

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="alert alert-danger py-1 mb-2 small" role="alert">@_errorMessage</div>
}

@if (!string.IsNullOrEmpty(_successMessage))
{
    <div class="alert alert-success py-1 mb-2 small" role="status">@_successMessage</div>
}

@if (_settings is null)
{
    <p role="status">Loading settings…</p>
}
else
{
    var s = _settings;

    <EditForm Model="s" OnValidSubmit="HandleSaveAsync">
        <DataAnnotationsValidator />

        <div class="mb-2">
            <label class="form-label">GST / BAS</label>
            <div class="form-check">
                <input type="checkbox" class="form-check-input" id="gstRegistered"
                       checked="@s.IsGstRegistered"
                       disabled="@(_pendingGstToggle is not null)"
                       @onchange="HandleGstToggleRequested" />
                <label class="form-check-label small" for="gstRegistered">
                    Organisation is registered for GST
                </label>
            </div>

            @if (_pendingGstToggle is not null)
            {
                <div class="alert alert-warning py-1 mb-2 small" role="alert" id="gst-toggle-confirm">
                    @if (_pendingGstToggle == true)
                    {
                        <span><strong>Confirm:</strong> future income and expense postings will split out GST, and BAS reporting will be enabled.</span>
                    }
                    else
                    {
                        <span><strong>Confirm:</strong> GST fields will be hidden and future postings will no longer carry a GST code.</span>
                    }
                    <div class="mt-1">
                        <button type="button" class="btn btn-sm btn-warning" id="gst-toggle-confirm-btn" @onclick="ConfirmGstToggle">Confirm</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary ms-1" @onclick="CancelGstToggle">Cancel</button>
                    </div>
                </div>
            }

            @if (s.IsGstRegistered)
            {
                <div class="row g-2 mb-2">
                    <div class="col-md-6">
                        <label for="annualFeeGstCode" class="form-label">Annual Fee GST Treatment</label>
                        <InputSelect id="annualFeeGstCode" class="form-select form-select-sm" @bind-Value="s.AnnualFeeGstCode">
                            <option value="">GST-free (default)</option>
                            <option value="@GstCode.Gst">Taxable (GST)</option>
                            <option value="@GstCode.GstFree">GST-free</option>
                            <option value="@GstCode.InputTaxed">Input-taxed</option>
                        </InputSelect>
                    </div>
                    <div class="col-md-6">
                        <label for="attendanceFeeGstCode" class="form-label">Attendance Fee GST Treatment</label>
                        <InputSelect id="attendanceFeeGstCode" class="form-select form-select-sm" @bind-Value="s.AttendanceFeeGstCode">
                            <option value="">GST-free (default)</option>
                            <option value="@GstCode.Gst">Taxable (GST)</option>
                            <option value="@GstCode.GstFree">GST-free</option>
                            <option value="@GstCode.InputTaxed">Input-taxed</option>
                        </InputSelect>
                    </div>
                </div>
            }
        </div>

        <div class="d-flex gap-2 mt-3">
            <button type="submit" class="btn btn-primary btn-sm" disabled="@_saving">
                @(_saving ? "Saving…" : "Save Settings")
            </button>
        </div>
    </EditForm>
}
