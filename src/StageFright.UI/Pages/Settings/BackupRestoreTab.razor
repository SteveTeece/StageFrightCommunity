@using StageFright.Core.Modules.Settings.Backup

<div class="backup-restore-tab">

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-danger py-1 mb-2 small" role="alert">@_errorMessage</div>
    }

    @if (!string.IsNullOrEmpty(_successMessage))
    {
        <div class="alert alert-success py-1 mb-2 small" role="status">@_successMessage</div>
    }

    <section aria-labelledby="backup-heading" class="mb-3">
        <h6 id="backup-heading" class="mb-1">@L["Settings_Backup_Heading"]</h6>
        <p class="text-muted small">
            @L["Settings_Backup_Description"]
        </p>
        <button class="btn btn-primary btn-sm" @onclick="HandleBackupAsync" disabled="@_busy">
            @(_busy && _operation == "backup" ? L["Settings_Backup_CreatingText"] : L["Settings_Backup_CreateButton"])
        </button>
    </section>

    <section aria-labelledby="restore-heading">
        <h6 id="restore-heading" class="mb-1">@L["Settings_Restore_Heading"]</h6>
        <p class="text-muted small">
            @L["Settings_Restore_Description"]
        </p>
        <div class="mb-2">
            <label for="restore-file" class="form-label">@L["Settings_Restore_SelectFileLabel"]</label>
            <InputFile id="restore-file" class="form-control form-control-sm" OnChange="OnFileSelected" accept=".sfbak" disabled="@_busy" />
        </div>

        @if (_selectedFile is not null && _manifest is not null)
        {
            <div class="card mb-2">
                <div class="card-body py-2">
                    <h6 class="card-title mb-2">@L["Settings_Restore_DetailsHeading"]</h6>
                    <dl class="row mb-0">
                        <dt class="col-sm-5">@L["Settings_Restore_GeneratedTerm"]</dt>
                        <dd class="col-sm-7">@_manifest.GeneratedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</dd>
                        <dt class="col-sm-5">@L["Settings_Restore_SchemaVersionTerm"]</dt>
                        <dd class="col-sm-7"><code>@_manifest.SchemaVersion</code></dd>
                        @foreach (var kv in _manifest.EntityCounts.Where(kv => kv.Value > 0))
                        {
                            <dt class="col-sm-5">@kv.Key</dt>
                            <dd class="col-sm-7">@kv.Value</dd>
                        }
                    </dl>
                </div>
            </div>

            @if (!_confirmed)
            {
                <div class="alert alert-warning py-1 mb-2 small" role="alert">
                    @L["Settings_Restore_Warning"]
                </div>
                <button class="btn btn-warning btn-sm" @onclick="ConfirmRestore" disabled="@_busy">
                    @L["Settings_Restore_UnderstandButton"]
                </button>
            }
            else
            {
                <button class="btn btn-danger btn-sm" @onclick="HandleRestoreAsync" disabled="@_busy">
                    @(_busy && _operation == "restore" ? L["Settings_Restore_RestoringText"] : L["Settings_Restore_ConfirmButton"])
                </button>
                <button class="btn btn-secondary btn-sm ms-2" @onclick="CancelRestore" disabled="@_busy">@Shared["Shared_Action_Cancel"]</button>
            }
        }
    </section>
</div>
