@using StageFright.Core.Modules.Settings.Backup

<div class="backup-restore-tab">

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-danger" role="alert">@_errorMessage</div>
    }

    @if (!string.IsNullOrEmpty(_successMessage))
    {
        <div class="alert alert-success" role="status">@_successMessage</div>
    }

    <section aria-labelledby="backup-heading" class="mb-5">
        <h5 id="backup-heading">Backup</h5>
        <p class="text-muted small">
            Creates a complete backup of all data (including archived records) in a <code>.sfbak</code> file.
        </p>
        <button class="btn btn-primary" @onclick="HandleBackupAsync" disabled="@_busy">
            @(_busy && _operation == "backup" ? "Creating backup…" : "Create Backup")
        </button>
    </section>

    <section aria-labelledby="restore-heading">
        <h5 id="restore-heading">Restore</h5>
        <p class="text-muted small">
            Restores data from a <code>.sfbak</code> file. A checkpoint of the current database is created
            automatically before any data is changed.
        </p>
        <div class="mb-3" style="max-width: 480px;">
            <label for="restore-file" class="form-label">Select backup file</label>
            <InputFile id="restore-file" class="form-control" OnChange="OnFileSelected" accept=".sfbak" disabled="@_busy" />
        </div>

        @if (_selectedFile is not null && _manifest is not null)
        {
            <div class="card mb-3" style="max-width: 480px;">
                <div class="card-body">
                    <h6 class="card-title">Backup details</h6>
                    <dl class="row mb-0">
                        <dt class="col-sm-5">Generated</dt>
                        <dd class="col-sm-7">@_manifest.GeneratedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</dd>
                        <dt class="col-sm-5">Schema version</dt>
                        <dd class="col-sm-7"><code>@_manifest.SchemaVersion</code></dd>
                        @foreach (var kv in _manifest.EntityCounts.Where(kv => kv.Value > 0))
                        {
                            <dt class="col-sm-5">@kv.Key</dt>
                            <dd class="col-sm-7">@kv.Value</dd>
                        }
                    </dl>
                </div>
            </div>

            @if (!_confirmed)
            {
                <div class="alert alert-warning" role="alert">
                    <strong>Warning:</strong> Restoring will overwrite data with the backup's records.
                    A checkpoint of the current database will be saved in the same folder before any changes are made.
                </div>
                <button class="btn btn-warning" @onclick="ConfirmRestore" disabled="@_busy">
                    I understand — Restore from this backup
                </button>
            }
            else
            {
                <button class="btn btn-danger" @onclick="HandleRestoreAsync" disabled="@_busy">
                    @(_busy && _operation == "restore" ? "Restoring…" : "Confirm Restore")
                </button>
                <button class="btn btn-secondary ms-2" @onclick="CancelRestore" disabled="@_busy">Cancel</button>
            }
        }
    </section>
</div>
