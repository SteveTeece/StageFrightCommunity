@using StageFright.Data.Repositories
@using StageFright.Core.Entities

<div class="event-types-tab">
    <div class="tab-header">
        <h2>Event Types</h2>
    </div>

    @if (IsLoading)
    {
        <div class="loading">Loading event types...</div>
    }
    else
    {
        <div class="event-types-list">
            <p>Default Event Types:</p>
            <ul>
                <li>Performance</li>
                <li>Eisteddfod</li>
                <li>Fund raiser</li>
                <li>Promotional</li>
                <li>Annual General Meeting</li>
            </ul>
            <p><em>Event types can be customized through category management.</em></p>
        </div>
    }
</div>
