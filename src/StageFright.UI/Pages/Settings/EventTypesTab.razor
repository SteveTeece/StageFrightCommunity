@using StageFright.Core.Entities

<div class="event-types-settings-tab">

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-danger py-1 mb-2 small" role="alert">@_errorMessage</div>
    }

    @if (!string.IsNullOrEmpty(_successMessage))
    {
        <div class="alert alert-success py-1 mb-2 small" role="status">@_successMessage</div>
    }

    @if (_loading)
    {
        <p role="status" aria-live="polite">@L["Settings_EventTypes_LoadingText"]</p>
    }
    else
    {
        <!-- Add Event Type Form — full width, single-row inline layout -->
        <div class="card mb-2">
            <div class="card-body py-2">
                <h6 class="card-title mb-2">@L["Settings_EventTypes_AddHeading"]</h6>
                <EditForm Model="_newModel" OnValidSubmit="HandleCreateAsync">
                    <DataAnnotationsValidator />
                    <div class="row g-2 align-items-start">
                        <div class="col">
                            <InputText id="et-name" class="form-control form-control-sm"
                                       @bind-Value="_newModel.Name"
                                       placeholder="@L["Settings_EventTypes_NamePlaceholder"]"
                                       aria-label="@L["Settings_EventTypes_NamePlaceholder"]" />
                            <ValidationMessage For="() => _newModel.Name" class="text-danger small" />
                        </div>
                        <div class="col-auto">
                            <button type="submit" class="btn btn-primary btn-sm" disabled="@_creating">
                                @(_creating ? L["Settings_EventTypes_CreatingText"] : L["Settings_EventTypes_AddButton"])
                            </button>
                        </div>
                    </div>
                </EditForm>
            </div>
        </div>

        <!-- Active Event Types -->
        <section aria-labelledby="active-et-heading" class="mb-2">
            <h6 id="active-et-heading" class="mb-1">@L["Settings_EventTypes_ActiveHeading"]</h6>
            @if (!_activeTypes.Any())
            {
                <p class="text-muted small mb-0">@L["Settings_EventTypes_NoneDefined"]</p>
            }
            else
            {
                <RadzenDataGrid Data="@_activeTypes" TItem="EventType"
                                AllowSorting="true" AllowPaging="true" PageSize="10"
                                class="rz-shadow-0">
                    <Columns>
                        <RadzenDataGridColumn TItem="EventType" Property="Name" Title="@L["Settings_EventTypes_NameColumn"]" Width="300px">
                            <Template Context="et">
                                @et.Name
                                @if (et.IsSystemDefault)
                                {
                                    <span class="badge bg-secondary ms-1" title="@L["Settings_EventTypes_SystemBadge"]">@L["Settings_EventTypes_SystemBadge"]</span>
                                }
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="EventType" Title="@Shared["Shared_Table_ActionsColumn"]" Width="140px" Sortable="false">
                            <Template Context="et">
                                @if (!et.IsSystemDefault)
                                {
                                    <button class="btn btn-outline-danger btn-sm"
                                            @onclick="() => ArchiveAsync(et.Id)"
                                            aria-label="@ArchiveAriaLabel(et.Name)">
                                        @L["Settings_EventTypes_ArchiveButton"]
                                    </button>
                                }
                                else
                                {
                                    <span class="text-muted small">@L["Settings_EventTypes_ReadOnlyText"]</span>
                                }
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            }
        </section>

        <!-- Archived Event Types -->
        @if (_archivedTypes.Any())
        {
            <section aria-labelledby="archived-et-heading" class="mb-2">
                <h6 id="archived-et-heading" class="mb-1">@L["Settings_EventTypes_ArchivedHeading"]</h6>
                <RadzenDataGrid Data="@_archivedTypes" TItem="EventType"
                                AllowSorting="true" AllowPaging="true" PageSize="15"
                                class="rz-shadow-0">
                    <Columns>
                        <RadzenDataGridColumn TItem="EventType" Property="Name" Title="@L["Settings_EventTypes_NameColumn"]" Width="300px" />
                        <RadzenDataGridColumn TItem="EventType" Title="@Shared["Shared_Table_ActionsColumn"]" Width="140px" Sortable="false">
                            <Template Context="et">
                                <button class="btn btn-outline-secondary btn-sm"
                                        @onclick="() => RestoreAsync(et.Id)"
                                        aria-label="@RestoreAriaLabel(et.Name)">
                                    @L["Settings_EventTypes_RestoreButton"]
                                </button>
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            </section>
        }
    }
</div>
