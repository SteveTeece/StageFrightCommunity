@using StageFright.Core.Entities

<div class="event-types-settings-tab">

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-danger py-1 mb-2 small" role="alert">@_errorMessage</div>
    }

    @if (!string.IsNullOrEmpty(_successMessage))
    {
        <div class="alert alert-success py-1 mb-2 small" role="status">@_successMessage</div>
    }

    @if (_loading)
    {
        <p role="status" aria-live="polite">Loading event types…</p>
    }
    else
    {
        <!-- Add Event Type Form — full width, single-row inline layout -->
        <div class="card mb-2">
            <div class="card-body py-2">
                <h6 class="card-title mb-2">Add Event Type</h6>
                <EditForm Model="_newModel" OnValidSubmit="HandleCreateAsync">
                    <DataAnnotationsValidator />
                    <div class="row g-2 align-items-start">
                        <div class="col">
                            <InputText id="et-name" class="form-control form-control-sm"
                                       @bind-Value="_newModel.Name"
                                       placeholder="Event type name"
                                       aria-label="Event type name" />
                            <ValidationMessage For="() => _newModel.Name" class="text-danger small" />
                        </div>
                        <div class="col-auto">
                            <button type="submit" class="btn btn-primary btn-sm" disabled="@_creating">
                                @(_creating ? "Creating…" : "Add Event Type")
                            </button>
                        </div>
                    </div>
                </EditForm>
            </div>
        </div>

        <!-- Active Event Types -->
        <section aria-labelledby="active-et-heading" class="mb-2">
            <h6 id="active-et-heading" class="mb-1">Event Types</h6>
            @if (!_activeTypes.Any())
            {
                <p class="text-muted small mb-0">No event types defined yet.</p>
            }
            else
            {
                <RadzenDataGrid Data="@_activeTypes" TItem="EventType"
                                AllowSorting="true" AllowPaging="true" PageSize="10"
                                class="rz-shadow-0">
                    <Columns>
                        <RadzenDataGridColumn TItem="EventType" Property="Name" Title="Name" Width="300px">
                            <Template Context="et">
                                @et.Name
                                @if (et.IsSystemDefault)
                                {
                                    <span class="badge bg-secondary ms-1" title="System default">System</span>
                                }
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="EventType" Title="Actions" Width="140px" Sortable="false">
                            <Template Context="et">
                                @if (!et.IsSystemDefault)
                                {
                                    <button class="btn btn-outline-danger btn-sm"
                                            @onclick="() => ArchiveAsync(et.Id)"
                                            aria-label="Archive @et.Name">
                                        Archive
                                    </button>
                                }
                                else
                                {
                                    <span class="text-muted small">Read-only</span>
                                }
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            }
        </section>

        <!-- Archived Event Types -->
        @if (_archivedTypes.Any())
        {
            <section aria-labelledby="archived-et-heading" class="mb-2">
                <h6 id="archived-et-heading" class="mb-1">Archived Event Types</h6>
                <RadzenDataGrid Data="@_archivedTypes" TItem="EventType"
                                AllowSorting="true" AllowPaging="true" PageSize="10"
                                class="rz-shadow-0">
                    <Columns>
                        <RadzenDataGridColumn TItem="EventType" Property="Name" Title="Name" Width="300px" />
                        <RadzenDataGridColumn TItem="EventType" Title="Actions" Width="140px" Sortable="false">
                            <Template Context="et">
                                <button class="btn btn-outline-secondary btn-sm"
                                        @onclick="() => RestoreAsync(et.Id)"
                                        aria-label="Restore @et.Name">
                                    Restore
                                </button>
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            </section>
        }
    }
</div>
