@using StageFright.Core.Entities

<div class="event-types-settings-tab">

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-danger" role="alert">@_errorMessage</div>
    }

    @if (!string.IsNullOrEmpty(_successMessage))
    {
        <div class="alert alert-success" role="status">@_successMessage</div>
    }

    @if (_loading)
    {
        <p role="status" aria-live="polite">Loading event types…</p>
    }
    else
    {
        <!-- Add Event Type Form -->
        <div class="card mb-4" style="max-width: 480px;">
            <div class="card-body">
                <h5 class="card-title">Add Event Type</h5>
                <EditForm Model="_newModel" OnValidSubmit="HandleCreateAsync">
                    <DataAnnotationsValidator />
                    <div class="mb-3">
                        <label for="et-name" class="form-label">Name <span aria-hidden="true" class="text-danger">*</span></label>
                        <InputText id="et-name" class="form-control" @bind-Value="_newModel.Name"
                                   placeholder="Event type name" />
                        <ValidationMessage For="() => _newModel.Name" class="text-danger small" />
                    </div>
                    <button type="submit" class="btn btn-primary btn-sm" disabled="@_creating">
                        @(_creating ? "Creating…" : "Add Event Type")
                    </button>
                </EditForm>
            </div>
        </div>

        <!-- Active Event Types -->
        <section aria-labelledby="active-et-heading" class="mb-4">
            <h5 id="active-et-heading">Event Types</h5>
            @if (!_activeTypes.Any())
            {
                <p class="text-muted small">No event types defined yet.</p>
            }
            else
            {
                <RadzenDataGrid Data="@_activeTypes" TItem="EventType"
                                AllowSorting="true" AllowPaging="true" PageSize="10"
                                class="rz-shadow-0" style="max-height: 400px; overflow-y: auto;">
                    <Columns>
                        <RadzenDataGridColumn TItem="EventType" Property="Name" Title="Name" Width="300px">
                            <Template Context="et">
                                @et.Name
                                @if (et.IsSystemDefault)
                                {
                                    <span class="badge bg-secondary ms-1" title="System default">System</span>
                                }
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="EventType" Title="Actions" Width="140px" Sortable="false">
                            <Template Context="et">
                                @if (!et.IsSystemDefault)
                                {
                                    <button class="btn btn-outline-danger btn-sm"
                                            @onclick="() => ArchiveAsync(et.Id)"
                                            aria-label="Archive @et.Name">
                                        Archive
                                    </button>
                                }
                                else
                                {
                                    <span class="text-muted small">Read-only</span>
                                }
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            }
        </section>

        <!-- Archived Event Types -->
        @if (_archivedTypes.Any())
        {
            <section aria-labelledby="archived-et-heading" class="mb-4">
                <h5 id="archived-et-heading">Archived Event Types</h5>
                <RadzenDataGrid Data="@_archivedTypes" TItem="EventType"
                                AllowSorting="true" AllowPaging="true" PageSize="10"
                                class="rz-shadow-0" style="max-height: 400px; overflow-y: auto;">
                    <Columns>
                        <RadzenDataGridColumn TItem="EventType" Property="Name" Title="Name" Width="300px" />
                        <RadzenDataGridColumn TItem="EventType" Title="Actions" Width="140px" Sortable="false">
                            <Template Context="et">
                                <button class="btn btn-outline-secondary btn-sm"
                                        @onclick="() => RestoreAsync(et.Id)"
                                        aria-label="Restore @et.Name">
                                    Restore
                                </button>
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            </section>
        }
    }
</div>
