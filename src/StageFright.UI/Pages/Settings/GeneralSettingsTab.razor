@using StageFright.Core.Entities
@using StageFright.Core.Enums
@using AppSettings = StageFright.Core.Entities.Settings

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="alert alert-danger py-1 mb-2 small" role="alert">@_errorMessage</div>
}

@if (!string.IsNullOrEmpty(_successMessage))
{
    <div class="alert alert-success py-1 mb-2 small" role="status">@_successMessage</div>
}

@if (_settings is null)
{
    <p role="status">@L["Settings_Common_LoadingText"]</p>
}
else
{
    var s = _settings;

    <EditForm Model="s" OnValidSubmit="HandleSaveAsync">
        <DataAnnotationsValidator />

        <div class="row g-2 mb-2">
            <div class="col-md-6">
                <label for="orgName" class="form-label">@L["Settings_General_OrganisationNameLabel"] <span class="text-danger">*</span></label>
                <InputText id="orgName" class="form-control form-control-sm" @bind-Value="s.OrganizationName" />
                <ValidationMessage For="() => s.OrganizationName" />
            </div>
        </div>

        <div class="row g-2 mb-2">
            <div class="col-md-6">
                <label for="annualFee" class="form-label">@L["Settings_General_AnnualFeeLabel"] <span class="text-danger">*</span></label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text">$</span>
                    <InputNumber id="annualFee" class="form-control" @bind-Value="s.AnnualFee" @bind-Value:format="N2" />
                </div>
                <ValidationMessage For="() => s.AnnualFee" />
            </div>
            <div class="col-md-6">
                <label for="attendanceFee" class="form-label">@L["Settings_General_AttendanceFeeLabel"] <span class="text-danger">*</span></label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text">$</span>
                    <InputNumber id="attendanceFee" class="form-control" @bind-Value="s.AttendanceFee" @bind-Value:format="N2" />
                </div>
                <ValidationMessage For="() => s.AttendanceFee" />
            </div>
        </div>

        <div class="row g-2 mb-2">
            <div class="col-md-4">
                <label for="membershipRenewalMonth" class="form-label">@L["Settings_General_MembershipRenewalMonthLabel"] <span class="text-danger">*</span></label>
                <InputSelect id="membershipRenewalMonth" class="form-select form-select-sm" @bind-Value="s.MembershipRenewalMonth">
                    @for (var m = 1; m <= 12; m++)
                    {
                        var month = m;
                        <option value="@month">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(month)</option>
                    }
                </InputSelect>
                <ValidationMessage For="() => s.MembershipRenewalMonth" />
            </div>
            <div class="col-md-4">
                <label for="committeeRenewalMonth" class="form-label">@L["Settings_General_AgmMonthLabel"]</label>
                <InputSelect id="committeeRenewalMonth" class="form-select form-select-sm" @bind-Value="s.CommitteeRenewalMonth">
                    @for (var m = 1; m <= 12; m++)
                    {
                        var month = m;
                        <option value="@month">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(month)</option>
                    }
                </InputSelect>
                <ValidationMessage For="() => s.CommitteeRenewalMonth" />
            </div>
            <div class="col-md-4">
                <label for="financialYearStartMonth" class="form-label">@L["Settings_General_FinancialYearStartMonthLabel"]</label>
                <InputSelect id="financialYearStartMonth" class="form-select form-select-sm" @bind-Value="s.FinancialYearStartMonth">
                    @for (var m = 1; m <= 12; m++)
                    {
                        var month = m;
                        <option value="@month">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(month)</option>
                    }
                </InputSelect>
                <div class="form-text small">@L["Settings_General_FinancialYearStartHelp"]</div>
                <ValidationMessage For="() => s.FinancialYearStartMonth" />
            </div>
        </div>

        <div class="row g-2 mb-2">
            <div class="col-md-4">
                <label for="auditRetentionYears" class="form-label">@L["Settings_General_AuditRetentionLabel"]</label>
                <InputSelect id="auditRetentionYears" class="form-select form-select-sm" @bind-Value="s.AuditRetentionYears">
                    @for (var y = 1; y <= 7; y++)
                    {
                        var years = y;
                        <option value="@years">@AuditRetentionOptionText(years)</option>
                    }
                </InputSelect>
                <div class="form-text small">@L["Settings_General_AuditRetentionHelp"]</div>
                <ValidationMessage For="() => s.AuditRetentionYears" />
            </div>
        </div>

        <div class="row g-2 mb-2">
            <div class="col-md-6">
                <label for="maxAge" class="form-label">@L["Settings_General_MaxAgeLabel"]</label>
                <InputNumber id="maxAge" class="form-control form-control-sm" @bind-Value="s.MaxAgeRangeYears" />
                <ValidationMessage For="() => s.MaxAgeRangeYears" />
            </div>
            <div class="col-md-6">
                <label for="minAge" class="form-label">@L["Settings_General_MinAgeLabel"]</label>
                <InputNumber id="minAge" class="form-control form-control-sm" @bind-Value="s.MinimumMemberAge" />
                <ValidationMessage For="() => s.MinimumMemberAge" />
            </div>
        </div>

        <div class="row g-2 mb-2">
            <div class="col-md-6">
                <label for="theme-toggle-switch" class="form-label">@L["Settings_General_ThemeLabel"]</label>
                <div class="d-flex align-items-center gap-2">
                    <RadzenSwitch Name="theme-toggle-switch"
                                  Value="@(s.Theme == StageFright.Core.Enums.Theme.Dark)"
                                  Change="@(async (bool _) => await HandleThemeToggleAsync())" />
                    <span class="text-muted small">@ThemeCurrentText(s.Theme)</span>
                </div>
            </div>
            <div class="col-md-6">
                <label for="showParticipationGraphs" class="form-label">@L["Settings_General_DashboardLabel"]</label>
                <div class="d-flex align-items-center gap-2">
                    <RadzenSwitch Name="showParticipationGraphs" @bind-Value="s.ShowParticipationGraphs" />
                    <label class="form-check-label small" for="showParticipationGraphs">
                        @L["Settings_General_ShowGraphsLabel"]
                    </label>
                </div>
            </div>
        </div>

        <div class="row g-2 mb-2">
            <div class="col-md-6">
                <label for="languageCode" class="form-label">@L["Settings_General_LanguageLabel"]</label>
                <InputSelect id="languageCode" class="form-select form-select-sm" @bind-Value="_selectedLanguageCode">
                    @foreach (var language in Languages.All)
                    {
                        <option value="@language.CultureCode">@language.Endonym</option>
                    }
                </InputSelect>
                <div class="form-text small">@L["Settings_General_LanguageHelp"]</div>
            </div>
        </div>

        @if (LanguageChanged)
        {
            <div class="alert alert-info py-1 mb-2 small" role="status">@L["Settings_General_LanguageRestartNotice"]</div>
        }

        <div class="d-flex gap-2 mt-3">
            <button type="submit" class="btn btn-primary btn-sm" disabled="@_saving">
                @(_saving ? Shared["Shared_Action_Saving"] : L["Settings_Common_SaveButton"])
            </button>
        </div>
    </EditForm>
}
