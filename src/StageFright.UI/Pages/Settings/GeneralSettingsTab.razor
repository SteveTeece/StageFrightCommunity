@using StageFright.Core.Entities
@using StageFright.Core.Enums
@using AppSettings = StageFright.Core.Entities.Settings

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="alert alert-danger py-1 mb-2 small" role="alert">@_errorMessage</div>
}

@if (!string.IsNullOrEmpty(_successMessage))
{
    <div class="alert alert-success py-1 mb-2 small" role="status">@_successMessage</div>
}

@if (_settings is null)
{
    <p role="status">Loading settings…</p>
}
else
{
    var s = _settings;

    <EditForm Model="s" OnValidSubmit="HandleSaveAsync">
        <DataAnnotationsValidator />

        <div class="row g-2 mb-2">
            <div class="col-md-6">
                <label for="orgName" class="form-label">Organisation Name <span class="text-danger">*</span></label>
                <InputText id="orgName" class="form-control form-control-sm" @bind-Value="s.OrganizationName" />
                <ValidationMessage For="() => s.OrganizationName" />
            </div>
            <div class="col-md-6">
                <label for="abn" class="form-label">ABN</label>
                <AbnInput id="abn" class="form-control form-control-sm" @bind-Value="s.Abn" />
                <ValidationMessage For="() => s.Abn" />
                @if (string.IsNullOrEmpty(s.Abn))
                {
                    <div class="form-text small">ABN not on file.</div>
                }
            </div>
        </div>

        <div class="row g-2 mb-2">
            <div class="col-md-6">
                <label for="annualFee" class="form-label">Annual Membership Fee <span class="text-danger">*</span></label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text">@System.Globalization.CultureInfo.CurrentCulture.NumberFormat.CurrencySymbol</span>
                    <InputNumber id="annualFee" class="form-control" @bind-Value="s.AnnualFee" @bind-Value:format="N2" />
                </div>
                <ValidationMessage For="() => s.AnnualFee" />
            </div>
            <div class="col-md-6">
                <label for="attendanceFee" class="form-label">Attendance Fee <span class="text-danger">*</span></label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text">@System.Globalization.CultureInfo.CurrentCulture.NumberFormat.CurrencySymbol</span>
                    <InputNumber id="attendanceFee" class="form-control" @bind-Value="s.AttendanceFee" @bind-Value:format="N2" />
                </div>
                <ValidationMessage For="() => s.AttendanceFee" />
            </div>
        </div>

        <div class="row g-2 mb-2">
            <div class="col-md-4">
                <label for="membershipRenewalMonth" class="form-label">Membership Renewal Month <span class="text-danger">*</span></label>
                <InputSelect id="membershipRenewalMonth" class="form-select form-select-sm" @bind-Value="s.MembershipRenewalMonth">
                    @for (var m = 1; m <= 12; m++)
                    {
                        var month = m;
                        <option value="@month">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(month)</option>
                    }
                </InputSelect>
                <ValidationMessage For="() => s.MembershipRenewalMonth" />
            </div>
            <div class="col-md-4">
                <label for="committeeRenewalMonth" class="form-label">AGM Month</label>
                <InputSelect id="committeeRenewalMonth" class="form-select form-select-sm" @bind-Value="s.CommitteeRenewalMonth">
                    @for (var m = 1; m <= 12; m++)
                    {
                        var month = m;
                        <option value="@month">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(month)</option>
                    }
                </InputSelect>
                <ValidationMessage For="() => s.CommitteeRenewalMonth" />
            </div>
            <div class="col-md-4">
                <label for="financialYearStartMonth" class="form-label">Financial Year Start Month</label>
                <InputSelect id="financialYearStartMonth" class="form-select form-select-sm" @bind-Value="s.FinancialYearStartMonth">
                    @for (var m = 1; m <= 12; m++)
                    {
                        var month = m;
                        <option value="@month">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(month)</option>
                    }
                </InputSelect>
                <div class="form-text small">Default July — Australian financial year.</div>
                <ValidationMessage For="() => s.FinancialYearStartMonth" />
            </div>
        </div>

        <div class="row g-2 mb-2">
            <div class="col-md-4">
                <label for="auditRetentionYears" class="form-label">Audit Trail Retention (years)</label>
                <InputSelect id="auditRetentionYears" class="form-select form-select-sm" @bind-Value="s.AuditRetentionYears">
                    @for (var y = 1; y <= 7; y++)
                    {
                        var years = y;
                        <option value="@years">@years year@(years == 1 ? "" : "s")</option>
                    }
                </InputSelect>
                <div class="form-text small">How long audit trail history is kept before the startup purge removes it.</div>
                <ValidationMessage For="() => s.AuditRetentionYears" />
            </div>
        </div>

        <div class="row g-2 mb-2">
            <div class="col-md-6">
                <label for="maxAge" class="form-label">Maximum Member Age (years)</label>
                <InputNumber id="maxAge" class="form-control form-control-sm" @bind-Value="s.MaxAgeRangeYears" />
                <ValidationMessage For="() => s.MaxAgeRangeYears" />
            </div>
            <div class="col-md-6">
                <label for="minAge" class="form-label">Minimum Member Age (years)</label>
                <InputNumber id="minAge" class="form-control form-control-sm" @bind-Value="s.MinimumMemberAge" />
                <ValidationMessage For="() => s.MinimumMemberAge" />
            </div>
        </div>

        <div class="row g-2 mb-2">
            <div class="col-md-6">
                <label for="theme-toggle-switch" class="form-label">Theme</label>
                <div class="d-flex align-items-center gap-2">
                    <RadzenSwitch Name="theme-toggle-switch"
                                  Value="@(s.Theme == StageFright.Core.Enums.Theme.Dark)"
                                  Change="@(async (bool _) => await HandleThemeToggleAsync())" />
                    <span class="text-muted small">Current: @s.Theme</span>
                </div>
            </div>
            <div class="col-md-6">
                <label for="showParticipationGraphs" class="form-label">Dashboard</label>
                <div class="d-flex align-items-center gap-2">
                    <RadzenSwitch Name="showParticipationGraphs" @bind-Value="s.ShowParticipationGraphs" />
                    <label class="form-check-label small" for="showParticipationGraphs">
                        Show year-to-date participation graphs on Rehearsals and Events tiles
                    </label>
                </div>
            </div>
        </div>

        <div class="d-flex gap-2 mt-3">
            <button type="submit" class="btn btn-primary btn-sm" disabled="@_saving">
                @(_saving ? "Saving…" : "Save Settings")
            </button>
        </div>
    </EditForm>
}
