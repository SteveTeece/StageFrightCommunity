@page "/reports"
@page "/reports/{ReportId?}"

<PageTitle>@L["Shared_ReportsPage_Title"]</PageTitle>

<div class="page-header mb-2">
    <h1 class="h3 mb-0">@L["Shared_ReportsPage_Heading"]</h1>
</div>

@if (_currentProvider != null)
{
    <ReportViewer Provider="_currentProvider" />
}
else if (!string.IsNullOrEmpty(ReportId))
{
    <div class="alert alert-warning py-1 mb-2 small" role="alert">
        @NotFoundText()
    </div>
}
else
{
    <p class="text-muted small mt-1">@L["Shared_ReportsPage_SelectPrompt"]</p>
}
