@page "/members/new"
@page "/members/edit/{Id:guid}"

<PageTitle>@(_isNew ? L["Members_Form_AddPageTitle"] : L["Members_Form_EditPageTitle"])</PageTitle>

<div class="page-header mb-2">
    <h1 class="h3">@(_isNew ? L["Members_Form_AddHeading"] : L["Members_Form_EditHeading"])</h1>
</div>

@if (_loading)
{
    <p role="status" aria-live="polite">@Shared["Shared_Common_Loading"]</p>
}
else
{
    <EditForm Model="_form" OnValidSubmit="SaveAsync">
        <div class="row g-2 mb-2">

            <div class="col-md-6">
                <label class="form-label" for="firstName">@L["Members_Form_FirstNameLabel"] <span aria-hidden="true">*</span></label>
                <InputText id="firstName"
                           class="@(_errors.ContainsKey("FirstName") ? "form-control form-control-sm is-invalid" : "form-control form-control-sm")"
                           @bind-Value="_form.FirstName" />
                @if (_errors.TryGetValue("FirstName", out var firstNameErr))
                {
                    <div class="invalid-feedback">@firstNameErr</div>
                }
            </div>

            <div class="col-md-6">
                <label class="form-label" for="lastName">@L["Members_Form_LastNameLabel"] <span aria-hidden="true">*</span></label>
                <InputText id="lastName"
                           class="@(_errors.ContainsKey("LastName") ? "form-control form-control-sm is-invalid" : "form-control form-control-sm")"
                           @bind-Value="_form.LastName" />
                @if (_errors.TryGetValue("LastName", out var lastNameErr))
                {
                    <div class="invalid-feedback">@lastNameErr</div>
                }
            </div>

            <div class="col-md-6">
                <label class="form-label" for="address">@L["Members_Form_StreetAddressLabel"] <span aria-hidden="true">*</span></label>
                <InputText id="address"
                           class="@(_errors.ContainsKey("StreetAddress") ? "form-control form-control-sm is-invalid" : "form-control form-control-sm")"
                           @bind-Value="_form.StreetAddress" />
                @if (_errors.TryGetValue("StreetAddress", out var addrErr))
                {
                    <div class="invalid-feedback">@addrErr</div>
                }
            </div>

            <div class="col-md-6">
                <label class="form-label" for="phone">@L["Members_Form_PhoneLabel"]</label>
                <InputText id="phone"
                           class="@(_errors.ContainsKey("Phone") ? "form-control form-control-sm is-invalid" : "form-control form-control-sm")"
                           @bind-Value="_form.Phone" />
                @if (_errors.TryGetValue("Phone", out var phoneErr))
                {
                    <div class="invalid-feedback">@phoneErr</div>
                }
            </div>

            <div class="col-md-6">
                <label class="form-label" for="email">@L["Members_Form_EmailLabel"]</label>
                <InputText id="email"
                           class="@(_errors.ContainsKey("Email") ? "form-control form-control-sm is-invalid" : "form-control form-control-sm")"
                           @bind-Value="_form.Email" />
                @if (_errors.TryGetValue("Email", out var emailErr))
                {
                    <div class="invalid-feedback">@emailErr</div>
                }
            </div>

            <div class="col-md-6">
                <label class="form-label" for="joinDate">@L["Members_Form_JoinDateLabel"] <span aria-hidden="true">*</span></label>
                <InputDate id="joinDate" class="form-control form-control-sm" @bind-Value="_form.JoinDate" />
            </div>

            <div class="col-md-6">
                <label class="form-label" for="dob">@L["Members_Form_DateOfBirthLabel"]</label>
                <InputDate id="dob"
                           class="@(_errors.ContainsKey("DateOfBirth") ? "form-control form-control-sm is-invalid" : "form-control form-control-sm")"
                           @bind-Value="_form.DateOfBirth" />
                @if (_errors.TryGetValue("DateOfBirth", out var dobErr))
                {
                    <div class="invalid-feedback">@dobErr</div>
                }
            </div>

        </div>

        @if (!string.IsNullOrEmpty(_globalError))
        {
            <div class="alert alert-danger py-1 mb-2 small" role="alert">@_globalError</div>
        }

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary btn-sm" disabled="@_saving">
                @(_saving ? Shared["Shared_Action_Saving"] : Shared["Shared_Action_Save"])
            </button>
            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="Cancel">@Shared["Shared_Action_Cancel"]</button>
        </div>
    </EditForm>
}
