@page "/members/{Id:guid}"

<PageTitle>@(_member?.FullName ?? "Member") — StageFright Community</PageTitle>

@if (_loading)
{
    <p role="status" aria-live="polite">Loading…</p>
}
else if (_member is null)
{
    <div class="alert alert-warning py-1 mb-2 small">Member not found.</div>
}
else
{
    <div class="page-header d-flex align-items-center justify-content-between mb-2">
        <h1 class="h3 mb-0">@_member.FullName</h1>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-secondary btn-sm" @onclick="Edit">Edit</button>
            @if (_member.Status == StageFright.Core.Enums.MemberStatus.Active)
            {
                <button class="btn btn-outline-warning btn-sm" @onclick="InactivateAsync">Inactivate</button>
            }
            else
            {
                <button class="btn btn-outline-success btn-sm" @onclick="ActivateAsync">Activate</button>
            }
            <button class="btn btn-outline-danger btn-sm" @onclick="ArchiveAsync">Archive</button>
        </div>
    </div>

    <div class="row g-2 mb-2">
        <div class="col-md-6">
            <dl class="row mb-0 small">
                <dt class="col-sm-5">Address</dt>
                <dd class="col-sm-7">@_member.StreetAddress</dd>

                @if (!string.IsNullOrEmpty(_member.Phone))
                {
                    <dt class="col-sm-5">Phone</dt>
                    <dd class="col-sm-7">@_member.Phone</dd>
                }

                @if (!string.IsNullOrEmpty(_member.Email))
                {
                    <dt class="col-sm-5">Email</dt>
                    <dd class="col-sm-7">@_member.Email</dd>
                }

                <dt class="col-sm-5">Join Date</dt>
                <dd class="col-sm-7">@_member.JoinDate.ToString("d MMM yyyy")</dd>

                @if (_member.DateOfBirth.HasValue)
                {
                    <dt class="col-sm-5">Date of Birth</dt>
                    <dd class="col-sm-7">@_member.DateOfBirth.Value.ToString("d MMM yyyy")</dd>

                    <dt class="col-sm-5">Age</dt>
                    <dd class="col-sm-7">@_age</dd>
                }

                <dt class="col-sm-5">Status</dt>
                <dd class="col-sm-7">@_member.Status</dd>
            </dl>
        </div>
    </div>

    @if (_committeeHistory.Count > 0)
    {
        <section aria-label="Committee History" class="mb-2">
            <h2 class="h6 mb-1">Committee History</h2>
            <ul class="list-unstyled small mb-0">
                @foreach (var record in _committeeHistory.OrderByDescending(r => r.Year))
                {
                    <li class="mb-1">
                        @if (record.Year == _currentYear)
                        {
                            <strong>
                                @record.Year
                                <span role="status"
                                      aria-label="Current year"
                                      style="background-color:hsl(120,40%,70%);padding:1px 6px;border-radius:4px;font-size:.8em;font-weight:normal">
                                    Current
                                </span>
                                — @record.Position
                            </strong>
                        }
                        else
                        {
                            <span>@record.Year — @record.Position</span>
                        }
                    </li>
                }
            </ul>
        </section>
    }

    @if (_feeHistory.Count > 0)
    {
        <section aria-label="Fee Payment History" class="mt-2">
            <h2 class="h6 mb-1">Fee Payment History</h2>
            <RadzenDataGrid Data="@_feeHistory" TItem="FeeHistoryItem"
                            AllowPaging="true" PageSize="15"
                            AllowSorting="true"
                            class="rz-shadow-0">
                <Columns>
                    <RadzenDataGridColumn TItem="FeeHistoryItem" Property="FeeDate" Title="Date" Width="120px">
                        <Template Context="f">@f.FeeDate.ToString("d MMM yyyy")</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="FeeHistoryItem" Property="FeeType" Title="Type" Width="100px" />
                    <RadzenDataGridColumn TItem="FeeHistoryItem" Property="Amount" Title="Amount" Width="85px">
                        <Template Context="f"><span class="d-block text-end">@f.Amount.ToString("C")</span></Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="FeeHistoryItem" Property="PaidAmount" Title="Paid" Width="85px">
                        <Template Context="f"><span class="d-block text-end">@f.PaidAmount.ToString("C")</span></Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="FeeHistoryItem" Property="IsPaid" Title="Status" Width="80px" Sortable="false">
                        <Template Context="f">
                            @if (f.IsPaid)
                            {
                                <span class="badge bg-success">Paid</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">Unpaid</span>
                            }
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </section>
    }
}
