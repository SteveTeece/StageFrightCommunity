@page "/members"

<PageTitle>@L["Members_List_PageTitle"]</PageTitle>

<div class="page-header d-flex align-items-center justify-content-between mb-2">
    <h1 class="h3 mb-0">@L["Members_List_Heading"]</h1>
    <button class="btn btn-primary btn-sm" @onclick="AddMember">@L["Members_List_AddButton"]</button>
</div>

<div class="mb-2 d-flex align-items-center gap-2 flex-wrap">
    <div class="input-group input-group-sm" style="max-width: 320px;">
        <span class="input-group-text" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.099zm-5.242 1.156a5.5 5.5 0 1 1 0-11 5.5 5.5 0 0 1 0 11z"/>
            </svg>
        </span>
        <input type="search" class="form-control form-control-sm" placeholder="@L["Members_List_SearchPlaceholder"]"
               aria-label="@L["Members_List_SearchAriaLabel"]"
               @bind="_searchTerm" @bind:event="oninput" />
    </div>
    <div class="d-flex align-items-center gap-2 ms-auto">
        <label for="showInactiveSwitch" class="form-label mb-0">@L["Members_List_ShowInactiveLabel"]</label>
        <RadzenSwitch Name="showInactiveSwitch" @bind-Value="_showInactive" Change="@(async (bool _) => await LoadAsync())" />
    </div>
</div>

@if (_loading)
{
    <p role="status" aria-live="polite">@L["Members_List_LoadingText"]</p>
}
else if (!DisplayMembers.Any())
{
    @if (_members.Count == 0)
    {
        <p class="text-muted">@(_showInactive ? L["Members_List_EmptyAll"] : L["Members_List_EmptyActive"])</p>
    }
    else
    {
        <p class="text-muted">@NoMatchText()</p>
    }
}
else
{
    <RadzenDataGrid Data="@DisplayMembers" TItem="Member"
                    AllowSorting="true" AllowPaging="true" PageSize="15"
                    class="rz-shadow-0">
        <Columns>
            <RadzenDataGridColumn TItem="Member" Property="SortableFullName" Title="@L["Members_List_NameColumn"]" Width="200px">
                <Template Context="member">
                    <a href="#" @onclick:preventDefault @onclick="() => ViewMember(member.Id)"
                       class="text-decoration-none fw-semibold">
                        @member.SortableFullName@(member.Status == MemberStatus.Inactive ? $" ({member.Status.LocalizeEnum()})" : "")
                    </a>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="Member" Property="StreetAddress" Title="@L["Members_List_AddressColumn"]" />
            <RadzenDataGridColumn TItem="Member" Property="Phone" Title="@L["Members_List_PhoneColumn"]" Width="130px" />
            <RadzenDataGridColumn TItem="Member" Property="Email" Title="@L["Members_List_EmailColumn"]" Width="200px" />
            <RadzenDataGridColumn TItem="Member" Title="@L["Members_List_AgeColumn"]" Width="90px">
                <Template Context="member">
                    @if (member.DateOfBirth.HasValue)
                    {
                        @(AgeCalc.Calculate(member.DateOfBirth, DateTime.UtcNow.Date)?.ToString() ?? "—")
                    }
                    else
                    {
                        <span class="text-muted">—</span>
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="Member" Title="@Shared["Shared_Table_ActionsColumn"]" Width="110px" Sortable="false">
                <Template Context="member">
                    <button class="btn btn-primary btn-sm"
                            @onclick="() => EditMember(member.Id)"
                            aria-label="@EditMemberAriaLabel(member.SortableFullName)">
                        @Shared["Shared_Action_Edit"]
                    </button>
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
}
