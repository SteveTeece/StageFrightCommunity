@page "/members"

<PageTitle>Members — StageFright Community</PageTitle>

<div class="page-header d-flex align-items-center justify-content-between mb-2">
    <h1 class="h3 mb-0">Members</h1>
    <button class="btn btn-primary btn-sm" @onclick="AddMember">Add Member</button>
</div>

<div class="mb-2 d-flex align-items-center gap-2 flex-wrap">
    <div class="form-check form-switch mb-0">
        <input class="form-check-input" type="checkbox" role="switch" id="showInactiveSwitch"
               @bind="_showInactive" @bind:after="LoadAsync" />
        <label class="form-check-label" for="showInactiveSwitch">Show inactive members</label>
    </div>
    <div class="input-group input-group-sm" style="max-width: 320px;">
        <span class="input-group-text" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.099zm-5.242 1.156a5.5 5.5 0 1 1 0-11 5.5 5.5 0 0 1 0 11z"/>
            </svg>
        </span>
        <input type="search" class="form-control form-control-sm" placeholder="Search by name, email, phone or address…"
               aria-label="Search members"
               @bind="_searchTerm" @bind:event="oninput" />
    </div>
</div>

@if (_loading)
{
    <p role="status" aria-live="polite">Loading members…</p>
}
else if (!DisplayMembers.Any())
{
    @if (_members.Count == 0)
    {
        <p class="text-muted">No @(_showInactive ? "" : "active ")members found.</p>
    }
    else
    {
        <p class="text-muted">No members match "<strong>@_searchTerm</strong>".</p>
    }
}
else
{
    <RadzenDataGrid Data="@DisplayMembers" TItem="Member"
                    AllowSorting="true" AllowPaging="true" PageSize="15"
                    class="rz-shadow-0">
        <Columns>
            <RadzenDataGridColumn TItem="Member" Property="Name" Title="Name" Width="200px">
                <Template Context="member">
                    <a href="#" @onclick:preventDefault @onclick="() => ViewMember(member.Id)"
                       class="text-decoration-none fw-semibold">
                        @member.Name@(member.Status == MemberStatus.Inactive ? " (Inactive)" : "")
                    </a>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="Member" Property="StreetAddress" Title="Address" />
            <RadzenDataGridColumn TItem="Member" Property="Phone" Title="Phone" Width="130px" />
            <RadzenDataGridColumn TItem="Member" Property="Email" Title="Email" Width="200px" />
            <RadzenDataGridColumn TItem="Member" Title="Age" Width="90px">
                <Template Context="member">
                    @if (member.DateOfBirth.HasValue)
                    {
                        @(_ageCalc.Calculate(member.DateOfBirth, DateTime.UtcNow.Date)?.ToString() ?? "—")
                    }
                    else
                    {
                        <span class="text-muted">—</span>
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="Member" Title="Actions" Width="110px" Sortable="false">
                <Template Context="member">
                    <button class="btn btn-primary btn-sm"
                            @onclick="() => EditMember(member.Id)"
                            aria-label="Edit @member.Name">
                        Edit
                    </button>
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
}
