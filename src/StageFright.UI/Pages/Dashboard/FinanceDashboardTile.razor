@using StageFright.Core.Services
@using StageFright.Data.Repositories

<DashboardTile Title="Finance" CssClass="finance-tile" IsLoading="IsLoading" ErrorMessage="ErrorMessage">
    <div class="stat">
        <span class="label">Total Outstanding Balance:</span>
        <span class="value @(TotalOutstandingBalance > 0 ? "balance-negative" : "balance-positive")">
            @TotalOutstandingBalance.ToString("C")
        </span>
    </div>
    <div class="stat">
        <span class="label">Members with Balances:</span>
        <span class="value">@MembersWithBalances</span>
    </div>
</DashboardTile>

@code {
    [Inject]
    private IMemberService? MemberService { get; set; }

    [Inject]
    private IFinanceService? FinanceService { get; set; }

    private bool IsLoading = true;
    private string? ErrorMessage = null;
    private decimal TotalOutstandingBalance = 0;
    private int MembersWithBalances = 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            IsLoading = true;
            ErrorMessage = null;

            if (MemberService == null || FinanceService == null)
            {
                ErrorMessage = "Services not available.";
                return;
            }

            // Get all active members and sum their outstanding balances
            var members = await MemberService.GetActiveMembersAsync();
            TotalOutstandingBalance = 0;
            MembersWithBalances = 0;

            foreach (var member in members)
            {
                var balance = await FinanceService.GetMemberBalanceAsync(member.Id);
                if (balance > 0)
                {
                    TotalOutstandingBalance += balance;
                    MembersWithBalances++;
                }
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Failed to load finance data: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }
}

