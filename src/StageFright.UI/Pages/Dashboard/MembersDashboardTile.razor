@using StageFright.Data.Repositories

<DashboardTile Title="Members" CssClass="members-tile" IsLoading="IsLoading" ErrorMessage="ErrorMessage">
    <div class="stat">
        <span class="label">Active:</span>
        <span class="value">@ActiveCount</span>
    </div>
    <div class="stat">
        <span class="label">Inactive:</span>
        <span class="value">@InactiveCount</span>
    </div>
</DashboardTile>

@code {
    [Inject]
    public required IMemberRepository MemberRepository { get; set; }

    private bool IsLoading = true;
    private string? ErrorMessage = null;
    private int ActiveCount = 0;
    private int InactiveCount = 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            IsLoading = true;
            ErrorMessage = null;

            var members = await MemberRepository.GetAllAsync();
            ActiveCount = members.Count(m => m.Status == "Active");
            InactiveCount = members.Count(m => m.Status == "Inactive");
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Failed to load members: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }
}
