@using StageFright.Data.Repositories

<DashboardTile Title="Rehearsals" CssClass="rehearsals-tile" IsLoading="IsLoading" ErrorMessage="ErrorMessage">
    <div class="stat">
        <span class="label">Most Recent:</span>
        <span class="value">@(MostRecentDate?.ToShortDateString() ?? "No rehearsals")</span>
    </div>
    <div class="stat">
        <span class="label">Attendance Rate:</span>
        <span class="value">@(AttendanceRate?.ToString("F1") ?? "N/A")%</span>
    </div>
    <div class="stat">
        <span class="label">Total Recorded:</span>
        <span class="value">@TotalCount</span>
    </div>
</DashboardTile>

@code {
    [Inject]
    public required IRehearsalRepository RehearsalRepository { get; set; }

    private bool IsLoading = true;
    private string? ErrorMessage = null;
    private DateTime? MostRecentDate = null;
    private decimal? AttendanceRate = null;
    private int TotalCount = 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            IsLoading = true;
            ErrorMessage = null;

            var rehearsals = await RehearsalRepository.GetAllAsync();
            TotalCount = rehearsals.Count();
            
            var mostRecent = rehearsals.OrderByDescending(r => r.Date).FirstOrDefault();
            if (mostRecent != null)
            {
                MostRecentDate = mostRecent.Date;
                AttendanceRate = mostRecent.StoredAttendanceRate;
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Failed to load rehearsals: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }
}
