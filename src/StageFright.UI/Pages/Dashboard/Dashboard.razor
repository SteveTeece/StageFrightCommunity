@page "/dashboard"

<PageTitle>@L["Dashboard_Page_Title"]</PageTitle>

@if (ShowStartupWarning)
{
    <div class="alert alert-warning d-flex justify-content-between align-items-start" role="alert" data-testid="startup-warning-banner">
        <span>@StartupWarningText</span>
        <button type="button" class="btn btn-sm btn-outline-secondary ms-3" @onclick="DismissStartupWarning">
            @StartupWarningDismissLabel
        </button>
    </div>
}

@if (!_initialized)
{
    <div class="d-flex justify-content-center align-items-center py-4" role="status" aria-live="polite">
        <div class="spinner-border text-primary me-2" aria-hidden="true"></div>
        <span>@L["Dashboard_LoadingText"]</span>
    </div>
}
else
{
    <div class="page-header mb-2">
        <h1 class="h3">@L["Dashboard_Heading"]</h1>
    </div>

    <section aria-label="@L["Dashboard_CoreMetricsHeading"]" class="mb-2">
        <h2 class="section-label mb-2">@L["Dashboard_CoreMetricsHeading"]</h2>
        <div class="sf-dash-grid">
            @foreach (var tile in _coreTiles)
            {
                <div class="card h-100 sf-dash-tile tile-@tile.TileId @GetTileSizeClass(tile.TileSize) @(tile.NavigateRoute != null ? "sf-tile-clickable" : "")"
                     @onclick="@(() => NavigateTo(tile.NavigateRoute))">
                    <div class="card-header py-1 fw-semibold small d-flex align-items-baseline justify-content-between">
                        <span>@tile.Title</span>
                        @if (!string.IsNullOrEmpty(tile.ActionText) && !string.IsNullOrEmpty(tile.NavigateRoute))
                        {
                            <a class="tile-action-link" href="@tile.NavigateRoute"
                               @onclick:preventDefault
                               @onclick:stopPropagation
                               @onclick="() => NavigateTo(tile.NavigateRoute)">@tile.ActionText</a>
                        }
                    </div>
                    <div class="card-body py-2">
                        <TileRenderer Provider="tile" LoadTask="_loadTasks[tile.TileId]" />
                    </div>
                </div>
            }
        </div>
    </section>

    @if (_extensionTiles.Count > 0)
    {
        <section aria-label="@L["Dashboard_ExtensionsHeading"]" class="mb-2">
            <h2 class="section-label mb-2">@L["Dashboard_ExtensionsHeading"]</h2>
            <div class="sf-dash-grid">
                @foreach (var tile in _extensionTiles)
                {
                    <div class="card h-100 sf-dash-tile tile-@tile.TileId @GetTileSizeClass(tile.TileSize) @(tile.NavigateRoute != null ? "sf-tile-clickable" : "")"
                         @onclick="@(() => NavigateTo(tile.NavigateRoute))">
                        <div class="card-header py-1 fw-semibold small d-flex align-items-baseline justify-content-between">
                            <span>@tile.Title</span>
                            @if (!string.IsNullOrEmpty(tile.ActionText) && !string.IsNullOrEmpty(tile.NavigateRoute))
                            {
                                <a class="tile-action-link" href="@tile.NavigateRoute"
                                   @onclick:preventDefault
                                   @onclick:stopPropagation
                                   @onclick="() => NavigateTo(tile.NavigateRoute)">@tile.ActionText</a>
                            }
                        </div>
                        <div class="card-body py-2">
                            <TileRenderer Provider="tile" LoadTask="_loadTasks[tile.TileId]" />
                        </div>
                    </div>
                }
            </div>
        </section>
    }
}
