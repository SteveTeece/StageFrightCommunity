@page "/dashboard"

<PageTitle>Dashboard — StageFright Community</PageTitle>

@if (!_initialized)
{
    <div class="d-flex justify-content-center align-items-center py-4" role="status" aria-live="polite">
        <div class="spinner-border text-primary me-2" aria-hidden="true"></div>
        <span>Loading dashboard…</span>
    </div>
}
else
{
    <div class="page-header mb-2">
        <h1 class="h3">Dashboard</h1>
    </div>

    <section aria-label="Core Metrics" class="mb-2">
        <h2 class="h6 fw-semibold mb-2">Core Metrics</h2>
        <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-2">
            @foreach (var tile in _coreTiles)
            {
                <div class="col">
                    <div class="card h-100 @(tile.NavigateRoute != null ? "sf-tile-clickable" : "")"
                         @onclick="@(() => NavigateTo(tile.NavigateRoute))">
                        <div class="card-header py-1 fw-semibold small">@tile.Title</div>
                        <div class="card-body py-2">
                            <TileRenderer Provider="tile" LoadTask="_loadTasks[tile.TileId]" />
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>

    @if (_extensionTiles.Count > 0)
    {
        <section aria-label="Extensions" class="mb-2">
            <h2 class="h6 fw-semibold mb-2">Extensions</h2>
            <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-2">
                @foreach (var tile in _extensionTiles)
                {
                    <div class="col">
                        <div class="card h-100 @(tile.NavigateRoute != null ? "sf-tile-clickable" : "")"
                             @onclick="@(() => NavigateTo(tile.NavigateRoute))">
                            <div class="card-header py-1 fw-semibold small">@tile.Title</div>
                            <div class="card-body py-2">
                                <TileRenderer Provider="tile" LoadTask="_loadTasks[tile.TileId]" />
                            </div>
                        </div>
                    </div>
                }
            </div>
        </section>
    }
}
