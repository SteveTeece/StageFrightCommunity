@page "/rehearsals"
@layout MainLayout
@using StageFright.Data.Repositories
@using StageFright.Core.Entities

<div class="rehearsals-module">
    <div class="module-header">
        <h1>Rehearsals</h1>
        <button class="btn btn-primary" @onclick="OpenScheduleForm">Schedule Rehearsal</button>
    </div>

    @if (ShowScheduleForm)
    {
        <ScheduleRehearsalForm OnSaved="RehearsalScheduled" OnCancelled="HideScheduleForm" />
    }

    @if (ShowAttendanceRecorder)
    {
        <BatchAttendanceRecorder RehearsalId="SelectedRehearsalId" OnSaved="AttendanceRecorded" OnCancelled="HideAttendanceRecorder" />
    }

    @if (IsLoading)
    {
        <div class="loading">Loading rehearsals...</div>
    }
    else if (ErrorMessage != null)
    {
        <div class="error-message">@ErrorMessage</div>
    }
    else
    {
        <div class="rehearsals-list">
            <h2>Scheduled Rehearsals</h2>
            @if (RehearsalList.Count == 0)
            {
                <p>No rehearsals scheduled yet.</p>
            }
            else
            {
                <table class="table">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Time</th>
                            <th>Attendance Rate</th>
                            <th>Notes</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var rehearsal in RehearsalList)
                        {
                            <tr>
                                <td>@rehearsal.Date.ToShortDateString()</td>
                                <td>@rehearsal.Time.ToString(@"hh\:mm")</td>
                                <td>@(rehearsal.StoredAttendanceRate > 0 ? rehearsal.StoredAttendanceRate.ToString("F1") + "%" : "Not recorded")</td>
                                <td>@rehearsal.Notes</td>
                                <td>
                                    <button class="btn btn-sm btn-primary" @onclick="() => RecordAttendance(rehearsal.Id)">Record Attendance</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    }
</div>
