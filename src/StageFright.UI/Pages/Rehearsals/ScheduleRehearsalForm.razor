@using StageFright.Data.Repositories
@using StageFright.Core.Entities

<div class="schedule-rehearsal-form">
    @if (ErrorMessage != null)
    {
        <div class="error-message">@ErrorMessage</div>
    }

    <form @onsubmit="ScheduleRehearsal">
        <div class="form-group">
            <label for="date">Date (required):</label>
            <input id="date" type="date" class="form-control" @bind="DateString" required />
        </div>

        <div class="form-group">
            <label for="time">Time (required):</label>
            <input id="time" type="time" class="form-control" @bind="TimeString" required />
        </div>

        <div class="form-group">
            <label for="notes">Notes (optional):</label>
            <textarea id="notes" class="form-control" @bind="Notes" rows="3"></textarea>
        </div>

        <div class="form-buttons">
            <button type="submit" class="btn btn-primary">Schedule Rehearsal</button>
            <button type="button" class="btn btn-secondary" @onclick="Cancel">Cancel</button>
        </div>
    </form>
</div>
