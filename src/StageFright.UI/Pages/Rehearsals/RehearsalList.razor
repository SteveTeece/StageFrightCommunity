@page "/rehearsals"

<PageTitle>Rehearsals — StageFright Community</PageTitle>

<div class="page-header d-flex align-items-center justify-content-between mb-3">
    <h1 class="h3 mb-0">Rehearsals</h1>
    <button class="btn btn-primary btn-sm" @onclick="AddRehearsal">Schedule Rehearsal</button>
</div>

@if (_loading)
{
    <p role="status" aria-live="polite">Loading rehearsals…</p>
}
else if (_rehearsals.Count == 0)
{
    <p class="text-muted">No rehearsals scheduled yet.</p>
}
else
{
    <RadzenDataGrid Data="@_rehearsals" TItem="Rehearsal"
                    AllowSorting="true" AllowPaging="true" PageSize="10"
                    class="rz-shadow-0">
        <Columns>
            <RadzenDataGridColumn TItem="Rehearsal" Property="Date" Title="Date" Width="140px" FormatString="{0:d MMM yyyy}" />
            <RadzenDataGridColumn TItem="Rehearsal" Property="Time" Title="Time" Width="100px">
                <Template Context="r">@r.Time.ToString(@"hh\:mm")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="Rehearsal" Title="Attendance Rate" Width="150px">
                <Template Context="r">
                    @if (r.StoredAttendanceRate.HasValue)
                    {
                        <span>@($"{r.StoredAttendanceRate:F1}%")</span>
                    }
                    else
                    {
                        <span class="text-muted">Not recorded</span>
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="Rehearsal" Property="Notes" Title="Notes" />
            <RadzenDataGridColumn TItem="Rehearsal" Title="Actions" Width="180px" Sortable="false">
                <Template Context="r">
                    @if (!r.StoredAttendanceRate.HasValue)
                    {
                        <button class="btn btn-outline-primary btn-sm"
                                @onclick="() => RecordAttendance(r.Id)"
                                aria-label="Record attendance for @r.Date.ToString("d MMM yyyy")">
                            Record Attendance
                        </button>
                    }
                    else
                    {
                        <span class="text-muted small">Attendance recorded</span>
                    }
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
}

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="alert alert-danger mt-3" role="alert">@_errorMessage</div>
}
