@using StageFright.Data.Repositories
@using StageFright.Core.Entities

<div class="batch-attendance-recorder">
    @if (ErrorMessage != null)
    {
        <div class="error-message">@ErrorMessage</div>
    }

    @if (IsLoading)
    {
        <div class="loading">Loading attendance recorder...</div>
    }
    else if (Rehearsal != null)
    {
        <div class="recorder-header">
            <h2>Record Attendance - @Rehearsal.Date.ToShortDateString()</h2>
        </div>

        <form @onsubmit="SaveAttendance">
            <table class="attendance-table">
                <thead>
                    <tr>
                        <th>Member Name</th>
                        <th>
                            <label>
                                <input type="checkbox" @bind="AllAttended" />
                                Attended
                            </label>
                        </th>
                        <th>
                            <label>
                                <input type="checkbox" @bind="AllPaid" />
                                Paid
                            </label>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var member in Members)
                    {
                        var memberAttendance = AttendanceRecords.FirstOrDefault(a => a.MemberId == member.Id) ?? new AttendanceRecord { MemberId = member.Id };

                        <tr>
                            <td>@member.Name</td>
                            <td>
                                <input type="checkbox" @bind="memberAttendance.Attended" />
                            </td>
                            <td>
                                <input type="checkbox" @bind="memberAttendance.Paid" disabled="@(!memberAttendance.Attended)" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="form-buttons">
                <button type="submit" class="btn btn-primary">Save Attendance</button>
                <button type="button" class="btn btn-secondary" @onclick="Cancel">Cancel</button>
            </div>
        </form>
    }
</div>
