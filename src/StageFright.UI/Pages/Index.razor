@page "/"
@using StageFright.Core.Services
@using Microsoft.Extensions.Logging
@inject NavigationManager Navigation
@inject IAppInitializationService InitService
@inject ILogger<Index> Logger

<PageTitle>StageFright Community</PageTitle>

@if (InitService.State == AppInitializationState.Failed)
{
    <div class="initialization-error">
        <h2>Application Initialization Error</h2>
        <p>The application could not be initialized properly.</p>
        <p>Error: @InitService.ErrorMessage</p>
        <p><button class="btn btn-primary" @onclick="ReloadPage">Reload Application</button></p>
    </div>
}
else if (InitService.State == AppInitializationState.Complete)
{
    <!-- Initialization complete, will redirect to dashboard -->
    <div class="initialization-complete">
        <p>Redirecting to dashboard...</p>
    </div>
}
else
{
    <!-- Initialization in progress, show loading screen -->
    <div class="initialization-loading">
        <div class="spinner"></div>
        <h2>Initializing Application...</h2>
        <p>Setting up database and running migrations.</p>
        <p>Please wait...</p>
    </div>
}

@code {
    protected override async Task OnInitializedAsync()
    {
        try
        {
            Logger.LogInformation("[STARTUP-UI] Index.razor OnInitializedAsync started");
            Logger.LogInformation("[STARTUP-UI] Current initialization state: {State}", InitService.State);

            // Wait for initialization to complete
            Logger.LogInformation("[STARTUP-UI] Waiting for initialization to complete...");
            await InitService.WaitForInitializationAsync();
            Logger.LogInformation("[STARTUP-UI] Initialization wait completed. Current state: {State}", InitService.State);
        }
        catch (Exception ex)
        {
            // Error handled by state check in markup
            Logger.LogError(ex, "[STARTUP-UI] Exception during OnInitializedAsync");
            return;
        }

        // If we reach here, initialization is complete
        Logger.LogInformation("[STARTUP-UI] Initialization state is: {State}", InitService.State);
        if (InitService.State == AppInitializationState.Complete)
        {
            // Redirect to dashboard
            Logger.LogInformation("[STARTUP-UI] Initialization complete, preparing to redirect to dashboard");
            await Task.Delay(100); // Small delay to ensure UI updates
            Logger.LogInformation("[STARTUP-UI] Navigating to /dashboard");
            Navigation.NavigateTo("/dashboard", replace: true);
            Logger.LogInformation("[STARTUP-UI] Navigation.NavigateTo() completed");
        }
        else
        {
            Logger.LogWarning("[STARTUP-UI] Initialization state is not Complete: {State}", InitService.State);
        }
    }

    private void ReloadPage()
    {
        Logger.LogInformation("[STARTUP-UI] Reload button clicked");
        Navigation.NavigateTo("/", forceLoad: true);
    }
}
