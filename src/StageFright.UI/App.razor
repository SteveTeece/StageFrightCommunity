<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        <ErrorBoundary @ref="_errorBoundary">
            <ChildContent>
                <RouteView RouteData="routeData" DefaultLayout="@typeof(Layout.ShellLayout)" />
                <FocusOnNavigate RouteData="routeData" Selector="h1" />
            </ChildContent>
            <ErrorContent Context="ex">
                @{ LogCircuitError(ex); }
                <div class="container mt-4">
                    <div class="alert alert-danger">
                        <h4>@L["Shared_App_ErrorHeading"]</h4>
                        <p>@ex.Message</p>
                        <button class="btn btn-outline-danger btn-sm" @onclick="RecoverFromError">@L["Shared_App_ErrorDismissButton"]</button>
                    </div>
                </div>
            </ErrorContent>
        </ErrorBoundary>
    </Found>
    <NotFound>
        <PageTitle>@L["Shared_App_NotFoundTitle"]</PageTitle>
        <div class="container mt-4">
            <h1>@L["Shared_App_NotFoundHeading"]</h1>
            <p>@L["Shared_App_NotFoundBody"] <a href="/dashboard">@L["Shared_App_NotFoundReturnLink"]</a>.</p>
        </div>
    </NotFound>
</Router>
