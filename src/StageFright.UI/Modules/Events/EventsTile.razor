@inherits ComponentBase

@if (_loading)
{
    <span class="text-muted small">Loading...</span>
}
else if (_error)
{
    <span class="text-danger small">Unable to load</span>
}
else
{
    <div class="tile-stats">
        <div>
            <div class="tile-stat-value">@_upcomingCount</div>
            <div class="tile-stat-label">Upcoming</div>
        </div>
        <div>
            <div class="tile-stat-value accent">@(_nextDate?.ToString("MMM d") ?? "—")</div>
            <div class="tile-stat-label">Next</div>
        </div>
    </div>
    @if (HasLastParticipation)
    {
        <div class="tile-note">
            Last participation
            @if (_recordCount > 0)
            {
                <b class="@(IsGoodRate ? "text-success" : "")">@_participatedCount of @_recordCount (@($"{_lastRate:F0}")%)</b>
            }
            else
            {
                <b class="@(IsGoodRate ? "text-success" : "")">@($"{_lastRate:F0}")%</b>
            }
        </div>
        <div class="tile-progress">
            <div class="tile-progress-fill @(IsGoodRate ? "good" : "")" style="width:@($"{_lastRate:F0}")%"></div>
        </div>
    }
    else
    {
        <div class="tile-note">No participation recorded yet</div>
    }
}
