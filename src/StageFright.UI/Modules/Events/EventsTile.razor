@inherits ComponentBase

@if (_loading)
{
    <span class="text-muted small">@Shared["Shared_Common_Loading"]</span>
}
else if (_error)
{
    <span class="text-danger small">@Shared["Shared_Tile_LoadError"]</span>
}
else
{
    <div class="tile-stats">
        <div>
            <div class="tile-stat-value">@_upcomingCount</div>
            <div class="tile-stat-label">@L["Events_Tile_UpcomingLabel"]</div>
        </div>
        <div>
            <div class="tile-stat-value accent">@(_nextDate?.ToString("MMM d") ?? "—")</div>
            <div class="tile-stat-label">@L["Events_Tile_NextLabel"]</div>
        </div>
    </div>
    @if (HasLastParticipation)
    {
        <div class="tile-note">
            @L["Events_Tile_LastParticipationLabel"]
            @if (_recordCount > 0)
            {
                <b class="@(IsGoodRate ? "text-success" : "")">@ParticipationDetailText()</b>
            }
            else
            {
                <b class="@(IsGoodRate ? "text-success" : "")">@ParticipationRateText()</b>
            }
        </div>
        <div class="tile-progress">
            <div class="tile-progress-fill @(IsGoodRate ? "good" : "")" style="width:@($"{_lastRate:F0}")%"></div>
        </div>
    }
    else
    {
        <div class="tile-note">@L["Events_Tile_NoParticipation"]</div>
    }
}
