@inherits ComponentBase

@if (_loading)
{
    <span class="text-muted small">Loading...</span>
}
else if (_error || _summary is null)
{
    <span class="text-danger small">Unable to load</span>
}
else
{
    <div class="tile-balance">@_summary.CurrentBalance.ToString("C")</div>
    <div class="tile-stat-label">Current Balance</div>
    <div class="tile-note tile-month-flow">
        <span class="text-success">@_monthName income +@_summary.MonthIncome.ToString("C")</span>
        <span class="text-danger">expenses −@_summary.MonthExpenses.ToString("C")</span>
    </div>
}
