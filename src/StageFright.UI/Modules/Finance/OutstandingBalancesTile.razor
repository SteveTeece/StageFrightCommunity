@inherits ComponentBase

@if (_loading)
{
    <span class="text-muted small">@Shared["Shared_Common_Loading"]</span>
}
else if (_error)
{
    <span class="text-danger small">@Shared["Shared_Tile_LoadError"]</span>
}
else
{
    <div class="tile-stats tile-stats-lg">
        <div>
            <div class="tile-stat-value">@_memberCount</div>
            <div class="tile-stat-label">@L["Finance_OutstandingTile_MembersOwingLabel"]</div>
        </div>
        <div>
            <div class="tile-stat-value dim">@MoneyFormatter.Format(_attendanceOutstanding)</div>
            <div class="tile-stat-label">@L["Finance_OutstandingTile_AttendanceLabel"]</div>
        </div>
        <div>
            <div class="tile-stat-value dim">@MoneyFormatter.Format(_annualOutstanding)</div>
            <div class="tile-stat-label">@L["Finance_OutstandingTile_AnnualLabel"]</div>
        </div>
    </div>
    @if (_hasChartData)
    {
        <LineChart @ref="_chart" Height="220" />
    }
    else
    {
        <div class="tile-note">@L["Finance_OutstandingTile_Empty"]</div>
    }
}
