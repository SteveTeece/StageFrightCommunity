<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:blazor="clr-namespace:Microsoft.AspNetCore.Components.WebView.Maui;assembly=Microsoft.AspNetCore.Components.WebView.Maui"
             xmlns:ui="clr-namespace:StageFright.UI;assembly=StageFright.UI"
             x:Class="StageFright.Maui.BlazorWebViewHost">
    <!-- BlazorWebView - Primary UI container controlled entirely by Blazor -->
    <blazor:BlazorWebView x:Name="blazorWebView" HostPage="wwwroot/index.html">
        <blazor:BlazorWebView.RootComponents>
            <!-- App component from StageFright.UI handles all routing, navigation, and UI -->
            <blazor:RootComponent Selector="#app" ComponentType="{x:Type ui:App}" />
        </blazor:BlazorWebView.RootComponents>
    </blazor:BlazorWebView>
</ContentView>
