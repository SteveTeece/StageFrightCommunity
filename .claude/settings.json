{
  "worktree": {
    "baseRef": "head"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"${CLAUDE_PROJECT_DIR}/.claude/hooks/razor-codebehind-check.ps1\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"${CLAUDE_PROJECT_DIR}/.claude/hooks/dotnet-build-on-edit.ps1\"",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
